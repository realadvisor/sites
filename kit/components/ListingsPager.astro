---
/**
 * Numbered pages of ListingsSearch (1 … 4 5 6 … 12, prev / next with `rel`).
 * Rendered by ListingsSearch only: under the grid, or under the cards
 * column of the map view. Styled there (`.rs-pager`).
 */
import { pageList, type SearchResult } from '../lib/search';
import { LOCALE } from '../lib/format';
import { lang, t } from '../lib/i18n';

interface Props {
  result: SearchResult;
  href: (over: { page?: number }) => string;
  locale?: string;
}
const { result, href, locale = LOCALE } = Astro.props;
const l = lang(locale);
const pages = pageList(result.page, result.pages);
---
{result.pages > 1 && result.total > 0 && (
  <nav class="rs-pager" data-rs-pager aria-label={t('pagination', {}, l)}>
    {result.page > 1 ? <a class="rs-step" href={href({ page: result.page - 1 > 1 ? result.page - 1 : undefined })} rel="prev" data-rs-nav>‹ <span>{t('prevPage', {}, l)}</span></a> : <span class="rs-step" aria-hidden="true"></span>}
    <ol>
      {pages.map((n) => n == null ? <li class="rs-gap" aria-hidden="true">…</li> : (
        <li><a href={href({ page: n > 1 ? n : undefined })} data-rs-nav aria-current={n === result.page ? 'page' : undefined} aria-label={`${t('page', {}, l)} ${n}`}>{n}</a></li>
      ))}
    </ol>
    {result.page < result.pages ? <a class="rs-step" href={href({ page: result.page + 1 })} rel="next" data-rs-nav><span>{t('nextPage', {}, l)}</span> ›</a> : <span class="rs-step" aria-hidden="true"></span>}
  </nav>
)}

<style>
  .rs-pager { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--rs-line); }
  .rs-pager ol { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .rs-pager a, .rs-gap { display: grid; place-items: center; min-width: 44px; height: 44px; color: var(--rs-ink); text-decoration: none; font-variant-numeric: tabular-nums; border-radius: var(--control-radius, 8px); }
  .rs-pager a:hover { background: color-mix(in srgb, var(--rs-ink) 6%, transparent); }
  .rs-pager a[aria-current] { background: var(--rs-on); color: var(--rs-on-ink); }
  .rs-step { display: inline-flex !important; gap: 6px; padding: 0 12px; min-width: 96px; }
  .rs-step:last-child { justify-content: end; }
  @media (max-width: 639px) {
    .rs-step span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .rs-step { min-width: 44px; padding: 0; }
    .rs-pager ol li:not(:has([aria-current])):not(:first-child):not(:last-child) { display: none; }
  }
</style>
