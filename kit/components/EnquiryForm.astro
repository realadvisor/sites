---
/**
 * THE enquiry form. Every form that sends a message to the agency uses this
 * component (contact page, listing detail, valuation, agent page). Never build
 * another form, never post to a third-party form service, never use mailto.
 *
 *   <EnquiryForm listingId={listing.id} agentId={listing.agent?.id}
 *     agentName={listing.agent?.first_name} message={`… (réf. ${listing.id})`} />
 *   <EnquiryForm contactReason="valuation" id="valuation" />
 *   <EnquiryForm developmentId={dev.id} units={unitOptions(dev.units)} />   development page
 *   <EnquiryForm developmentId={dev.id} lotId={unit.id} />                 one unit of it
 *
 * Posts to /api/enquiry. Works without JS (303 back to the page with
 * ?enquiry=sent|preview|error). With JS: inline validation, "sending" state,
 * success / preview / error replace or top the form. Each submission carries
 * an idempotencyKey (made at render, fresh per page view with JS, kept on a
 * retry): a double click or a retry never makes a second enquiry, and the
 * button stays disabled while sending. Style it with the form
 * tokens; do not change its fields or script.
 *
 * Bot protection: a Cloudflare Turnstile widget (site key from rest-api,
 * `turnstileSiteKey()` in lib/ra.ts; invisible unless Cloudflare wants an
 * interaction), loaded when the form comes into view. Its token goes as
 * `turnstileToken`; rest-api verifies it. Tokens are single use: the widget
 * is reset after a failed send. Preview sites render none (they never send);
 * fixture mode renders a stand-in that never loads Turnstile. Never add another
 * captcha or a honeypot. Without JavaScript there is no token: the enquiry is
 * refused (?enquiry=error).
 */
import Input from './form/Input.astro';
import Button from './form/Button.astro';
import Select from './form/Select.astro';
import { t as tr, lang, localeOfPath, privacyPath, type StringKey } from '../lib/i18n';
import { FIXTURE_TURNSTILE_SITE_KEY } from '@realadvisor/sites-sdk';
import { turnstileSiteKey } from '../lib/ra';
import { siteMode } from '../lib/env';

interface Props {
  /** Unique per page when the page has two forms. */
  id?: string;
  listingId?: string;
  agentId?: string;
  /** First name shown in the success message ("Marie will get back to you"). */
  agentName?: string;
  /**
   * Enquiry about a development (`dev.id`): the CRM links it to the
   * development and sends it to its broker. Never name the development in
   * `message` instead.
   */
  developmentId?: string;
  /** One unit (`unit.id`) of `developmentId`: the CRM files it on that unit. */
  lotId?: string;
  /**
   * Without lotId: the units a visitor can ask about (`unitOptions(dev.units)`
   * in lib/developments.ts), shown as a REQUIRED select: every development
   * enquiry is filed on a unit (the CRM counts it per development).
   * `selectedUnit` preselects one (?lot=<id>). No enquirable unit (all sold,
   * none published): the form sends the development alone.
   */
  units?: Array<{ value: string; label: string }>;
  selectedUnit?: string;
  /** Only without listingId / lotId. Default for a development: `buy`. */
  contactReason?: 'buy' | 'sell' | 'valuation' | 'other';
  /** Prefilled message. */
  message?: string;
  /** Submit label. Default: "Envoyer ma demande" in the site language. */
  submitLabel?: string;
  /** Page locale on a multi-language site (e.g. 'en-CH'). Default: from the URL (`/en/...`). */
  locale?: string;
  class?: string;
}
if (Astro.isPrerendered && import.meta.env.PROD) {
  // Preview mode is read per request: the page must render on request.
  throw new Error(`EnquiryForm on ${Astro.url.pathname}: add \`export const prerender = false\` to the page.`);
}
const { id = 'enquiry', listingId, agentId, agentName, developmentId, lotId, units, selectedUnit, message, submitLabel, class: cls } = Astro.props;
const contactReason = Astro.props.contactReason ?? (developmentId ? 'buy' : undefined);
const locale = Astro.props.locale ?? localeOfPath(Astro.url.pathname);
const t = (key: StringKey, vars: Record<string, string> = {}) => tr(key, vars, lang(locale));
const success = agentName ? t('sentBy', { name: agentName }) : t('sent');
const f = (name: string) => `${id}-${name}`;
// A development form without lotId must choose a unit while the development has one to ask about.
const unitSelect = !!developmentId && !lotId && !!units && units.length > 0;
// Preview sites never send: no widget there.
const siteKey = siteMode() === 'preview' ? null : await turnstileSiteKey();
---
<div class:list={['enquiry', cls]} id={id} data-enquiry>
  <p class="enquiry-status" role="status" aria-live="polite" tabindex="-1" hidden data-status></p>
  <form
    method="post"
    action="/api/enquiry"
    novalidate
    data-msg-sent={success}
    data-msg-preview={t('preview')}
    data-msg-error={t('error')}
    data-msg-required={t('required')}
    data-msg-email={t('invalidEmail')}
    data-msg-unit={t('unitRequired')}
    data-msg-sending={t('sending')}
    data-msg-verify={t('verifyFailed')}
    data-msg-rejected={t('rejected')}
  >
    {listingId && <input type="hidden" name="listingId" value={listingId} />}
    {agentId && <input type="hidden" name="agentId" value={agentId} />}
    {developmentId && <input type="hidden" name="developmentId" value={developmentId} />}
    {developmentId && lotId && <input type="hidden" name="lotId" value={lotId} />}
    {!listingId && !lotId && contactReason && <input type="hidden" name="contactReason" value={contactReason} />}
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="idempotencyKey" value={crypto.randomUUID()} data-idempotency />
    <input type="hidden" name="redirect" value={`#${id}`} data-redirect />
    <div class="enquiry-grid">
      <div>
        <Input id={f('name')} label={`${t('name')} *`} name="name" required maxlength={100} autocomplete="name" aria-describedby={f('name-err')} />
        <p class="field-error" id={f('name-err')} hidden></p>
      </div>
      <div>
        <Input id={f('email')} label={`${t('email')} *`} name="email" type="email" required maxlength={200} autocomplete="email" aria-describedby={f('email-err')} />
        <p class="field-error" id={f('email-err')} hidden></p>
      </div>
      <div>
        <Input id={f('phone')} label={`${t('phone')} ${t('optional')}`} name="phone" type="tel" maxlength={40} autocomplete="tel" />
      </div>
      {unitSelect && (
        <div class="enquiry-full">
          <Select id={f('lot')} label={`${t('unitOfInterest')} *`} name="lotId" options={units!} value={selectedUnit} placeholder={t('chooseUnit')} required aria-describedby={f('lot-err')} />
          <p class="field-error" id={f('lot-err')} hidden></p>
        </div>
      )}
      <div class="enquiry-full">
        <Input id={f('message')} label={`${t('message')} *`} name="message" multiline required maxlength={5000} value={message} aria-describedby={f('message-err')} />
        <p class="field-error" id={f('message-err')} hidden></p>
      </div>
    </div>
    {siteKey && (
      <div
        class="enquiry-turnstile"
        data-turnstile={siteKey === FIXTURE_TURNSTILE_SITE_KEY ? 'fixture' : 'live'}
        data-sitekey={siteKey}
        data-lang={lang(locale)}
      ></div>
    )}
    <Button type="submit">{submitLabel ?? t('send')}</Button>
    <p class="enquiry-note">{t('privacyNote')} <a href={privacyPath(locale)}>{t('privacyLink')}</a></p>
  </form>
</div>

<script>
  import '../client/enquiry';
</script>
