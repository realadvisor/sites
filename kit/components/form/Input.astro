---
/**
 * Text-like input with its label. Same height and look as Select/Combobox/Button.
 *   <Input label="E-Mail" name="email" type="email" required autocomplete="email" />
 *   <Input label="Max. Preis" name="maxPrice" type="number" hideLabel placeholder="Max. Preis" />
 * Pass `multiline` for a textarea.
 */
import '../../styles/form.css';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'input'>, 'class'> & {
  label: string;
  name: string;
  hideLabel?: boolean;
  multiline?: boolean;
  class?: string;
};
const { label, hideLabel, multiline, class: cls, id, type = 'text', ...rest } = Astro.props;
const fieldId = id ?? `f-${rest.name}`;
---
<div class:list={['field', cls]}>
  <label for={fieldId} class:list={['field-label', { 'sr-only': hideLabel }]}>{label}</label>
  {multiline
    ? <textarea id={fieldId} class="control" {...(rest as HTMLAttributes<'textarea'>)}>{rest.value}</textarea>
    : <input id={fieldId} class="control" type={type} {...rest} />}
</div>
