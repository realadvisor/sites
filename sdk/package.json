{
  "name": "@realadvisor/sites-sdk",
  "version": "0.3.0",
  "description": "The data client of every RealAdvisor site: createClient, createFixtureClient, handleEnquiry, SitesApiError and the types. No dependencies, web standards only: it runs unchanged in Astro, React Router and plain Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realadvisor/sites.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/realadvisor/sites/tree/main/sdk#readme",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "pnpm test",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"test/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18"
  }
}
