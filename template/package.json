{
  "name": "realadvisor-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "sites-kit fixture --if-empty && react-router dev --port ${PORT:-4321}",
    "build": "sites-kit fixture --if-empty && react-router build",
    "preview": "sites-kit-react preview --port 4321",
    "check": "sites-kit fixture --if-empty && react-router typegen && tsc && react-router build",
    "fixture": "sites-kit fixture",
    "screenshot": "sites-kit screenshot",
    "check:deploy": "sites-kit-react check deploy",
    "kit": "sites-kit"
  },
  "dependencies": {
    "@realadvisor/sites-kit-core": "file:../kit-core",
    "@realadvisor/sites-kit-react": "file:../kit-react",
    "@realadvisor/sites-sdk": "file:../sdk",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@react-router/dev": "7.18.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  },
  "packageManager": "pnpm@10.11.1"
}
