---
// Privacy policy in the other languages of a multi-language site: /en/privacy,
// ... for every locale after the first in LOCALES (src/lib/i18n.ts). A
// single-language site answers 404 here. Wrap it in the same layout as
// src/pages/privacy.astro; keep the content component as is.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import LegalContent from '@realadvisor/sites-kit/components/LegalContent.astro';
import { ra } from '@realadvisor/sites-kit/ra';
import { privacyPolicy } from '@realadvisor/sites-kit/legal';
import { LOCALES, lang, privacyPath, t } from '@realadvisor/sites-kit/i18n';
import { analyticsId } from '@realadvisor/sites-kit/env';

const locale = LOCALES.slice(1).find((l) => lang(l) === Astro.params.lang);
if (!locale) return Astro.rewrite('/404');
const agency = await ra.agency();
const title = t('privacyPolicy', {}, lang(locale));
---
<Base title={`${title} | ${agency.name}`} description={`${title} ${agency.name}`} locale={locale} alternates={LOCALES.map((l) => ({ lang: l, href: privacyPath(l) }))}>
  <main>
    <h1>{title}</h1>
    <LegalContent sections={privacyPolicy(agency, { analytics: !!analyticsId() }, lang(locale))} />
  </main>
</Base>
