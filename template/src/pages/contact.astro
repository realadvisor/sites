---
// Wiring example only. Replace the markup with the real design.
// The listings page links /contact and /contact#valuation: keep both forms
// (the second one has its own id).
export const prerender = false;

import Base from '../layouts/Base.astro';
import { ra } from '@realadvisor/sites-kit/ra';
import { agencyJsonLd } from '@realadvisor/sites-kit/seo';
import { t } from '@realadvisor/sites-kit/i18n';
import EnquiryForm from '@realadvisor/sites-kit/components/EnquiryForm.astro';

const agency = await ra.agency();
const a = agency.address;
const street = [a?.street, [a?.postcode, a?.city].filter(Boolean).join(' ')].filter(Boolean);
const telHref = (phone: string) => `tel:${phone.replace(/[^\d+]/g, '')}`;
---
<Base
  title={`${t('contactUs')} | ${agency.name}`}
  description={[agency.name, ...street, agency.phone].filter(Boolean).join(', ')}
  jsonLd={agencyJsonLd(agency, Astro.site?.href ?? new URL('/', Astro.url).href)}
>
  <main id="main">
    <h1>{t('contactUs')}</h1>
    <address>
      <strong>{agency.name}</strong>
      {street.map((line) => <span><br />{line}</span>)}
    </address>
    <ul>
      {agency.phone && <li>{t('phone')}: <a href={telHref(agency.phone)}>{agency.phone}</a></li>}
      {agency.email && <li>{t('email')}: <a href={`mailto:${agency.email}`}>{agency.email}</a></li>}
    </ul>
    <EnquiryForm contactReason="other" />
    {/* Target of valuationHref="/contact#valuation" on the listings page. */}
    <EnquiryForm id="valuation" contactReason="valuation" />
  </main>
</Base>
