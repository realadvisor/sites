{
  "name": "@realadvisor-sites/kit-core",
  "version": "0.5.0",
  "description": "The framework-neutral core of a RealAdvisor site, shared by the Astro kit and the React kit: data helpers over @realadvisor/sites-sdk (a peer), i18n, formatting, legal texts, SEO, search, images, security headers, the browser scripts (listing search and map, enquiry, consent), the sites-kit tools (fixture, screenshot, deploy check) and the rules the coding agent follows (AGENTS.md, DESIGN.md).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realadvisor/sites.git",
    "directory": "kit-core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "homepage": "https://github.com/realadvisor/sites/tree/main/kit-core#readme",
  "files": [
    "*.ts",
    "*.mjs",
    "*.mts",
    "AGENTS.md",
    "DESIGN.md",
    "TASTE.md",
    "README.md",
    "LICENSE",
    "bin",
    "client",
    "contract",
    "critic",
    "fixtures",
    "lib",
    "styles",
    "tools"
  ],
  "exports": {
    ".": "./index.ts",
    "./types": "./types.ts",
    "./contract": "./contract/index.ts",
    "./site-config": {
      "types": "./site-config.d.mts",
      "default": "./site-config.mjs"
    },
    "./security": "./lib/security.mjs",
    "./client/*": "./client/*.ts",
    "./styles/*": "./styles/*",
    "./fixtures/*": "./fixtures/*",
    "./package.json": "./package.json",
    "./tools/*": "./tools/*",
    "./*": "./lib/*.ts"
  },
  "bin": {
    "sites-kit": "./bin/sites-kit.mjs"
  },
  "scripts": {
    "check": "pnpm test",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"test/*.test.mjs\" \"test/*.test.ts\""
  },
  "peerDependencies": {
    "@realadvisor/sites-sdk": "^0.5.0",
    "playwright": "^1.64.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
