---
/**
 * Listing gallery: one large photo and a 2x2 grid (1 + 4), "all photos" on
 * the last tile; on phones the first photo with a counter. Every tile opens
 * the lightbox (a native <dialog>: focus trap, Escape) at that photo; the
 * lightbox is a scroll-snap track (swipe on phones, arrows and keys on
 * desktop) and shows each photo whole (object-fit: contain). Without JS
 * the tiles stay plain photos.
 */
import type { Photo } from '@realadvisor/sites-sdk/types';
import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';

interface Props { photos: Photo[]; title: string; label?: string }
const { photos, title, label } = Astro.props;
const alt = (p: Photo, i: number) => p.alt || `${title}, Foto ${i + 1}`;
const grid = photos.slice(1, 5);
const n = photos.length;
---
{n > 0 && (
  <section class:list={['gal', `gal--${Math.min(n, 5)}`]} aria-label={`Fotos: ${title}`} data-gallery>
    <div class="gal-grid">
      <a class="gal-tile gal-main" href="#foto-1" data-open="0">
        <RaImage src={photos[0]} alt={alt(photos[0]!, 0)} width={1400} height={1050} priority sizes="(min-width: 1024px) 58vw, 100vw" mobile={{ width: 800, height: 600 }} />
        {label && <span class="gal-label caps">{label}</span>}
        {n > 1 && <span class="gal-all caps">Alle {n} Fotos</span>}
        <span class="gal-count caps" aria-hidden="true">1 / {n}</span>
      </a>
      {grid.map((p, i) => (
        <a class="gal-tile" href={`#foto-${i + 2}`} data-open={i + 1}>
          <RaImage src={p} alt={alt(p, i + 1)} width={700} height={525} sizes="(min-width: 1024px) 21vw, 50vw" />
        </a>
      ))}
    </div>
    <button type="button" class="gal-phone-all caps" data-open="0">Alle {n} Fotos ansehen</button>

    <dialog class="lb" aria-label={`Fotos: ${title}`} data-lightbox>
      <div class="lb-bar">
        <p class="lb-count caps" aria-live="polite"><span data-lb-index>1</span> / {n}</p>
        <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Schliessen">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
        </button>
      </div>
      <ol class="lb-track" data-lb-track id="fotos">
        {photos.map((p, i) => (
          <li class="lb-slide" id={`foto-${i + 1}`}>
            <RaImage src={p} alt={alt(p, i)} width={1800} height={1200} fit="fit" widths={[800, 1200, 1800]} sizes="100vw" />
          </li>
        ))}
      </ol>
      {n > 1 && (
        <>
          <button type="button" class="lb-btn lb-prev" data-lb-step="-1" aria-label="Vorheriges Foto">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M15 4l-8 8 8 8" /></svg>
          </button>
          <button type="button" class="lb-btn lb-next" data-lb-step="1" aria-label="Nächstes Foto">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
          </button>
        </>
      )}
    </dialog>
  </section>
)}

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const track = root.querySelector<HTMLElement>('[data-lb-track]')!;
    const index = root.querySelector<HTMLElement>('[data-lb-index]')!;
    const slides = [...track.children] as HTMLElement[];
    const current = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
    const go = (i: number, smooth = true) => {
      const to = Math.max(0, Math.min(slides.length - 1, i));
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: to * track.clientWidth, behavior: smooth && !reduce ? 'smooth' : 'auto' });
    };
    root.addEventListener('click', (e) => {
      const opener = (e.target as Element).closest<HTMLElement>('[data-open]');
      if (!opener) return;
      e.preventDefault();
      // Lazy slides load once visible; the dialog makes them visible.
      dialog.showModal();
      document.body.classList.add('is-locked');
      requestAnimationFrame(() => go(Number(opener.dataset.open), false));
    });
    dialog.addEventListener('close', () => document.body.classList.remove('is-locked'));
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      const step = (e.target as Element).closest<HTMLElement>('[data-lb-step]');
      if (step) go(current() + Number(step.dataset.lbStep));
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
    });
    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => (index.textContent = String(current() + 1)));
    }, { passive: true });
  }
</script>

<style>
  .gal { position: relative; }
  .gal-grid { display: grid; gap: 8px; grid-template-columns: minmax(0, 7fr) repeat(2, minmax(0, 2.5fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); aspect-ratio: 2.35 / 1; }
  .gal-main { grid-row: 1 / 3; }
  .gal--1 .gal-grid { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  .gal--1 .gal-main { grid-row: auto; }
  .gal--2 .gal-grid, .gal--3 .gal-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .gal--2 .gal-tile:not(.gal-main) { grid-row: 1 / 3; }
  .gal--4 .gal-tile:last-child { grid-column: 2 / 4; }
  .gal-tile { position: relative; display: block; overflow: hidden; background: var(--surface); min-height: 0; }
  .gal-tile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1), opacity .2s; }
  .gal-tile:hover :global(img) { transform: scale(1.02); }
  .gal-tile :global(picture) { display: contents; }
  .gal-tile:focus-visible { outline-offset: -4px; outline-color: var(--paper); outline-width: 3px; }
  .gal-all, .gal-label, .gal-count {
    position: absolute; padding: 10px 14px 9px; background: var(--bg); color: var(--text); pointer-events: none;
  }
  .gal-all { left: 16px; bottom: 16px; }
  .gal-label { left: 0; top: 0; }
  .gal-count { display: none; right: 12px; bottom: 12px; background: rgb(20 24 22 / 0.72); color: #fff; }
  .gal-phone-all { display: none; }

  @media (max-width: 767px) {
    .gal-grid { display: block; aspect-ratio: auto; }
    .gal-tile:not(.gal-main) { display: none; }
    .gal-main { aspect-ratio: 4 / 3; }
    .gal-count { display: block; }
    .gal-all { display: none; }
    .gal-phone-all {
      display: flex; width: 100%; min-height: 48px; justify-content: center; align-items: center; margin-top: 8px;
      background: none; border: 1px solid var(--line-strong); cursor: pointer;
    }
  }

  /* Lightbox */
  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #141716; color: #fff; overflow: hidden; }
  .lb::backdrop { background: #141716; }
  .lb[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .lb-bar { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px 8px 24px; }
  .lb-count { font-variant-numeric: tabular-nums; }
  .lb-track { list-style: none; margin: 0; padding: 0; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior: contain; scrollbar-width: none; }
  .lb-track::-webkit-scrollbar { display: none; }
  .lb-slide { flex: 0 0 100%; scroll-snap-align: center; display: grid; place-items: center; padding: 0 clamp(0px, 6vw, 96px) clamp(16px, 3vw, 40px); }
  .lb-slide :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .lb-btn { display: grid; place-items: center; width: 48px; height: 48px; border: 0; background: none; color: #fff; cursor: pointer; border-radius: 50%; }
  .lb-btn:hover { background: rgb(255 255 255 / 0.1); }
  .lb-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .lb-prev, .lb-next { position: absolute; top: 50%; translate: 0 -50%; width: 56px; height: 56px; }
  .lb-prev { left: 16px; }
  .lb-next { right: 16px; }
  @media (max-width: 767px) { .lb-prev, .lb-next { display: none; } }
</style>
