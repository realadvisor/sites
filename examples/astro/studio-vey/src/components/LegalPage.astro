---
/** Frame for the kit's legal text: title left, sections right. */
interface Props { title: string }
const { title } = Astro.props;
---
<div class="lg wrap">
  <header class="lg-head">
    <h1 class="h1">{title}</h1>
  </header>
  <div class="lg-body"><slot /></div>
</div>

<style>
  .lg { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 40px clamp(40px, 6vw, 112px); padding-block: clamp(56px, 7vw, 112px) var(--section); }
  .lg-head { display: grid; gap: 20px; align-content: start; justify-items: start; }
  .lg-body :global(.legal) { display: grid; gap: 40px; max-width: 68ch; }
  .lg-body :global(.legal h2) { font-size: var(--fs-h3); margin-bottom: 14px; }
  .lg-body :global(.legal dl) { margin: 0; display: grid; }
  .lg-body :global(.legal dl > div) { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .lg-body :global(.legal dt) { color: var(--muted); }
  .lg-body :global(.legal dd) { margin: 0; overflow-wrap: anywhere; }
  .lg-body :global(.legal p + p) { margin-top: 12px; }
  @media (max-width: 899px) { .lg { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 479px) { .lg-body :global(.legal dl > div) { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>
