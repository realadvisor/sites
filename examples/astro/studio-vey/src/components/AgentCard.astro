---
/** Agent in plain type: name, role, languages, phone and e-mail, link to their page. */
import type { Agent } from '@realadvisor/sites-sdk/types';
import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';
import { agentUrl } from '../lib/data';
import { fullName, languages, telHref } from '../lib/format';

interface Props { agent: Agent; count?: number; layout?: 'stack' | 'row'; link?: boolean; as?: 'h2' | 'h3' | 'p' }
const { agent, count, layout = 'stack', link = true, as: H = 'h3' } = Astro.props;
const langs = languages(agent.languages);
const row = layout === 'row';
const name = fullName(agent);
// 4:5 portrait cut from the square photo; stack = column width of the 4/2/1-up grids, row = 88px thumbnail.
const box = row ? { width: 176, height: 220, sizes: '88px' } : { width: 640, height: 800, sizes: '(min-width: 560px) 248px, 320px' };
---
<article class:list={['agent', `agent--${layout}`, agent.photo && 'agent--photo']}>
  {agent.photo && (
    <div class="agent-photo">
      {link ? <a href={agentUrl(agent)} tabindex="-1"><RaImage src={agent.photo.url} alt={name} {...box} /></a> : <RaImage src={agent.photo.url} alt={name} {...box} />}
    </div>
  )}
  <div class="agent-body">
    <H class="agent-name">{link ? <a href={agentUrl(agent)}>{fullName(agent)}</a> : fullName(agent)}</H>
    {agent.title && <p class="agent-title caps muted">{agent.title}</p>}
    {langs && <p class="agent-langs muted">{langs}</p>}
    <ul class="agent-contact">
      {agent.phone && <li><a href={telHref(agent.phone)}>{agent.phone}</a></li>}
      {agent.email && <li><a href={`mailto:${agent.email}`}>{agent.email}</a></li>}
    </ul>
    {link && count != null && count > 0 && <a class="more agent-more" href={agentUrl(agent)}>{count === 1 ? '1 Objekt' : `${count} Objekte`}</a>}
  </div>
</article>

<style>
  .agent-photo { aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); margin-bottom: 18px; max-width: 248px; }
  @media (max-width: 559px) { .agent-photo { max-width: 320px; } }
  .agent-photo :global(img), .agent-photo a { display: block; width: 100%; height: 100%; object-fit: cover; }
  .agent--row.agent--photo { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 20px; align-items: start; }
  .agent--row .agent-photo { margin-bottom: 0; }
  .agent { display: grid; align-content: start; }
  .agent-name { font-size: 1.5rem; line-height: 1.15; }
  .agent-name a { text-decoration: none; }
  .agent-name a:hover { text-decoration: underline; }
  .agent-title { margin-top: 6px; }
  .agent-langs { margin-top: 4px; font-size: 0.9375rem; }
  .agent-contact { list-style: none; margin-top: 12px; display: grid; font-size: 0.9375rem; }
  .agent-contact li + li { font-size: 0.875rem; } /* e-mail: long addresses stay on one line in a four-up grid */
  .agent-contact a { display: inline-flex; align-items: center; min-height: 32px; text-decoration: none; border-bottom: 1px solid var(--line-strong); width: fit-content; }
  .agent-contact a:hover { border-color: currentColor; }
  .agent-more { margin-top: 8px; }
</style>
