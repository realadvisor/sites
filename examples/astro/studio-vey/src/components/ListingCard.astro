---
/**
 * Editorial listing card: 4:3 photo, small-caps kind line, serif title,
 * price and facts. Sold: a "Verkauft" tab on the photo edge and no price.
 */
import type { Listing } from '@realadvisor/sites-sdk/types';
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import { propertyTypeLabel } from '@realadvisor/sites-kit-core/i18n';
import { price } from '../lib/kit';
import { facts, kind } from '../lib/format';
import { listingUrl } from '../lib/data';

interface Props {
  listing: Listing;
  priority?: boolean;
  sizes?: string;
  /** Heading level of the title in the page outline. */
  as?: 'h2' | 'h3';
}
const { listing: l, priority = false, sizes = '(min-width: 1360px) 420px, (min-width: 1024px) 31vw, (min-width: 640px) 46vw, 100vw', as: H = 'h3' } = Astro.props;
const photo = l.photos[0];
const sold = l.status === 'sold';
const f = facts(l);
---
<article class:list={['card', { 'is-sold': sold }]}>
  <a class="card-link" href={listingUrl(l)}>
    <div class="card-media">
      {photo ? (
        <RaImage src={photo} alt={photo.alt || l.title} width={800} height={600} sizes={sizes} priority={priority} />
      ) : (
        <span class="nophoto caps">{propertyTypeLabel(l.property_type)}</span>
      )}
      {sold && <span class="card-tab caps">Verkauft</span>}
    </div>
    <p class="card-kind caps" title={kind(l)}>{kind(l)}</p>
    <H class="card-title" title={l.title}>{l.title}</H>
    <p class="card-meta">
      {!sold && <span class="card-price num">{price(l)}</span>}
      {f && <span class="card-facts num">{f}</span>}
    </p>
  </a>
</article>

<style>
  .card { min-width: 0; container-type: inline-size; }
  .card-link { display: grid; gap: 6px; text-decoration: none; color: inherit; }
  .card-link:focus-visible { outline-offset: 6px; }
  .card-media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--surface); margin-bottom: 14px; }
  .card-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .card-link:hover .card-media :global(img) { transform: scale(1.03); }
  .card-tab { position: absolute; left: 0; bottom: 0; padding: 9px 14px 8px; background: var(--bg); color: var(--text); }
  .card-kind { color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* Two lines, always: the price and facts line up across a row. */
  .card-title { font-size: clamp(1.3125rem, 1.15rem + 0.45vw, 1.5625rem); line-height: 1.2; min-height: 2.4em; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .card-link:hover .card-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .card-meta { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; font-size: 0.9375rem; }
  .card-price { font-weight: 500; }
  .card-facts { color: var(--muted); }
  /* Narrow cards (the map's list): price and facts fit one line in some cards only, so the facts always take their own line. */
  @container (max-width: 280px) { .card-facts { flex-basis: 100%; } }
</style>
