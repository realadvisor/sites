---
/** Recently sold, as a plain list: small photo, title, place and facts. No cards, no price. */
import type { Listing } from '@realadvisor/sites-sdk/types';
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import { listingUrl } from '../lib/data';
import { facts, kind } from '../lib/format';

interface Props { listings: Listing[] }
const { listings } = Astro.props;
---
<ul class="sl">
  {listings.map((l) => (
    <li>
      <a class="sl-row" href={listingUrl(l)}>
        <span class="sl-media">{l.photos[0] && <RaImage src={l.photos[0]} alt="" width={160} height={120} sizes="96px" />}</span>
        <span class="sl-body">
          <span class="sl-title">{l.title}</span>
          <span class="sl-meta muted">{kind(l)}{facts(l) && <> · <span class="num">{facts(l)}</span></>}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .sl { list-style: none; border-top: 1px solid var(--line-strong); }
  .sl li { border-bottom: 1px solid var(--line); }
  .sl-row { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 20px; align-items: center; padding: 16px 0; text-decoration: none; }
  .sl-media { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--surface); }
  .sl-media :global(picture) { display: contents; }
  .sl-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .sl-body { display: grid; gap: 4px; }
  .sl-title { font: 400 1.1875rem/1.25 var(--serif); }
  .sl-row:hover .sl-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .sl-meta { font-size: 0.9375rem; }
  @media (max-width: 479px) { .sl-row { grid-template-columns: 72px minmax(0, 1fr); gap: 16px; } }
</style>
