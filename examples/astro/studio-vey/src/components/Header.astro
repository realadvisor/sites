---
/**
 * Three-zone header: spaced-caps links left and right, the wordmark centred.
 * Under 1080px: wordmark left, a menu button that opens a full-screen sheet.
 */
interface Props {
  brand: string;
  /** Primary nav (left on desktop). */
  left: { href: string; label: string }[];
  /** Secondary nav (right on desktop). */
  right: { href: string; label: string }[];
  phone?: string;
}
const { brand, left, right, phone } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href || (href !== '/' && path.startsWith(`${href}/`)) ? 'page' : undefined);
const words = brand.split(/\s+/);
---
<header class="hd" data-header>
  <div class="hd-in">
    <nav class="hd-nav hd-left" aria-label="Hauptnavigation">
      <ul>{left.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}</ul>
    </nav>
    <a class="hd-mark" href="/">
      {words.map((w) => <span>{w}</span>)}
    </a>
    <nav class="hd-nav hd-right" aria-label="Weitere Seiten">
      <ul>{right.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}</ul>
    </nav>
    <button class="hd-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <span class="hd-toggle-lines" aria-hidden="true"><span></span><span></span></span>
      <span class="sr-only">Menü</span>
    </button>
  </div>
  <div class="menu" id="site-menu" data-menu>
    <nav class="menu-in wrap" aria-label="Menü">
      <ul class="menu-main">{left.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}</ul>
      <ul class="menu-sub">{right.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}</ul>
      {phone && <p class="menu-phone"><a class="more" href={`tel:${phone.replace(/\s+/g, '')}`}>{phone}</a></p>}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      document.body.classList.toggle('is-locked', open);
      if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        set(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 1080px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>

<style>
  .hd { position: sticky; top: 0; z-index: 40; background: var(--bg); border-bottom: 1px solid var(--line); }
  .hd-in {
    height: var(--header-h); max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gutter);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px;
  }
  .hd-nav ul { list-style: none; display: flex; gap: clamp(18px, 2vw, 34px); }
  .hd-right ul { justify-content: flex-end; }
  .hd-nav a, .menu-sub a {
    font: 500 var(--fs-caps)/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase;
    text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; position: relative;
  }
  .hd-nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 12px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .25s; }
  .hd-nav a:hover::after, .hd-nav a[aria-current]::after { transform: scaleX(1); }
  .hd-mark {
    display: inline-flex; gap: 0.5em; text-decoration: none; min-height: 44px; align-items: center;
    font: 500 1.0625rem/1 var(--sans); letter-spacing: 0.42em; text-transform: uppercase; margin-right: -0.42em;
  }
  .hd-toggle { display: none; }

  .menu { position: fixed; inset: var(--header-h) 0 0 0; z-index: 39; background: var(--bg); visibility: hidden; pointer-events: none; opacity: 0; transition: opacity .2s, visibility 0s .2s; overflow-y: auto; }
  .menu.is-open { visibility: visible; pointer-events: auto; opacity: 1; transition: opacity .2s; }
  .menu-in { padding-block: 32px 48px; display: grid; gap: 32px; }
  .menu-main { list-style: none; display: grid; }
  .menu-main a { display: block; padding: 10px 0; font: 400 2.25rem/1.15 var(--serif); text-decoration: none; border-bottom: 1px solid var(--line); }
  .menu-sub { list-style: none; display: grid; gap: 4px; }
  .menu-phone { padding-top: 8px; }

  @media (max-width: 1079px) {
    .hd-in { grid-template-columns: 1fr auto; }
    .hd-nav { display: none; }
    .hd-mark { justify-self: start; font-size: 0.9375rem; letter-spacing: 0.34em; }
    .hd-toggle { display: grid; place-items: center; width: 44px; height: 44px; margin-right: -10px; border: 0; background: none; cursor: pointer; }
    .hd-toggle-lines { display: grid; gap: 7px; width: 24px; }
    .hd-toggle-lines span { height: 1.5px; background: currentColor; transition: transform .2s; }
    .hd-toggle[aria-expanded='true'] .hd-toggle-lines span:first-child { transform: translateY(4.25px) rotate(45deg); }
    .hd-toggle[aria-expanded='true'] .hd-toggle-lines span:last-child { transform: translateY(-4.25px) rotate(-45deg); }
  }
  @media (min-width: 1080px) { .menu { display: none; } }
</style>
