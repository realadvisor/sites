---
/** Journal post card: photo, topic, title, date. */
import type { CollectionEntry } from 'astro:content';
import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';
import { formatDate } from '../lib/format';

interface Props { post: CollectionEntry<'journal'>; as?: 'h2' | 'h3'; large?: boolean; priority?: boolean }
const { post, as: H = 'h3', large = false, priority = false } = Astro.props;
const d = post.data;
---
<article class:list={['jc', { 'jc--large': large }]}>
  <a href={`/journal/${post.id}`} class="jc-link">
    <div class="jc-media"><RaImage src={d.cover} alt={d.coverAlt} priority={priority} width={large ? 1200 : 800} height={large ? 800 : 560} sizes={large ? '(min-width: 1024px) 58vw, 100vw' : '(min-width: 1024px) 31vw, (min-width: 640px) 46vw, 100vw'} /></div>
    <p class="caps muted">{d.topic} · <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time></p>
    <H class="jc-title">{d.title}</H>
    {large && <p class="jc-excerpt">{d.excerpt}</p>}
  </a>
</article>

<style>
  .jc-link { display: grid; gap: 10px; text-decoration: none; }
  .jc-media { aspect-ratio: 10 / 7; overflow: hidden; background: var(--surface); margin-bottom: 8px; }
  .jc--large .jc-media { aspect-ratio: 3 / 2; }
  .jc-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .jc-link:hover .jc-media :global(img) { transform: scale(1.03); }
  .jc-title { font-size: clamp(1.3125rem, 1.15rem + 0.45vw, 1.5625rem); line-height: 1.22; }
  .jc--large .jc-title { font-size: var(--fs-h2); }
  .jc-link:hover .jc-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .jc-excerpt { color: var(--muted); max-width: 56ch; }
</style>
