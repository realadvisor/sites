---
/** Process list: step title and a short line beside it, full-width rules. */
interface Props { steps: { title: string; text: string }[] }
const { steps } = Astro.props;
---
<ol class="steps">
  {steps.map((s, i) => (
    <li>
      <span class="steps-n muted num">{i + 1}.</span>
      <h3 class="steps-title">{s.title}</h3>
      <p class="steps-text">{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; border-top: 1px solid var(--line-strong); }
  .steps li { display: grid; grid-template-columns: 40px minmax(0, 5fr) minmax(0, 6fr); gap: 12px var(--gap); align-items: baseline; padding: clamp(22px, 2.6vw, 36px) 0; border-bottom: 1px solid var(--line-strong); }
  .steps-title { font-size: var(--fs-h3); line-height: 1.2; }
  .steps-text { color: var(--muted); max-width: 52ch; }
  @media (max-width: 767px) {
    .steps li { grid-template-columns: 28px minmax(0, 1fr); }
    .steps-text { grid-column: 2; }
  }
</style>
