---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { agencyOf } from '@realadvisor/sites-kit-core/agency';
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import EnquiryForm from '@realadvisor/sites-kit-astro/components/EnquiryForm.astro';
import { img } from '@realadvisor/sites-kit-core/image';
import { agencyJsonLd } from '@realadvisor/sites-kit-core/seo';
import AgentCard from '../components/AgentCard.astro';
import { brandName, site } from '../lib/data';
import { telHref } from '../lib/format';
import { PHOTOS } from '../content/places';

const s = await site();
const brand = brandName(s);
const a = s.team.address;
const street = [a.street, [a.postcode, a.city].filter(Boolean).join(' ')].filter(Boolean);
const located = a.lat != null && a.lng != null;
const map = located ? `https://www.openstreetmap.org/?mlat=${a.lat}&mlon=${a.lng}#map=16/${a.lat}/${a.lng}` : undefined;
const photo = PHOTOS.riverside;
const siteUrl = Astro.site?.href ?? new URL('/', Astro.url).href;
---
<Layout title={`Kontakt | ${brand}`} description={`${brand}, ${street.join(', ')}. ${s.team.phone ?? ''}`} image={img(photo.url, { w: 1200, h: 630 })} jsonLd={agencyJsonLd(agencyOf(s.org, s.team), siteUrl)}>
  <section class="ch">
    <div class="ch-media"><RaImage src={photo.url} alt={photo.alt} width={1600} height={1100} priority sizes="(min-width: 1024px) 55vw, 100vw" mobile={{ width: 800, height: 600 }} /></div>
    <div class="ch-panel">
      <h1 class="h1">Besuchen Sie uns im Seefeld.</h1>
      <address class="ch-addr">
        <span class="caps muted">{brand}</span>
        {street.map((l) => <span>{l}</span>)}
      </address>
      <ul class="ch-list">
        {s.team.phone && <li><span class="caps muted">Telefon</span><a href={telHref(s.team.phone)}>{s.team.phone}</a></li>}
        {s.team.email && <li><span class="caps muted">E-Mail</span><a href={`mailto:${s.team.email}`}>{s.team.email}</a></li>}
      </ul>
      {map && <a class="more" href={map} rel="noopener" target="_blank">Auf der Karte ansehen</a>}
    </div>
  </section>

  <section class="section flow" aria-labelledby="h-form">
    <div class="wrap cf">
      <div class="cf-side">
        <h2 class="h2" id="h-form">Nachricht schreiben</h2>
        <p class="muted">Ihre Nachricht geht ans Büro. Geht es um ein bestimmtes Objekt, meldet sich die Person, die es betreut.</p>
      </div>
      <EnquiryForm contactReason="other" />
    </div>
  </section>

  <section class="section people" aria-labelledby="h-people">
    <div class="wrap">
      <header class="sec"><h2 class="h2" id="h-people">Direkt erreichen</h2></header>
      <ul class="people-grid">{s.agents.map((ag) => <li><AgentCard agent={ag} /></li>)}</ul>
    </div>
  </section>
</Layout>

<style>
  .ch { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
  .ch-media { position: relative; min-height: 560px; background: var(--surface); }
  .ch-media :global(picture) { display: contents; }
  .ch-media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ch-panel { background: var(--surface); display: grid; gap: 24px; align-content: center; justify-items: start; padding: clamp(40px, 5vw, 80px) clamp(28px, 4.5vw, 72px); }
  .ch-addr { font: 400 1.375rem/1.4 var(--serif); font-style: normal; display: grid; }
  .ch-addr .caps { margin-bottom: 8px; }
  .ch-list { list-style: none; display: grid; gap: 14px; }
  .ch-list li { display: grid; gap: 2px; }
  .ch-list a { font: 400 1.25rem/1.3 var(--serif); text-decoration: none; border-bottom: 1px solid var(--line-strong); width: fit-content; }
  .cf { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 40px clamp(40px, 6vw, 112px); }
  .cf-side { display: grid; gap: 18px; align-content: start; justify-items: start; }
  .cf-side .muted { max-width: 40ch; }
  .people { background: var(--surface); }
  .sec { display: grid; gap: 18px; justify-items: start; margin-bottom: clamp(28px, 3vw, 44px); }
  .people-grid { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px var(--gap); }
  @media (max-width: 1023px) {
    .ch, .cf { grid-template-columns: minmax(0, 1fr); }
    .ch-media { min-height: 0; aspect-ratio: 4 / 3; }
    .people-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 559px) { .people-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
