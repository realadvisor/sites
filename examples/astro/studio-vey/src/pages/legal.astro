---
// Legal notice (Impressum). Text from the kit (agency data only): restyled, never rewritten.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { agencyOf } from '@realadvisor/sites-kit-core/agency';
import LegalPage from '../components/LegalPage.astro';
import LegalContent from '@realadvisor/sites-kit-astro/components/LegalContent.astro';
import { legalNotice } from '@realadvisor/sites-kit-core/legal';
import { lang, t } from '@realadvisor/sites-kit-core/i18n';
import { site } from '../lib/data';

const s = await site();
const agency = agencyOf(s.org, s.team);
const title = t('legalNotice');
---
<Layout title={`${title} | ${s.org.name}`} description={`${title} ${s.org.name}`}>
  <LegalPage title={title}><LegalContent sections={legalNotice(agency, lang())} /></LegalPage>
</Layout>
