---
export const prerender = false;

import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import EnergyScale from '../../components/EnergyScale.astro';
import Collection from '../../components/Collection.astro';
import EnquiryForm from '@realadvisor/sites-kit/components/EnquiryForm.astro';
import ListingsMap from '@realadvisor/sites-kit/components/ListingsMap.astro';
import { sanitizeHtml, listingIdFromSlug } from '@realadvisor/sites-kit';
import { img } from '@realadvisor/sites-kit/image';
import { formatAmount, formatSurface } from '@realadvisor/sites-kit/format';
import { featureLabel, offerTypeLabel, propertyTypeLabel, t } from '@realadvisor/sites-kit/i18n';
import { listingJsonLd, listingRef, listingTitle } from '@realadvisor/sites-kit/seo';
import { agentUrl, areas, areaUrl, listingExtras, listingUrl, site, sites } from '../../lib/data';
import { price, rooms } from '../../lib/kit';
import { fullName, languages, telHref } from '../../lib/format';

const slug = Astro.params.slug!;
const listing = await sites.listing(slug);
if (!listing) {
  // Not found: the site's 404 page with a real 404. A slug ending with a
  // listing id was a listing of this site that left: 410 Gone.
  const gone = !!listingIdFromSlug(slug);
  (Astro.locals as { listingGone?: boolean }).listingGone = gone;
  const page = await Astro.rewrite('/404');
  return gone ? new Response(page.body, { status: 410, headers: page.headers }) : page;
}

const s = await site();
const l = listing;
const kit = l;
const city = l.address.city;
const sold = l.status === 'sold';
const isRent = l.offer_type === 'rent';
const [sameCity, sameOffer, areaList] = await Promise.all([
  city ? sites.allListings({ city }) : Promise.resolve([]),
  sites.listings({ offer_type: l.offer_type, status: 'available', limit: 12 }),
  areas(),
]);
const area = city ? areaList.find((a) => a.city === city) : undefined;
const similarLocal = sameCity.filter((x) => x.id !== l.id && x.status === 'available' && x.offer_type === l.offer_type);
const similar = (similarLocal.length >= 3 ? similarLocal : [...similarLocal, ...sameOffer.data.filter((x) => x.id !== l.id && !similarLocal.includes(x))]).slice(0, 3);
const similarTitle = similarLocal.length >= 3 && city ? `Weitere Objekte in ${city}` : isRent ? 'Weitere Objekte zur Miete' : 'Weitere Objekte zum Kauf';

// fixture only: energy class, year built, floor, outdoor surfaces and charges are not in the API yet.
const x = listingExtras(l.id);
const agent = l.agent;
const ref = listingRef(kit);
const type = propertyTypeLabel(l.property_type);
const place = [l.address.postcode, city].filter(Boolean).join(' ');
const searchHref = isRent ? '/mieten' : '/kaufen';
const searchLabel = isRent ? 'Mieten' : sold ? 'Verkauft' : 'Kaufen';

const rows: [string, string][] = [
  [t('offer'), sold ? 'Verkauft' : offerTypeLabel(l.offer_type)],
  [t('propertyType'), type],
  ...(!sold ? [[isRent ? 'Miete' : 'Preis', price(l)] as [string, string]] : []),
  // fixture only: charges
  ...(isRent && x.charges ? [['Nebenkosten', `${formatAmount(x.charges)} / Monat`] as [string, string]] : []),
  ...(l.rooms != null ? [['Zimmer', String(l.rooms)] as [string, string]] : []),
  ...(l.bedrooms != null ? [['Schlafzimmer', String(l.bedrooms)] as [string, string]] : []),
  ...(l.bathrooms != null ? [['Badezimmer', String(l.bathrooms)] as [string, string]] : []),
  ...(l.living_surface != null ? [[t('livingArea'), formatSurface(l.living_surface)] as [string, string]] : []),
  ...(l.land_surface != null ? [['Grundstück', formatSurface(l.land_surface)] as [string, string]] : []),
  // fixture only: terrace, balcony, floor, year built
  ...(x.terrace_surface ? [['Terrasse', formatSurface(x.terrace_surface)] as [string, string]] : []),
  ...(x.balcony_surface ? [['Balkon', formatSurface(x.balcony_surface)] as [string, string]] : []),
  ...(x.floor != null ? [['Etage', x.floor === 0 ? 'Erdgeschoss' : `${x.floor}. Obergeschoss`] as [string, string]] : []),
  ...(x.year_built ? [['Baujahr', String(x.year_built)] as [string, string]] : []),
  [t('reference'), ref],
];
const headline = [rooms(l.rooms), l.living_surface != null ? formatSurface(l.living_surface) : '', l.bedrooms != null ? `${l.bedrooms} Schlafzimmer` : ''].filter(Boolean);
const message = sold
  ? `Guten Tag, ich suche ein ähnliches Objekt wie «${l.title}» (Ref. ${ref}).`
  : t('interested', { title: l.title, ref });
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const located = l.address.lat != null && l.address.lng != null;
const mapsHref = located ? `https://www.openstreetmap.org/?mlat=${l.address.lat}&mlon=${l.address.lng}#map=15/${l.address.lat}/${l.address.lng}` : undefined;
const sections = [
  l.description && ['beschreibung', 'Beschreibung'],
  ['eckdaten', 'Eckdaten'],
  x.energy_class && ['energie', 'Energie'],
  located && ['lage', 'Lage'],
].filter(Boolean) as [string, string][];
---
<Layout
  title={`${listingTitle(kit, sameCity)} | ${sold ? 'Verkauft' : price(l)}`}
  description={(l.description_text ?? l.title).replace(/\s+/g, ' ').slice(0, 155)}
  image={l.photos[0] && img(l.photos[0].url, { w: 1200, h: 630 })}
  jsonLd={listingJsonLd(kit, pageUrl)}
>
  <nav class="crumbs wrap" aria-label="Brotkrumen">
    <ol>
      <li><a href={sold ? '/verkauft' : searchHref}>{searchLabel}</a></li>
      {city && <li>{area ? <a href={areaUrl(city)}>{city}</a> : city}</li>}
      <li aria-current="page"><span class="muted">Ref. {ref}</span></li>
    </ol>
  </nav>

  <div class="wrap">
    <Gallery photos={l.photos} title={l.title} label={sold ? 'Verkauft' : undefined} />
    {l.photos.length === 0 && <div class="nophoto lp-nophoto caps">{type}</div>}
  </div>

  <div class="lp wrap">
    <article class="lp-main">
      <header class="lp-head">
        <p class="caps muted">{type}{place && ` · ${place}`}</p>
        <h1 class="h1">{l.title}</h1>
        {headline.length > 0 && <p class="lp-facts num">{headline.join(' · ')}</p>}
        <p class="lp-price num">{sold ? 'Verkauft' : price(l)}</p>
      </header>

      {l.description && (
        <section id="beschreibung" class="lp-sec" aria-labelledby="h-beschreibung">
          <h2 class="lp-h caps" id="h-beschreibung">Beschreibung</h2>
          <div class="prose lp-prose" set:html={sanitizeHtml(l.description)} />
        </section>
      )}

      <section id="eckdaten" class="lp-sec" aria-labelledby="h-eckdaten">
        <h2 class="lp-h caps" id="h-eckdaten">Eckdaten</h2>
        <dl class="specs">
          {rows.map(([k, v]) => <div><dt>{k}</dt><dd class="num">{v}</dd></div>)}
        </dl>
        {l.features.length > 0 && (
          <ul class="feats">{l.features.map((f) => <li>{featureLabel(f)}</li>)}</ul>
        )}
      </section>

      {x.energy_class && (
        <section id="energie" class="lp-sec" aria-labelledby="h-energie">
          <h2 class="lp-h caps" id="h-energie">Energie</h2>
          {/* fixture only: energy_class */}
          <EnergyScale value={x.energy_class} />
        </section>
      )}

      {located && (
        <section id="lage" class="lp-sec" aria-labelledby="h-lage">
          <h2 class="lp-h caps" id="h-lage">Lage</h2>
          <p class="lp-place">{place}{area && <> · <a href={areaUrl(city!)}>Mehr über {city}</a></>}</p>
          <div class="lp-map"><ListingsMap listings={[kit]} view={{ z: 14, lat: l.address.lat!, lng: l.address.lng! }} href={() => listingUrl(l)} price={() => (sold ? 'Verkauft' : price(l))} /></div>
          <p class="lp-note muted">Die Karte zeigt die ungefähre Lage. Die genaue Adresse erhalten Sie bei der Besichtigung. {mapsHref && <a href={mapsHref} rel="noopener" target="_blank">In OpenStreetMap öffnen</a>}</p>
        </section>
      )}
    </article>

    <aside class="lp-aside" aria-label="Auf einen Blick">
      <div class="kf">
        <p class="caps muted">{sold ? 'Verkauft' : offerTypeLabel(l.offer_type)}</p>
        <p class="kf-title">{l.title}</p>
        {place && <p class="kf-place muted">{place}</p>}
        <p class="kf-price num">{sold ? 'Verkauft' : price(l)}</p>
        {headline.length > 0 && <p class="kf-facts num muted">{headline.slice(0, 2).join(' · ')}</p>}
        <nav class="kf-nav" aria-label="Auf dieser Seite">
          {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
        <a class="button button--solid kf-cta" href="#anfrage">{sold ? 'Ähnliches Objekt suchen' : isRent ? 'Besichtigung anfragen' : 'Besichtigung anfragen'}</a>
        {agent && (
          <div class="kf-agent">
            {agent.photo && <div class="kf-agent-photo"><RaImage src={agent.photo.url} alt={fullName(agent)} width={144} height={180} sizes="72px" /></div>}
            <div>
              <a href={agentUrl(agent)} class="kf-agent-name">{fullName(agent)}</a>
              {agent.phone && <a href={telHref(agent.phone)} class="kf-agent-phone muted">{agent.phone}</a>}
            </div>
          </div>
        )}
      </div>
    </aside>
  </div>

  <section id="anfrage" class="enq" aria-labelledby="h-anfrage">
    <div class="wrap enq-in">
      <div class="enq-agent">
        {agent ? (
          <>
            {agent.photo && <div class="enq-photo"><RaImage src={agent.photo.url} alt={fullName(agent)} width={480} height={600} sizes="240px" /></div>}
            <p class="enq-name"><a href={agentUrl(agent)}>{fullName(agent)}</a></p>
            {agent.title && <p class="caps muted">{agent.title}</p>}
            {agent.languages?.length ? <p class="muted">Spricht {languages(agent.languages)}</p> : null}
            <ul class="enq-contact">
              {agent.phone && <li><a href={telHref(agent.phone)}>{agent.phone}</a></li>}
              {agent.email && <li><a href={`mailto:${agent.email}`}>{agent.email}</a></li>}
            </ul>
          </>
        ) : (
          <ul class="enq-contact">
            {s.team.phone && <li><a href={telHref(s.team.phone)}>{s.team.phone}</a></li>}
            {s.team.email && <li><a href={`mailto:${s.team.email}`}>{s.team.email}</a></li>}
          </ul>
        )}
      </div>
      <div class="enq-form">
        <h2 class="h2" id="h-anfrage">{sold ? 'Ein ähnliches Objekt finden' : 'Anfrage zu diesem Objekt'}</h2>
        <p class="muted enq-lede">{sold
          ? 'Dieses Objekt ist verkauft. Beschreiben Sie, was Sie suchen: Wir melden uns, sobald ein passendes Objekt zu uns kommt.'
          : `${agent ? agent.first_name : 'Wir'} ${agent ? 'beantwortet' : 'beantworten'} Ihre Fragen und vereinbart gerne eine Besichtigung mit Ihnen.`}</p>
        {sold
          ? <EnquiryForm contactReason="buy" agentId={agent?.id} agentName={agent?.first_name} message={message} submitLabel="Suchauftrag senden" />
          : <EnquiryForm listingId={l.id} agentId={agent?.id} agentName={agent?.first_name} message={message} />}
      </div>
    </div>
  </section>

  <Collection id="c-similar" label={isRent ? 'Zur Miete' : 'Zum Kauf'} title={similarTitle} listings={similar} href={searchHref} linkLabel="Alle ansehen" />


  {!sold && (
    <div class="mbar" aria-label="Schnellkontakt">
      <span class="mbar-price num">{price(l)}</span>
      {(agent?.phone ?? s.team.phone) && <a class="button mbar-call" href={telHref((agent?.phone ?? s.team.phone)!)}>Anrufen</a>}
      <a class="button button--solid mbar-cta" href="#anfrage">Anfragen</a>
    </div>
  )}
</Layout>

<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0 10px; padding: 18px 0; font-size: var(--fs-small); }
  .crumbs li { display: inline-flex; align-items: center; gap: 10px; min-height: 32px; }
  .crumbs li + li::before { content: '/'; color: var(--line-strong); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .lp-nophoto { aspect-ratio: 2.35 / 1; }

  .lp { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: clamp(40px, 6vw, 112px); padding-top: clamp(40px, 5vw, 72px); padding-bottom: clamp(56px, 7vw, 112px); align-items: start; }
  .lp-head { display: grid; gap: 16px; padding-bottom: clamp(32px, 4vw, 48px); border-bottom: 1px solid var(--line); }
  .lp-head h1 { max-width: 18ch; }
  .lp-facts { font: 400 var(--fs-lede)/1.4 var(--serif); white-space: normal; }
  .lp-sec { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 16px 40px; padding-block: clamp(32px, 4vw, 52px); border-bottom: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 16px); }
  .lp-sec > :not(.lp-h) { grid-column: 2; }
  .lp-h { padding-top: 6px; }
  .specs { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; }
  .specs div { display: flex; justify-content: space-between; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--line); }
  .specs dt { color: var(--muted); }
  .specs dd { margin: 0; text-align: right; font-weight: 500; }
  .feats { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .feats li { padding: 7px 14px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.9375rem; }
  .lp-place { font: 400 1.25rem/1.3 var(--serif); }
  .lp-place a { font: 400 1rem var(--sans); }
  .lp-map { --map-h: 380px; margin-top: 8px; }
  .lp-note { font-size: var(--fs-small); }

  .lp-aside { position: sticky; top: calc(var(--header-h) + 24px); }
  .kf { background: var(--paper); border: 1px solid var(--line); padding: 32px 32px 28px; display: grid; gap: 8px; box-shadow: 0 24px 48px -32px rgb(29 34 32 / 0.25); }
  .kf-title { font: 400 1.75rem/1.15 var(--serif); margin-top: 4px; }
  .kf-price { font: 400 1.625rem/1.2 var(--serif); margin-top: 14px; }
  .kf-nav { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 16px 0 8px; }
  .kf-nav a { font: 500 var(--fs-caps)/1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; padding: 12px 0 8px; border-bottom: 1px solid var(--line-strong); }
  .kf-nav a:hover { border-color: currentColor; }
  .kf-cta { width: 100%; margin-top: 12px; }
  .kf-agent { display: flex; gap: 14px; align-items: center; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); }
  .kf-agent-photo { width: 72px; aspect-ratio: 4 / 5; flex: none; overflow: hidden; background: var(--surface); }
  .enq-photo { width: 240px; max-width: 100%; aspect-ratio: 4 / 5; overflow: hidden; background: var(--paper); }
  .kf-agent-photo :global(img), .enq-photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .kf-agent > div { display: grid; }
  .kf-agent-name { font: 400 1.1875rem/1.2 var(--serif); text-decoration: none; }
  .kf-agent-name:hover { text-decoration: underline; }
  .kf-agent-phone { font-size: 0.9375rem; text-decoration: none; }

  .enq { background: var(--surface); padding-block: var(--section); scroll-margin-top: var(--header-h); }
  .enq-in { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 112px); align-items: start; }
  .enq-agent { display: grid; gap: 14px; justify-items: start; }
  .enq-name { font: 400 var(--fs-h2)/1.1 var(--serif); }
  .enq-name a { text-decoration: none; }
  .enq-name a:hover { text-decoration: underline; }
  .enq-contact { list-style: none; display: grid; gap: 4px; margin-top: 8px; }
  .enq-contact a { display: inline-flex; min-height: 36px; align-items: center; text-decoration: none; border-bottom: 1px solid var(--line-strong); }
  .enq-form { display: grid; gap: 18px; }
  .enq-lede { max-width: 52ch; margin-bottom: 12px; }

  .mbar, .lp-price { display: none; }

  @media (max-width: 1099px) {
    .lp { grid-template-columns: minmax(0, 1fr); }
    .lp-aside { position: static; margin-top: 0; order: -1; display: none; }
    .lp-sec { grid-template-columns: minmax(0, 1fr); }
    .lp-price { display: block; font: 400 1.5rem/1.2 var(--serif); }
    .lp-sec > :not(.lp-h) { grid-column: 1; }
    .enq-in { grid-template-columns: minmax(0, 1fr); }
    .mbar {
      display: flex; gap: 8px; align-items: center; position: fixed; z-index: 30; left: 0; right: 0; bottom: 0;
      padding: 10px var(--gutter) max(10px, env(safe-area-inset-bottom)); background: var(--bg); border-top: 1px solid var(--line);
    }
    .mbar-price { flex: 1; font: 400 1.125rem/1.2 var(--serif); min-width: 0; white-space: nowrap; }
    .mbar .button { padding: 0 14px; letter-spacing: 0.1em; }
    :global(body:has(.mbar)) { padding-bottom: 72px; }
  }
  @media (max-width: 639px) {
    .specs { grid-template-columns: minmax(0, 1fr); }
    .lp-map { --map-h: 300px; }
  }
</style>
