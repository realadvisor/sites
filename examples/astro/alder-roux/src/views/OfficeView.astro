---
/** One office (team): address, phone, email, map, its advisors, its listings, a message to the office. */
import EnquiryForm from '@realadvisor/sites-kit/components/EnquiryForm.astro';
import { sanitizeHtml } from '@realadvisor/sites-kit';
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import AgentCard from '../components/AgentCard.astro';
import ListingCard from '../components/ListingCard.astro';
import StaticMap from '../components/StaticMap.astro';
import { siteData, sites, type Team } from '../lib/data';
import { agentSlug, href, LOCALE, teamSlug, type L } from '../lib/routes';
import { cityName, tx } from '../lib/copy';
import { tel } from '../lib/format';
import { placeOg, officePlace, placeAlt } from '../content/places';
import PlacePhoto from '../components/PlacePhoto.astro';

interface Props { l: L; team: Team }
const { l, team } = Astro.props;
const t = tx(l);
const { org, teams, agents } = await siteData();
const slug = teamSlug(team, teams);
const listings = await sites.allListings({ team_id: team.id, status: 'available' });
const members = agents.filter((a) => a.team_ids.includes(team.id));
const city = cityName(team.address.city, l) || team.name;
const place = officePlace(team.address.city);
const addr = [team.address.street, [team.address.postcode, cityName(team.address.city, l)].filter(Boolean).join(' ')].filter(Boolean);
const buyN = listings.filter((x) => x.offer_type === 'buy').length;
const rentN = listings.filter((x) => x.offer_type === 'rent').length;
---
<Site l={l} route="offices" segs={[slug]} title={`${t('officeOf', { city })} | ${org.name}`}
  description={team.description_text ?? `${t('officeOf', { city })} · ${addr.join(', ')}`}
  image={place && placeOg(place, Astro.site)}>
  <section class="hero on-navy">
    <div class="hero__copy">
      <Crumbs label={t('breadcrumb')} items={[{ label: t('home'), href: href('home', l) }, { label: t('navOffices'), href: href('offices', l) }, { label: city }]} />
      <h1 class="h1">{t('officeOf', { city })}</h1>
      {team.description && <div class="hero__desc" set:html={sanitizeHtml(team.description)} />}
      <dl class="hero__contact">
        {addr.length > 0 && <div><dt>{t('address')}</dt><dd>{addr.map((a) => <span>{a}</span>)}</dd></div>}
        {team.phone && <div><dt>{t('phone')}</dt><dd><a class="num" href={tel(team.phone)}>{team.phone}</a></dd></div>}
        {team.email && <div><dt>{t('email')}</dt><dd><a href={`mailto:${team.email}`}>{team.email}</a></dd></div>}
      </dl>
    </div>
    <div class="hero__media">
      {place && <PlacePhoto place={place} alt={placeAlt(place, l)} width={1200} height={1000} priority sizes="(min-width: 1025px) 46vw, 100vw" mobile={{ width: 800, height: 560 }} />}
    </div>
  </section>

  {members.length > 0 && (
    <section class="section section--paper">
      <div class="wrap">
        <h2 class="h2 sec-h">{t('team')} <span class="sec-h__n num">{members.length === 1 ? t('nAgent1') : t('nAgents', { n: members.length })}</span></h2>
        <ul class="plain-list grid grid--3">{members.map((a) => <li><AgentCard agent={a} slug={agentSlug(a, agents)} team={team} l={l} /></li>)}</ul>
      </div>
    </section>
  )}

  {listings.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="h2 sec-h">{t('officeListings')} <span class="sec-h__n num">{[buyN > 0 && `${t('areaForSale')} ${buyN}`, rentN > 0 && `${t('areaForRent')} ${rentN}`].filter(Boolean).join(' · ')}</span></h2>
        <ul class="plain-list grid grid--3">{listings.map((x) => <li><ListingCard listing={x} l={l} /></li>)}</ul>
      </div>
    </section>
  )}

  <section class="section section--paper" id="contact">
    <div class="wrap contact">
      <div class="contact__form">
        <h2 class="h2">{t('officeContact')}</h2>
        <EnquiryForm locale={LOCALE[l]} contactReason="other" message={t('officeMessage', { city })} />
      </div>
      {team.address.lat != null && team.address.lng != null && (
        <StaticMap lat={team.address.lat} lng={team.address.lng} zoom={15} height={460} label={`${t('officeOf', { city })}: ${addr.join(', ')}`} linkLabel={t('directions')} />
      )}
    </div>
  </section>
</Site>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr); background: var(--navy); color: #fff; }
  .hero__copy { display: grid; gap: 22px; align-content: center; padding: clamp(40px, 5vw, 80px) clamp(32px, 5vw, 80px) clamp(40px, 5vw, 80px) max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); }
  .hero__desc { color: var(--on-navy-muted); font-size: var(--step-1); max-width: 52ch; }
  .hero__contact { display: grid; border-top: 1px solid var(--line-on-navy); margin-top: 8px; }
  .hero__contact div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line-on-navy); }
  .hero__contact dt { color: var(--on-navy-muted); font-size: 0.875rem; }
  .hero__contact dd { display: grid; }
  .hero__contact a { color: #fff; overflow-wrap: anywhere; }
  .hero__media { position: relative; min-height: 460px; background: var(--navy-deep); }
  .hero__media :global(img), .hero__media :global(picture) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sec-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 20px; margin-bottom: clamp(24px, 3vw, 40px); }
  .sec-h__n { font: 400 1rem/1.3 var(--font-sans); color: var(--muted); letter-spacing: 0; }
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .contact__form { display: grid; gap: 24px; }
  @media (max-width: 1024px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero__copy { padding: 40px var(--gutter); }
    .hero__media { min-height: 0; aspect-ratio: 10 / 7; }
    .contact { grid-template-columns: minmax(0, 1fr); }
  }
</style>
