---
/** Developments list: one programme card per development (render, status, place, from price, availability). */
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import { developmentStatus } from '@realadvisor/sites-kit-core/developments';
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import { siteData, sites } from '../lib/data';
import { href, type L } from '../lib/routes';
import { cityName, tx } from '../lib/copy';
import { formatAmount, formatSurface, monthYear, range, rooms, roomsRange } from '../lib/format';

interface Props { l: L }
const { l } = Astro.props;
const t = tx(l);
const [{ org }, devs] = await Promise.all([siteData(), sites.developments()]);
---
<Site l={l} route="developments" title={`${t('devTitle')} | ${org.name}`} description={t('devLede')}>
  <section class="band on-navy">
    <div class="wrap band__inner">
      <Crumbs label={t('breadcrumb')} items={[{ label: t('home'), href: href('home', l) }, { label: t('navNew') }]} />
      <h1 class="h1">{t('devTitle')}</h1>
      <p class="lede">{t('devLede')}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <ul class="plain-list progs">
        {devs.map((d, i) => {
          const status = developmentStatus({ status: d.status }, l);
          return (
            <li>
              <article class="prog">
                <a class="prog__media" href={href('developments', l, d.slug)} tabindex="-1" aria-hidden="true">
                  {d.photos[0] && <RaImage src={d.photos[0]} alt="" width={1200} height={760} priority={i === 0} sizes="(min-width: 1024px) 60vw, 100vw" />}
                  {status && <span class="prog__tag">{status}</span>}
                </a>
                <div class="prog__body">
                  <span class="prog__city">{cityName(d.address.city, l)}</span>
                  <h2 class="h2"><a href={href('developments', l, d.slug)}>{d.title}</a></h2>
                  {d.description_text && <p class="prog__text">{d.description_text.split('\n')[0]}</p>}
                  <dl class="kv">
                    {d.stats.units > 0 && <div><dt>{t('units')}</dt><dd>{t('unitsAvailable', { n: d.stats.available, t: d.stats.units })}</dd></div>}
                    {d.stats.price?.min && <div><dt>{t('price')}</dt><dd>{t('priceFrom', { p: formatAmount(d.stats.price.min) })}</dd></div>}
                    {d.stats.rooms && <div><dt>{t('rooms')}</dt><dd>{roomsRange(d.stats.rooms, l)}</dd></div>}
                    {d.stats.living_surface && <div><dt>{t('livingArea')}</dt><dd>{range(d.stats.living_surface, (n) => formatSurface(n))}</dd></div>}
                    {d.delivery_date && <div><dt>{t('delivery')}</dt><dd>{monthYear(d.delivery_date, l)}</dd></div>}
                  </dl>
                  <a class="button" href={href('developments', l, d.slug)}>{t('discover')}</a>
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Site>

<style>
  .progs { display: grid; gap: clamp(48px, 6vw, 96px); }
  .prog { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .prog__media { position: relative; display: block; aspect-ratio: 30 / 19; overflow: hidden; background: var(--paper-2); }
  .prog__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .prog__tag { position: absolute; left: 0; top: 20px; background: var(--navy); color: #fff; padding: 8px 14px; font: 600 0.6875rem/1 var(--font-sans); letter-spacing: 0.14em; text-transform: uppercase; }
  .prog__body { display: grid; gap: 20px; justify-items: start; }
  .prog__body h2 a { text-decoration: none; }
  .prog__city { font-size: 1rem; color: var(--muted); }
  .prog__text { color: var(--muted); font-size: 1.0625rem; }
  .prog__body .kv { width: 100%; border-top: 1px solid var(--line); }
  @media (max-width: 960px) { .prog { grid-template-columns: minmax(0, 1fr); } }
</style>
