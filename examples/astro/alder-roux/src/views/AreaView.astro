---
/**
 * One area (a city with 3+ listings): photo hero, short introduction (site
 * content), figures computed from its listings, the office that covers it,
 * its listings for sale and to rent, and what sold there.
 */
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import ListingCard from '../components/ListingCard.astro';
import { siteData, sites } from '../lib/data';
import { href, teamSlug, type L } from '../lib/routes';
import { cityName, tx } from '../lib/copy';
import { formatAmount, formatSurface, range, tel, typeLabel } from '../lib/format';
import { areasOf, officeFor } from '../lib/areas';
import { placeOg, areaPlace, placeAlt } from '../content/places';
import PlacePhoto from '../components/PlacePhoto.astro';

interface Props { l: L; slug: string }
const { l, slug } = Astro.props;
const t = tx(l);
const [{ org, teams }, all] = await Promise.all([siteData(), sites.allListings()]);
const area = areasOf(all).find((a) => a.slug === slug)!;
const here = all.filter((x) => x.address.city === area.city);
const avail = here.filter((x) => x.status === 'available');
const buy = avail.filter((x) => x.offer_type === 'buy');
const rent = avail.filter((x) => x.offer_type === 'rent');
const sold = here.filter((x) => x.status === 'sold');
const office = officeFor(area.city, here, teams);
const place = areaPlace(area.city, office?.address.city);
const city = cityName(area.city, l);
const prices = buy.map((x) => x.price).filter((p): p is number => !!p && p > 0);
const surfaces = avail.map((x) => x.living_surface).filter((s): s is number => !!s);
const types = [...new Set(avail.map((x) => typeLabel(x.property_type, l)))];
const facts = [
  buy.length > 0 && { k: t('areaForSale'), v: String(buy.length) },
  rent.length > 0 && { k: t('areaForRent'), v: String(rent.length) },
  prices.length > 0 && { k: t('areaPriceRange'), v: range({ min: Math.min(...prices), max: Math.max(...prices) }, formatAmount) },
  surfaces.length > 0 && { k: t('areaSurfaces'), v: range({ min: Math.min(...surfaces), max: Math.max(...surfaces) }, (n) => formatSurface(n)) },
  types.length > 0 && { k: t('propertyType'), v: types.join(', ') },
].filter(Boolean) as { k: string; v: string }[];
const officeCity = office ? cityName(office.address.city, l) || office.name : '';
---
<Site l={l} route="areas" segs={[slug]} title={`${t('homesIn', { city })} | ${org.name}`}
  description={place?.intro?.[l] ?? `${t('homesIn', { city })} · ${org.name}`}
  image={place && placeOg(place, Astro.site)}>
  <section class="hero">
    {place && <PlacePhoto place={place} alt={placeAlt(place, l)} width={1600} height={700} priority sizes="100vw" mobile={{ width: 800, height: 900 }} data-hero />}
    <div class="hero__shade"></div>
    <div class="wrap hero__copy on-navy">
      <Crumbs label={t('breadcrumb')} items={[{ label: t('home'), href: href('home', l) }, { label: t('navAreas'), href: href('areas', l) }, { label: city }]} />
      <h1 class="h1">{t('homesIn', { city })}</h1>
      {place?.intro && <p class="lede">{place.intro[l]}</p>}
    </div>
  </section>

  <section class="wrap summary">
    {facts.length > 0 && (
      <dl class="kv summary__facts">{facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}</dl>
    )}
    {office && (
      <aside class="office">
        <span class="eyebrow">{t('nearestOffice', { city })}</span>
        <p class="office__name"><a href={href('offices', l, teamSlug(office, teams))}>{t('officeOf', { city: officeCity })}</a></p>
        <p class="office__addr">{[office.address.street, [office.address.postcode, cityName(office.address.city, l)].filter(Boolean).join(' ')].filter(Boolean).join(', ')}</p>
        {office.phone && <a class="button" href={tel(office.phone)}>{t('call')} <span class="num">{office.phone}</span></a>}
      </aside>
    )}
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><div><h2 class="h2">{t('areaAvailable', { city })}</h2></div>
        {buy.length > 0 && <a class="link" href={`${href('buy', l)}?city=${encodeURIComponent(area.city)}`}>{t('seeAllBuy')}</a>}
      </div>
      {avail.length > 0
        ? <ul class="plain-list grid grid--3">{[...buy, ...rent].map((x) => <li><ListingCard listing={x} l={l} /></li>)}</ul>
        : <p class="lede">{t('areaNone', { city, office: officeCity })}</p>}
    </div>
  </section>

  {sold.length > 0 && (
    <section class="section section--paper">
      <div class="wrap">
        <div class="head"><div><h2 class="h2">{t('areaSold', { city })}</h2></div></div>
        <ul class="plain-list grid grid--3">{sold.map((x) => <li><ListingCard listing={x} l={l} /></li>)}</ul>
      </div>
    </section>
  )}
</Site>

<style>
  .hero { position: relative; min-height: clamp(420px, 56vh, 620px); display: grid; align-items: end; background: var(--navy); overflow: hidden; }
  .hero > :global(img), .hero > :global(picture) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero > :global(picture img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(to top, rgb(10 20 34 / 0.9) 10%, rgb(10 20 34 / 0.55) 55%, rgb(10 20 34 / 0.15)); }
  .hero__copy { position: relative; display: grid; gap: 18px; padding-block: 48px; color: #fff; }
  .hero__copy .lede { color: #e6ebf2; }
  .summary { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); padding-top: clamp(40px, 5vw, 64px); align-items: start; }
  .summary__facts { border-top: 1px solid var(--line); }
  .summary__facts dd { white-space: normal; }
  .office { background: var(--paper); padding: 28px; display: grid; gap: 12px; justify-items: start; }
  .office__name { font: 400 1.5rem/1.2 var(--font-display); }
  .office__name a { text-decoration: none; }
  .office__name a:hover { text-decoration: underline; }
  .office__addr { color: var(--muted); }
  @media (max-width: 900px) { .summary { grid-template-columns: minmax(0, 1fr); } }
</style>
