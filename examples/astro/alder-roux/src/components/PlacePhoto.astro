---
/**
 * A place photo (src/content/places.ts): the RealAdvisor pool via the kit's
 * RaImage, or a framed pool photo via FramedPhoto. Same props as RaImage.
 */
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import FramedPhoto from './FramedPhoto.astro';
import type { Place } from '../content/places';

type Props = { place: Place; alt: string; width: number; height: number; sizes?: string; priority?: boolean;
  mobile?: { width: number; height: number; sizes?: string }; widths?: number[]; [k: `data-${string}`]: unknown; class?: string };
const { place, mobile, widths, ...rest } = Astro.props;
---
{typeof place.photo === 'string'
  ? <RaImage src={place.photo} mobile={mobile} widths={widths} {...rest} />
  : <FramedPhoto photo={place.photo} mobile={!!mobile} {...rest} />}
