---
/** Sold properties: the sold listings in the card grid, no prices, and a line to the valuation. */
import Site from '../layouts/Site.astro';
import PageBand from '../components/PageBand.astro';
import ListingCard from '../components/ListingCard.astro';
import { siteData, sites } from '../lib/data';
import { href, type L } from '../lib/routes';
import { tx } from '../lib/copy';

interface Props { l: L }
const { l } = Astro.props;
const t = tx(l);
const [{ org }, sold] = await Promise.all([siteData(), sites.allListings({ status: 'sold' })]);
---
<Site l={l} route="sold" title={`${t('soldTitle')} | ${org.name}`} description={t('soldLede')}>
  <PageBand l={l} title={t('soldTitle')} lede={t('soldLede')} crumbs={[{ label: t('navSold') }]} />
  <section class="section wrap">
    {sold.length > 0
      ? <ul class="plain-list grid3">{sold.map((x, i) => <li><ListingCard listing={x} l={l} as="h2" priority={i === 0} /></li>)}</ul>
      : <p class="lede">{t('soldLede')}</p>}
    <div class="cta">
      <p class="h3">{t('soldCta')}</p>
      <a class="button" href={href('sell', l)}>{t('valuationCta')}</a>
    </div>
  </section>
</Site>

<style>
  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 28px; }
  .cta { margin-top: var(--section); padding-top: 32px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; }
  .cta .h3 { font-family: var(--font-display); color: var(--green-ink); }
  @media (max-width: 900px) { .grid3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid3 { grid-template-columns: minmax(0, 1fr); } }
</style>
