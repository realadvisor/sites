---
/** Offices: a map with one pin per office, then each office with its photo, address, contacts, team and listing count. */
import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';
import Site from '../layouts/Site.astro';
import PageBand from '../components/PageBand.astro';
import StaticMap from '../components/StaticMap.astro';
import { siteData, sites } from '../lib/data';
import { placeOf } from '../content/places';
import { agentSlug, href, teamSlug, type L } from '../lib/routes';
import { cityName, tx } from '../lib/copy';
import { tel } from '../lib/format';

interface Props { l: L }
const { l } = Astro.props;
const t = tx(l);
const [{ org, teams, agents }, all] = await Promise.all([siteData(), sites.allListings({ status: 'available' })]);
const pts = teams.filter((x) => x.address.lat != null && x.address.lng != null);
const lat = pts.length ? (Math.min(...pts.map((x) => x.address.lat!)) + Math.max(...pts.map((x) => x.address.lat!))) / 2 : undefined;
const lng = pts.length ? (Math.min(...pts.map((x) => x.address.lng!)) + Math.max(...pts.map((x) => x.address.lng!))) / 2 : undefined;
---
<Site l={l} route="offices" title={`${t('officesTitle')} | ${org.name}`} description={t('officesLede')}>
  <PageBand l={l} title={t('officesTitle')} lede={t('officesLede')} crumbs={[{ label: t('navOffices') }]} />
  <div class="wrap section offices">
    {teams.map((x, i) => {
      const slug = teamSlug(x, teams);
      const city = cityName(x.address.city, l) || x.name;
      const place = placeOf(slug);
      const crew = agents.filter((a) => a.team_ids.includes(x.id));
      const n = all.filter((y) => y.team_ids.includes(x.id)).length;
      return (
        <article class="office">
          <a class="office__media" href={href('offices', l, slug)} tabindex="-1" aria-hidden="true">
            {place && <RaImage src={place.photo} alt="" width={960} height={640} sizes="(min-width: 900px) 46vw, 100vw" priority={i === 0} />}
          </a>
          <div class="office__body">
            <h2 class="h2"><a href={href('offices', l, slug)}>{t('officeOf', { city })}</a></h2>
            <address>
              {x.address.street && <span>{x.address.street}</span>}
              {(x.address.postcode || x.address.city) && <span>{[x.address.postcode, cityName(x.address.city, l)].filter(Boolean).join(' ')}</span>}
            </address>
            <ul class="plain-list links">
              {x.phone && <li><a class="num" href={tel(x.phone)}>{x.phone}</a></li>}
              {x.email && <li><a href={`mailto:${x.email}`}>{x.email}</a></li>}
            </ul>
            {x.description_text && <p class="muted">{x.description_text}</p>}
            {crew.length > 0 && (
              <p class="crew"><span>{t('team')}:</span> {crew.map((a, j) => <>{j > 0 && ', '}<a href={href('team', l, agentSlug(a, agents))}>{a.first_name} {a.last_name}</a></>)}</p>
            )}
            {n > 0 && <a class="more" href={href('offices', l, slug)}>{t('officeListings', { city })} ({n})</a>}
          </div>
        </article>
      );
    })}
  </div>
  {lat != null && lng != null && pts.length > 1 && (
    <div class="wrap mapwrap section">
      <StaticMap lat={lat} lng={lng} zoom={8} height={420} label={t('officeMap')} linkLabel={t('openMap')}
        points={pts.map((x) => ({ lat: x.address.lat!, lng: x.address.lng!, label: cityName(x.address.city, l) || x.name, href: href('offices', l, teamSlug(x, teams)) }))} />
    </div>
  )}
</Site>

<style>
  .mapwrap { padding-top: 0; }
  .offices { display: grid; gap: clamp(48px, 6vw, 80px); }
  .office { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
  .office__media { display: block; aspect-ratio: 3 / 2; overflow: hidden; background: var(--paper-2); }
  .office__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .office__body { display: grid; gap: 12px; align-content: start; }
  .office__body h2 { color: var(--green-ink); }
  .office__body h2 a { text-decoration: none; }
  .office__body h2 a:hover { text-decoration: underline; }
  address { font-style: normal; display: grid; }
  .links a { display: inline-flex; min-height: 34px; align-items: center; color: var(--green); }
  .crew span { color: var(--muted); }
  .crew a { color: var(--green); }
  @media (max-width: 860px) { .office { grid-template-columns: minmax(0, 1fr); } }
</style>
