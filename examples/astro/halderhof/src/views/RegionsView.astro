---
/** Regions: one per office, with its photo, the towns where it has listings (counts and asking prices) and a link to the region page. */
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import Site from '../layouts/Site.astro';
import PageBand from '../components/PageBand.astro';
import TownTable from '../components/TownTable.astro';
import { siteData, sites } from '../lib/data';
import { regionsOf } from '../lib/regions';
import { placeOf } from '../content/places';
import { href, type L } from '../lib/routes';
import { cityName, tx } from '../lib/copy';

interface Props { l: L }
const { l } = Astro.props;
const t = tx(l);
const [{ org, teams }, all] = await Promise.all([siteData(), sites.allListings()]);
const regions = regionsOf(teams, all);
---
<Site l={l} route="areas" title={`${t('regionsPageTitle')} | ${org.name}`} description={t('regionsLede')}>
  <PageBand l={l} title={t('regionsPageTitle')} lede={t('regionsLede')} crumbs={[{ label: t('navAreas') }]} />
  <div class="wrap section list">
    {regions.map((r, i) => {
      const city = cityName(r.team.address.city, l) || r.team.name;
      const place = placeOf(r.slug, 1);
      return (
        <article class="region">
          <a class="region__media" href={href('areas', l, r.slug)} tabindex="-1" aria-hidden="true">
            {place && <RaImage src={place.photo} alt="" width={900} height={600} sizes="(min-width: 900px) 40vw, 100vw" priority={i === 0} />}
          </a>
          <div class="region__body">
            <h2 class="h2"><a href={href('areas', l, r.slug)}>{t('regionOf', { city })}</a></h2>
            <TownTable l={l} towns={r.towns} caption={t('regionOf', { city })} />
            <a class="more" href={href('areas', l, r.slug)}>{t('regionTitle', { city })}</a>
          </div>
        </article>
      );
    })}
  </div>
</Site>

<style>
  .list { display: grid; gap: clamp(48px, 6vw, 80px); }
  .region { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .region__media { display: block; aspect-ratio: 3 / 2; overflow: hidden; background: var(--paper-2); }
  .region__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .region__body { display: grid; gap: 16px; }
  .region__body h2 { color: var(--green-ink); }
  .region__body h2 a { text-decoration: none; }
  .region__body h2 a:hover { text-decoration: underline; }
  @media (max-width: 860px) { .region { grid-template-columns: minmax(0, 1fr); } }
</style>
