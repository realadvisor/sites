---
/** One adviser: portrait, office, languages, contacts, an enquiry form addressed to them, and their listings. */
import EnquiryForm from '@realadvisor/sites-kit/components/EnquiryForm.astro';
import { img } from '@realadvisor/sites-kit/image';
import type { Agent } from '@realadvisor/sites-sdk/types';
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import Portrait from '../components/Portrait.astro';
import ListingCard from '../components/ListingCard.astro';
import { siteData, sites } from '../lib/data';
import { agentSlug, href, LOCALE, teamSlug, type L } from '../lib/routes';
import { cityName, langNames, tx } from '../lib/copy';
import { tel } from '../lib/format';

interface Props { l: L; agent: Agent }
const { l, agent: a } = Astro.props;
const t = tx(l);
const [{ org, teams, agents }, all] = await Promise.all([siteData(), sites.allListings()]);
const mine = all.filter((x) => x.agent?.id === a.id);
const live = mine.filter((x) => x.status === 'available');
const sold = mine.filter((x) => x.status === 'sold');
const team = teams.find((x) => a.team_ids.includes(x.id));
const city = team ? cityName(team.address.city, l) || team.name : '';
const name = `${a.first_name} ${a.last_name}`;
const role = a.title ?? (team ? t('adviserAt', { city }) : undefined);
const langs = langNames(a.languages, l);
---
<Site l={l} route="team" segs={[agentSlug(a, agents)]} title={`${name}${role ? `, ${role}` : ''} | ${org.name}`}
  description={[name, role, langs].filter(Boolean).join(' · ')} image={a.photo?.url && img(a.photo.url, { w: 1200, h: 630 })}>
  <section class="hero">
    <div class="wrap hero__in">
      {a.photo?.url && <div class="hero__photo"><Portrait agent={a} w={560} sizes="(min-width: 900px) 360px, 60vw" priority /></div>}
      <div class="hero__text">
        <Crumbs label={t('breadcrumb')} items={[{ label: t('home'), href: href('home', l) }, { label: t('navTeam'), href: href('team', l) }, { label: name }]} />
        <h1 class="h1">{name}</h1>
        {role && <p class="role">{team ? <a href={href('offices', l, teamSlug(team, teams))}>{role}</a> : role}</p>}
        <dl class="facts">
          {langs && <div><dt>{t('languages')}</dt><dd>{langs}</dd></div>}
          {a.phone && <div><dt>{t('phone')}</dt><dd><a class="num" href={tel(a.phone)}>{a.phone}</a></dd></div>}
          {a.email && <div><dt>{t('email')}</dt><dd><a href={`mailto:${a.email}`}>{a.email}</a></dd></div>}
        </dl>
        {a.bio && <p class="bio">{a.bio}</p>}
      </div>
    </div>
  </section>

  <div class="wrap section cols">
    <section aria-labelledby="h-listings">
      <h2 id="h-listings" class="h3 sec-h">{t('agentListings', { name: a.first_name })}</h2>
      {live.length > 0
        ? <ul class="plain-list grid2">{live.map((x, i) => <li><ListingCard listing={x} l={l} priority={!a.photo?.url && i === 0} /></li>)}</ul>
        : <p class="muted">{t('noAgentListings', { name: a.first_name })}</p>}
      {sold.length > 0 && (
        <>
          <h2 class="h3 sec-h sold-h">{t('recentSales')}</h2>
          <ul class="plain-list grid2">{sold.map((x) => <li><ListingCard listing={x} l={l} /></li>)}</ul>
        </>
      )}
    </section>
    <aside class="side" aria-labelledby="h-write">
      <h2 id="h-write" class="h3">{t('contactAgent', { name: a.first_name })}</h2>
      <EnquiryForm locale={LOCALE[l]} agentId={a.id} agentName={a.first_name} contactReason="other" message={t('agentMessage', { name: a.first_name })} />
    </aside>
  </div>
</Site>

<style>
  .hero { background: var(--paper); padding-block: clamp(28px, 4vw, 56px); }
  .hero__in { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: end; }
  .hero__in:not(:has(.hero__photo)) { grid-template-columns: minmax(0, 1fr); }
  .hero__photo { aspect-ratio: 4 / 5; overflow: hidden; background: var(--paper-2); }
  .hero__photo :global(img) { width: 100%; height: 100%; }
  .hero__text { display: grid; gap: 14px; }
  .hero__text h1 { color: var(--green-ink); }
  .role { font-size: var(--step-1); color: var(--muted); }
  .role a { color: inherit; }
  .facts { display: grid; border-top: 1px solid var(--line-strong); margin-top: 8px; max-width: 560px; }
  .facts div { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .facts dt { color: var(--muted); }
  .facts a { color: var(--green); overflow-wrap: anywhere; }
  .bio { max-width: 62ch; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: clamp(40px, 5vw, 80px); align-items: start; }
  .sec-h { color: var(--green-ink); margin-bottom: 24px; }
  .sold-h { margin-top: 48px; }
  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 24px; }
  .side { background: var(--paper); padding: 28px; display: grid; gap: 18px; position: sticky; top: calc(var(--header-h) + 20px); }
  .side h2 { color: var(--green-ink); }
  @media (max-width: 1000px) { .cols { grid-template-columns: minmax(0, 1fr); } .side { position: static; } }
  @media (max-width: 700px) {
    .hero__in { grid-template-columns: minmax(0, 1fr); }
    .hero__photo { max-width: 260px; }
    .grid2 { grid-template-columns: minmax(0, 1fr); }
    .side { margin-inline: calc(-1 * var(--gutter)); padding: 22px 18px; }
  }
</style>
