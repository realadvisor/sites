---
/** One office: photo, address, contacts, map, the team, its listings and a form to write to the office. */
import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';
import EnquiryForm from '@realadvisor/sites-kit/components/EnquiryForm.astro';
import { img } from '@realadvisor/sites-kit/image';
import type { Team } from '@realadvisor/sites-sdk/types';
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import AgentCard from '../components/AgentCard.astro';
import ListingCard from '../components/ListingCard.astro';
import StaticMap from '../components/StaticMap.astro';
import { siteData, sites } from '../lib/data';
import { placeOf } from '../content/places';
import { href, LOCALE, teamSlug, type L } from '../lib/routes';
import { cityName, tx } from '../lib/copy';
import { tel } from '../lib/format';

interface Props { l: L; team: Team }
const { l, team: x } = Astro.props;
const t = tx(l);
const [{ org, teams, agents }, listings] = await Promise.all([siteData(), sites.allListings({ team_id: x.id, status: 'available' })]);
const slug = teamSlug(x, teams);
const city = cityName(x.address.city, l) || x.name;
const place = placeOf(slug);
const crew = agents.filter((a) => a.team_ids.includes(x.id));
const addr = [x.address.street, [x.address.postcode, cityName(x.address.city, l)].filter(Boolean).join(' ')].filter(Boolean).join(', ');
---
<Site l={l} route="offices" segs={[slug]} title={`${t('officeOf', { city })} | ${org.name}`} description={[t('officeOf', { city }), addr, x.phone].filter(Boolean).join(' · ')}
  image={place && img(place.photo, { w: 1200, h: 630 })}>
  <section class="hero on-green">
    <div class="hero__grid">
      <div class="hero__text wrap-l">
        <Crumbs label={t('breadcrumb')} items={[{ label: t('home'), href: href('home', l) }, { label: t('navOffices'), href: href('offices', l) }, { label: city }]} />
        <h1 class="h1">{t('officeOf', { city })}</h1>
        {x.description_text && <p class="lede">{x.description_text}</p>}
        <address>{addr}</address>
        <ul class="plain-list links">
          {x.phone && <li><a class="num" href={tel(x.phone)}>{x.phone}</a></li>}
          {x.email && <li><a href={`mailto:${x.email}`}>{x.email}</a></li>}
        </ul>
      </div>
      {place && <div class="hero__media"><RaImage src={place.photo} alt={place.alt[l]} width={1200} height={900} priority sizes="(min-width: 1000px) 50vw, 100vw" mobile={{ width: 800, height: 560 }} /></div>}
    </div>
  </section>

  {crew.length > 0 && (
    <section class="section wrap" aria-labelledby="h-team">
      <h2 id="h-team" class="h2 sec-h">{t('team')}</h2>
      <ul class="plain-list cards">{crew.map((a) => <li><AgentCard agent={a} agents={agents} teams={teams} l={l} /></li>)}</ul>
    </section>
  )}

  {listings.length > 0 && (
    <section class="section section--paper" aria-labelledby="h-list">
      <div class="wrap">
        <h2 id="h-list" class="h2 sec-h">{t('officeListings', { city })}</h2>
        <ul class="plain-list grid3">{listings.slice(0, 6).map((y) => <li><ListingCard listing={y} l={l} /></li>)}</ul>
        {listings.length > 6 && <p class="all"><a class="more" href={`${href('buy', l)}?city=${encodeURIComponent(x.address.city ?? '')}`}>{t('allBuyN', { n: listings.filter((y) => y.offer_type === 'buy').length })}</a></p>}
      </div>
    </section>
  )}

  <section class="section wrap cols" aria-labelledby="h-write">
    <div class="form">
      <h2 id="h-write" class="h3">{t('officeContact', { city })}</h2>
      <EnquiryForm locale={LOCALE[l]} contactReason="other" message={t('officeMessage', { city })} />
    </div>
    {x.address.lat != null && x.address.lng != null && (
      <StaticMap lat={x.address.lat} lng={x.address.lng} zoom={15} height={460} label={`${t('officeOf', { city })}: ${addr}`} linkLabel={t('directions')} />
    )}
  </section>
</Site>

<style>
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); max-width: 1600px; margin-inline: auto; }
  .hero__text { display: grid; gap: 14px; align-content: center; padding: clamp(28px, 4vw, 56px) clamp(24px, 4vw, 64px) clamp(36px, 5vw, 64px) max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); }
  address { font-style: normal; margin-top: 8px; }
  .links a { display: inline-flex; min-height: 36px; align-items: center; font-weight: 600; }
  .hero__media { min-height: 380px; position: relative; }
  .hero__media :global(picture), .hero__media > :global(img) { position: absolute; inset: 0; }
  .hero__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .sec-h { color: var(--green-ink); margin-bottom: 28px; }
  .cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 28px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 28px; }
  .all { margin-top: 24px; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .form { background: var(--paper); padding: clamp(22px, 3vw, 36px); display: grid; gap: 18px; }
  .form h2 { color: var(--green-ink); }
  @media (max-width: 1000px) {
    .hero__grid, .cols { grid-template-columns: minmax(0, 1fr); }
    .hero__media { order: -1; min-height: 0; aspect-ratio: 10 / 7; }
    .hero__text { padding: 24px var(--gutter) 36px; }
    .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .grid3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 16px; } .grid3 { grid-template-columns: minmax(0, 1fr); } .form { margin-inline: calc(-1 * var(--gutter)); } }
</style>
