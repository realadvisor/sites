---
/**
 * Home: green hero with the search panel over the newest listing's photo;
 * newest listings; the three regions as full-width photo tiles; the
 * development as one large card with its prices and availability; the
 * valuation band; the affordability calculator. Every figure comes from
 * the data; a section without data is left out.
 */
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import { img } from '@realadvisor/sites-kit-core/image';
import { agencyJsonLd } from '@realadvisor/sites-kit-core/seo';
import Site from '../layouts/Site.astro';
import SearchPanel from '../components/SearchPanel.astro';
import ListingCard from '../components/ListingCard.astro';
import Affordability from '../components/Affordability.astro';
import { siteData, sites } from '../lib/data';
import { regionsOf } from '../lib/regions';
import { groupLine, groups } from '../lib/dev';
import { placeOf } from '../content/places';
import { href, listingHref, type L } from '../lib/routes';
import { cityName, joinList, tx } from '../lib/copy';
import { monthYear, price } from '../lib/format';

interface Props { l: L }
const { l } = Astro.props;
const t = tx(l);
const [{ org, teams, primary }, all, devs] = await Promise.all([siteData(), sites.allListings(), sites.developments()]);
const available = all.filter((x) => x.status === 'available');
const buy = available.filter((x) => x.offer_type === 'buy');
const rent = available.filter((x) => x.offer_type === 'rent');
const hero = buy.find((x) => x.photos[0]) ?? available.find((x) => x.photos[0]);
const fresh = buy.filter((x) => x.id !== hero?.id).slice(0, 4);
const regions = regionsOf(teams, all).filter((r) => r.available.length > 0);
const cities = joinList(teams.map((x) => cityName(x.address.city, l)).filter(Boolean), l);
const dev = devs[0] ? await sites.development(devs[0].slug) : null;
const devGroups = dev ? groups(dev.units, l) : [];
const buyPrices = buy.map((x) => x.price ?? 0).filter((n) => n > 0).sort((a, b) => a - b);
const median = buyPrices.length ? buyPrices[Math.floor(buyPrices.length / 2)]! : 0;
const calcPrice = Math.round(median / 50_000) * 50_000;
const base = (Astro.site ?? Astro.url).href;
const agency = { id: org.id, name: org.name, phone: primary?.phone, email: primary?.email, address: org.address, website: org.website };
---
<Site l={l} route="home"
  title={`${org.name} | ${t('homeTitle', { cities })}`}
  description={t('homeLede', { cities })}
  image={hero && img(hero.photos[0]!.url, { w: 1200, h: 630 })}
  jsonLd={agencyJsonLd(agency, base)}>

  <section class="hero on-green">
    <div class="hero__grid">
      <div class="hero__panel">
        <h1 class="hero__title">{t('homeTitle', { cities })}</h1>
        <p class="hero__lede">{t('homeLede', { cities })}</p>
        <SearchPanel l={l} buy={buy} rent={rent} />
      </div>
      {hero && (
        <figure class="hero__media" data-hero>
          <RaImage src={hero.photos[0]} alt={hero.photos[0]!.alt || hero.title} width={1600} height={1100} priority
            sizes="(min-width: 1440px) 860px, (min-width: 1000px) 60vw, 100vw" mobile={{ width: 800, height: 600 }} />
          <figcaption><a href={listingHref(hero, l)}><span>{t('heroPhoto')}</span> {hero.title} · <span class="num">{price(hero, l)}</span></a></figcaption>
        </figure>
      )}
    </div>
  </section>

  {fresh.length > 0 && (
    <section class="section wrap" aria-labelledby="h-new">
      <div class="head">
        <h2 id="h-new" class="h2">{t('newTitle')}</h2>
        <a class="more" href={href('buy', l)}>{t('allBuyN', { n: buy.length })}</a>
      </div>
      <ul class="plain-list row4">{fresh.map((x) => <li><ListingCard listing={x} l={l} sizes="(min-width: 1320px) 300px, (min-width: 1000px) 23vw, (min-width: 640px) 46vw, calc(100vw - 32px)" /></li>)}</ul>
      {rent.length > 0 && <p class="rentline"><a class="more" href={href('rent', l)}>{t('allRentN', { n: rent.length })}</a></p>}
    </section>
  )}

  {regions.length > 0 && (
    <section class="regions" aria-labelledby="h-regions">
      <h2 id="h-regions" class="sr-only">{t('regionsTitleN')}</h2>
      <ul class="plain-list regions__row">
        {regions.map((r) => {
          const city = cityName(r.team.address.city, l) || r.team.name;
          const place = placeOf(r.slug);
          const nb = r.available.filter((x) => x.offer_type === 'buy').length;
          const nr = r.available.filter((x) => x.offer_type === 'rent').length;
          return (
            <li>
              <a class="region" href={href('areas', l, r.slug)}>
                {place && <RaImage src={place.photo} alt={place.alt[l]} width={900} height={1100} sizes="(min-width: 900px) 33vw, 100vw" mobile={{ width: 800, height: 560 }} />}
                <span class="region__text">
                  <span class="region__name">{t('regionOf', { city })}</span>
                  <span class="region__meta">{r.towns.map((x) => cityName(x.city, l)).join(' · ')}</span>
                  <span class="region__count num">{nr ? t('regionCounts', { buy: nb, rent: nr }) : t('regionCountsBuy', { buy: nb })}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {dev && (
    <section class="section wrap" aria-labelledby="h-dev">
      <article class="dev">
        <a class="dev__media" href={href('developments', l, dev.slug)} tabindex="-1" aria-hidden="true">
          {dev.photos[0] && <RaImage src={dev.photos[0]} alt="" width={1200} height={900} sizes="(min-width: 1000px) 56vw, 100vw" />}
        </a>
        <div class="dev__body">
          <p class="kicker">{t('devBandTitle', { city: cityName(dev.address.city, l) })}</p>
          <h2 id="h-dev" class="h2 dev__title"><a href={href('developments', l, dev.slug)}>{dev.title}</a></h2>
          <p class="dev__line">{t('devBandLine', { units: dev.stats.units, available: dev.stats.available, delivery: monthYear(dev.delivery_date, l) })}</p>
          <p class="dev__k">{t('priceAvail')}</p>
          <ul class="plain-list pa">
            {devGroups.map((g) => {
              const x = groupLine(g, l);
              return <li><span class="pa__type">{g.label}</span><span class="pa__right"><span class="pa__price num">{x.price}</span><span class="pa__status">{x.status}</span></span></li>;
            })}
          </ul>
          <a class="button" href={href('developments', l, dev.slug)}>{t('toDevelopment')}</a>
        </div>
      </article>
    </section>
  )}

  <section class="valuation on-green" aria-labelledby="h-val">
    <div class="wrap valuation__in">
      <h2 id="h-val" class="h2">{t('valuationTitle')}</h2>
      <p class="valuation__text">{t('valuationText')}</p>
      <div class="valuation__actions">
        <a class="button button--light" href={href('sell', l)}>{t('valuationCta')}</a>
        <a class="more" href={href('sold', l)}>{t('navSold')}</a>
      </div>
    </div>
  </section>

  {calcPrice > 0 && (
    <div class="section wrap">
      <Affordability l={l} price={calcPrice} id="home-calc" />
    </div>
  )}
</Site>

<style>
  .hero { overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); max-width: 1600px; margin-inline: auto; min-height: min(680px, calc(100vh - var(--header-h))); }
  .hero__panel { position: relative; z-index: 1; align-self: stretch; align-content: center; display: grid; gap: 18px; padding: clamp(40px, 5vw, 72px) clamp(28px, 4vw, 56px) clamp(40px, 5vw, 72px) max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); margin-right: -96px; background: var(--green-deep); box-shadow: inset 4px 0 0 var(--mint); }
  .hero__title { font-size: clamp(2rem, 1.4rem + 2.2vw, 3.25rem); line-height: 1.08; }
  .hero__lede { color: var(--on-green-muted); font-size: var(--step-1); max-width: 44ch; margin-bottom: 8px; }
  .hero__media { position: relative; margin: 0; min-height: 420px; }
  .hero__media :global(picture), .hero__media > :global(img) { position: absolute; inset: 0; }
  .hero__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__media figcaption { position: absolute; right: 0; bottom: 0; max-width: min(520px, 90%); }
  .hero__media figcaption a { display: block; padding: 14px 20px; background: rgb(16 43 32 / 0.88); color: #fff; text-decoration: none; font-size: 0.9375rem; }
  .hero__media figcaption a:hover { text-decoration: underline; }
  .hero__media figcaption span:first-child { color: var(--mint); font-weight: 600; margin-right: 6px; }

  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 8px 24px; margin-bottom: 32px; }
  .head .h2 { color: var(--green-ink); }
  .row4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .rentline { margin-top: 20px; }

  .regions__row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; background: #fff; }
  .region { position: relative; display: block; aspect-ratio: 9 / 11; max-height: 620px; width: 100%; overflow: hidden; color: #fff; text-decoration: none; background: var(--green-ink); }
  .region :global(picture), .region > :global(img) { position: absolute; inset: 0; }
  .region :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .region:hover :global(img) { transform: scale(1.03); }
  .region__text { position: absolute; left: 0; right: 0; bottom: 0; display: grid; gap: 6px; padding: 80px clamp(20px, 2.5vw, 36px) clamp(20px, 2.5vw, 32px); background: linear-gradient(to top, rgb(12 30 22 / 0.92) 0%, rgb(12 30 22 / 0.72) 55%, rgb(12 30 22 / 0) 100%); }
  .region__name { font: 400 clamp(1.625rem, 1.3rem + 1.1vw, 2.25rem)/1.1 var(--font-display); }
  .region:hover .region__name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .region__meta { color: #e4ece7; }
  .region__count { font-weight: 600; }

  .dev { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); background: var(--paper); }
  .dev__media { display: block; min-height: 100%; background: var(--paper-2); }
  .dev__media :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .dev__body { display: grid; gap: 14px; align-content: center; padding: clamp(28px, 4vw, 56px); }
  .dev__title { color: var(--green-ink); }
  .dev__title a { text-decoration: none; }
  .dev__title a:hover { text-decoration: underline; }
  .dev__line { color: var(--muted); }
  .dev__k { font-weight: 600; margin-top: 8px; }
  .pa { display: grid; border-top: 1px solid var(--line-strong); margin-bottom: 12px; }
  .pa li { display: flex; justify-content: space-between; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .pa__right { display: grid; justify-items: end; text-align: right; }
  .pa__type { font-weight: 600; }
  .pa__price { white-space: nowrap; }
  .pa__price { font-weight: 600; }
  .pa__status { color: var(--muted); font-size: 0.875rem; }
  .dev .button { justify-self: start; }

  .valuation { padding-block: clamp(56px, 6vw, 88px); }
  .valuation__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px 64px; align-items: center; }
  .valuation__text { color: var(--on-green-muted); font-size: var(--step-1); line-height: 1.55; }
  .valuation__actions { grid-column: 2; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; }

  @media (max-width: 1100px) { .row4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 1000px) {
    .hero__grid { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .hero__media { order: -1; min-height: 0; aspect-ratio: 4 / 3; }
    .hero__panel { margin-right: 0; padding: 28px var(--gutter) 36px; box-shadow: none; }
    .hero__media figcaption { max-width: 100%; left: 0; }
    .hero__media figcaption a { padding: 10px var(--gutter); font-size: 0.875rem; }
    .dev { grid-template-columns: minmax(0, 1fr); }
    .valuation__in { grid-template-columns: minmax(0, 1fr); }
    .valuation__actions { grid-column: auto; }
  }
  @media (max-width: 900px) {
    .regions__row { grid-template-columns: minmax(0, 1fr); }
    .region { aspect-ratio: 10 / 7; }
  }
  @media (max-width: 640px) {
    .row4 { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 82%; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); scrollbar-width: none; }
    .row4 > li { scroll-snap-align: start; }
  }
</style>
