---
/**
 * Agent portrait through the image helper (4:5 or square crop). Renders
 * nothing when the agent has no photo: the name, role and contacts carry
 * the card then. No initials fallback.
 */
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import type { Agent } from '@realadvisor/sites-sdk/types';

interface Props { agent: Pick<Agent, 'first_name' | 'last_name' | 'photo'>; w: number; ratio?: 'portrait' | 'square'; sizes: string; class?: string; priority?: boolean }
const { agent, w, ratio = 'portrait', sizes, class: cls, priority } = Astro.props;
const h = ratio === 'square' ? w : Math.round((w * 5) / 4);
---
{agent.photo?.url && (
  <RaImage class:list={['portrait', cls]} src={agent.photo} alt={agent.photo.alt || `${agent.first_name} ${agent.last_name}`} width={w} height={h} sizes={sizes} priority={priority}
    widths={[w, w * 2].filter((x) => x <= 1200)} />
)}

<style>
  .portrait { object-fit: cover; background: var(--paper-2); }
</style>
