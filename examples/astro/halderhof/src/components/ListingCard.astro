---
/**
 * Listing card: 3:2 photo with at most one badge (sold or to rent), type and
 * town in a muted line, serif title, facts, price. Sold listings show no
 * price. Used in the kit ListingsSearch slot and every grid.
 */
import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';
import type { Listing } from '@realadvisor/sites-sdk/types';
import { listingHref, type L } from '../lib/routes';
import { cityName, tx } from '../lib/copy';
import { formatSurface, price, rooms, typeLabel } from '../lib/format';

interface Props {
  listing: Listing;
  l: L;
  priority?: boolean;
  sizes?: string;
  as?: 'h2' | 'h3';
}
const { listing: x, l, priority = false, sizes = '(min-width: 1320px) 400px, (min-width: 1024px) 30vw, (min-width: 640px) 46vw, calc(100vw - 32px)', as: H = 'h3' } = Astro.props;
const t = tx(l);
const photo = x.photos[0];
const badge = x.status === 'sold' ? t('sold') : x.offer_type === 'rent' ? t('forRent') : undefined;
const facts = [rooms(x.rooms, l), x.living_surface ? formatSurface(x.living_surface) : ''].filter(Boolean);
const place = cityName(x.address.city, l);
---
<article class:list={['card', { 'card--sold': x.status === 'sold' }]} data-listing-id={x.id}>
  <a class="card__link" href={listingHref(x, l)}>
    <div class="card__media">
      {photo
        ? <RaImage src={photo} alt={photo.alt || x.title} width={900} height={600} sizes={sizes} priority={priority} widths={priority ? [480, 800, 1000] : undefined} />
        : <span class="card__nophoto">{typeLabel(x.property_type, l)}</span>}
      {badge && <span class="card__badge">{badge}</span>}
    </div>
    <div class="card__body">
      <p class="card__meta">{typeLabel(x.property_type, l)}{place && <> · {place}</>}</p>
      <H class="card__title">{x.title}</H>
      {facts.length > 0 && <p class="card__facts num">{facts.map((f) => <span>{f}</span>)}</p>}
      {x.status !== 'sold' && <p class="card__price num">{price(x, l)}</p>}
    </div>
  </a>
</article>

<style>
  .card { height: 100%; }
  .card__link { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  .card__media { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--paper-2); }
  .card__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .card__link:hover .card__media :global(img) { transform: scale(1.025); }
  .card__nophoto { position: absolute; inset: 0; display: grid; place-items: center; color: var(--muted); font: 400 1.0625rem var(--font-display); }
  .card__badge { position: absolute; left: 12px; top: 12px; padding: 6px 10px; background: #fff; color: var(--green); font: 600 0.8125rem/1 var(--font-sans); }
  .card__body { display: grid; gap: 6px; padding-top: 16px; }
  .card__meta { font-size: 0.875rem; color: var(--muted); }
  .card__title { font-size: 1.3125rem; line-height: 1.22; color: var(--green-ink); }
  .card__link:hover .card__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .card__facts { display: flex; flex-wrap: wrap; color: var(--muted); font-size: 0.9375rem; }
  .card__facts span + span::before { content: '·'; margin: 0 8px; }
  .card__price { font-weight: 600; font-size: 1.0625rem; color: var(--text); white-space: nowrap; margin-top: 4px; }
</style>
