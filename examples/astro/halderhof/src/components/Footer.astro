---
/**
 * Dark green footer: one column per office (address, phone, email), the site
 * map, then the legal line with the kit's legal paths and labels in the page
 * language and the language switch.
 */
import type { Organisation, Team } from '@realadvisor/sites-sdk/types';
import { lang, legalPath, privacyPath, t as kt } from '@realadvisor/sites-kit-core/i18n';
import Wordmark from './Wordmark.astro';
import { href, LANGS, LOCALE, teamSlug, type L } from '../lib/routes';
import { cityName, tx } from '../lib/copy';
import { tel } from '../lib/format';

interface Props {
  l: L;
  org: Organisation;
  teams: Team[];
  switchTo: Record<L, string>;
  hasDevelopments: boolean;
}
const { l, org, teams, switchTo, hasDevelopments } = Astro.props;
const t = tx(l);
const locale = LOCALE[l];
const explore = [
  { h: href('buy', l), label: t('navBuy') },
  { h: href('rent', l), label: t('navRent') },
  ...(hasDevelopments ? [{ h: href('developments', l), label: t('navNew') }] : []),
  { h: href('sold', l), label: t('navSold') },
  { h: href('areas', l), label: t('navAreas') },
];
const company = [
  { h: href('sell', l), label: t('valuationCta') },
  { h: href('offices', l), label: t('navOffices') },
  { h: href('team', l), label: t('navTeam') },
  { h: href('about', l), label: t('navAbout') },
  { h: href('contact', l), label: t('navContact') },
];
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="wrap">
    <div class="ft__top">
      <Wordmark org={org} href={href('home', l)} label={org.name} />
      <div class="ft__offices">
        {teams.map((x) => (
          <address>
            <p class="ft__h"><a href={href('offices', l, teamSlug(x, teams))}>{cityName(x.address.city, l) || x.name}</a></p>
            {x.address.street && <span>{x.address.street}</span>}
            {(x.address.postcode || x.address.city) && <span>{[x.address.postcode, cityName(x.address.city, l)].filter(Boolean).join(' ')}</span>}
            {x.phone && <a class="num" href={tel(x.phone)}>{x.phone}</a>}
            {x.email && <a href={`mailto:${x.email}`}>{x.email}</a>}
          </address>
        ))}
      </div>
    </div>
    <div class="ft__links">
      <nav aria-label={t('explore')}>
        <p class="ft__h">{t('explore')}</p>
        <ul>{explore.map((x) => <li><a href={x.h}>{x.label}</a></li>)}</ul>
      </nav>
      <nav aria-label={t('company')}>
        <p class="ft__h">{t('company')}</p>
        <ul>{company.map((x) => <li><a href={x.h}>{x.label}</a></li>)}</ul>
      </nav>
    </div>
    <div class="ft__legal">
      <p>© {year} {org.name}</p>
      <ul>
        <li><a href={legalPath(locale)}>{kt('legalNotice', {}, lang(locale))}</a></li>
        <li><a href={privacyPath(locale)}>{kt('privacyPolicy', {}, lang(locale))}</a></li>
      </ul>
      <ul class="ft__langs" aria-label={t('language')}>
        {LANGS.map((x) => <li><a href={switchTo[x]} hreflang={x} lang={x} aria-current={x === l ? 'true' : undefined}>{x.toUpperCase()}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .ft { background: var(--green-ink); color: var(--on-green-muted); font-size: 0.9375rem; padding-top: clamp(48px, 6vw, 80px); }
  .ft a { color: #fff; text-decoration: none; }
  .ft a:hover { text-decoration: underline; }
  .ft :global(.wm) { color: #fff; align-self: start; }
  .ft__top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: 40px; padding-bottom: 40px; border-bottom: 1px solid var(--line-on-green); }
  .ft__offices { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 28px; }
  .ft address { font-style: normal; display: grid; gap: 2px; align-content: start; }
  .ft address a { min-height: 30px; display: inline-flex; align-items: center; overflow-wrap: anywhere; }
  .ft__h { font: 600 0.9375rem/1.3 var(--font-sans); color: #fff; margin-bottom: 6px; }
  .ft__h a { min-height: 0 !important; }
  .ft__links { display: grid; grid-template-columns: repeat(2, minmax(0, 220px)); gap: 32px; padding-block: 36px; border-bottom: 1px solid var(--line-on-green); }
  .ft__links ul { list-style: none; display: grid; }
  .ft__links li a { display: inline-flex; min-height: 34px; align-items: center; }
  .ft__legal { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; padding-block: 20px 28px; font-size: 0.875rem; }
  .ft__legal ul { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .ft__legal a { min-height: 36px; display: inline-flex; align-items: center; }
  .ft__langs { margin-left: auto; }
  .ft__langs a { color: var(--on-green-muted); font-weight: 600; letter-spacing: 0.06em; }
  .ft__langs a[aria-current] { color: #fff; }
  @media (max-width: 860px) {
    .ft__top { grid-template-columns: minmax(0, 1fr); }
    .ft__langs { margin-left: 0; }
  }
</style>
