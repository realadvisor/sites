---
/**
 * Document shell: <head> SEO tags only. No design here on purpose.
 * Build the header, footer and visual system yourself (see DESIGN.md).
 */
import { LOCALE } from '@realadvisor/sites-kit/format';
import { analyticsId } from '@realadvisor/sites-kit/env';
import { ra } from '@realadvisor/sites-kit/ra';
import { img } from '@realadvisor/sites-kit/image';
import { canonicalUrl, safeJsonLd } from '@realadvisor/sites-kit/seo';
import ConsentBanner from '@realadvisor/sites-kit/components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  /** Absolute URL, ~1200x630: the page's main photo. Default: the agency logo, else the latest listing's first photo. */
  image?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /**
   * Multi-language sites only: every language version of this page, including
   * this one, e.g. [{ lang: 'fr-CH', href: '/fr/biens' }, { lang: 'de-CH', href: '/de/objekte' }].
   * Adds hreflang links (and x-default = the first entry).
   */
  alternates?: { lang: string; href: string }[];
  /** Page language when it differs from LOCALE (multi-language sites). */
  locale?: string;
}
const { title, description, jsonLd, noindex, alternates, locale = LOCALE } = Astro.props;
// og:image on every page (check:quality fails without it); falls back to the
// agency logo, then (an agency without a logo) the latest listing's first photo.
const ogFallback = async () => {
  const a = await ra.agency();
  if (a.logo?.url) return img(a.logo.url, { w: 1200, h: 630, fit: 'fit' });
  const photo = (await ra.listings({ limit: 1 })).data[0]?.photos[0]?.url;
  return photo ? img(photo, { w: 1200, h: 630 }) : undefined;
};
const image = Astro.props.image || (await ogFallback().catch(() => undefined));
const base = Astro.site ?? Astro.url;
const canonical = canonicalUrl(Astro.url, base);
const gaId = analyticsId();
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates?.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, base).href} />)}
    {alternates?.[0] && <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, base).href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Guard: nothing may undo `hidden` (an invisible open menu layer blocks every click). Never remove. */}
    <style is:inline>[hidden]{display:none!important}</style>
    {jsonLd && <script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
    {gaId && <ConsentBanner analyticsId={gaId} locale={locale} />}
  </body>
</html>
