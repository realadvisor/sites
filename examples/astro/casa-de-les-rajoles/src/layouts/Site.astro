---
/**
 * Site shell: fonts, tokens, skip link, header, footer and the phone tab bar.
 * Every page renders through it (Base writes the <head> SEO tags).
 */
import '@fontsource/libre-caslon-text/latin-400.css';
import '@fontsource-variable/instrument-sans/wght.css';
import serif400 from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';
import sans from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TabBar from '../components/TabBar.astro';
import type { Site as SiteData } from '../lib/data';
import { LOCALE_OF, tr, type Lang, type Route } from '../lib/i18n';

interface Props {
  site: SiteData;
  lang: Lang;
  /** The page's route, for the current nav item. */
  route?: Route;
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Every language version of this page. */
  alternates: { lang: string; href: string }[];
  /** Targets of the language switch, when they differ from `alternates` (legal pages: the other language's home, check:deploy rule). */
  langLinks?: { lang: string; href: string }[];
}
const { site, lang, route, title, description, image, jsonLd, noindex, alternates, langLinks = alternates } = Astro.props;
const t = tr(lang);
---
<Base title={title} description={description} image={image} jsonLd={jsonLd} noindex={noindex} alternates={alternates} locale={LOCALE_OF[lang]}>
  <link slot="head" rel="preload" as="font" type="font/woff2" crossorigin href={serif400} />
  <link slot="head" rel="preload" as="font" type="font/woff2" crossorigin href={sans} />
  <meta slot="head" name="theme-color" content="#f7f2e9" />
  <a class="skip" href="#main">{t.skip}</a>
  <Header site={site} lang={lang} route={route} alternates={langLinks} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer site={site} lang={lang} alternates={langLinks} />
  <TabBar lang={lang} route={route} />
</Base>

<style>
  main { display: block; outline: none; }
  .skip { position: absolute; left: 12px; top: -60px; z-index: 100; background: var(--ink); color: var(--paper); padding: 12px 16px; text-decoration: none; font-weight: 600; }
  .skip:focus { top: 12px; color: var(--paper); }
</style>
