---
// Privacy policy in the other languages (/en/privacy). Any other prefix: 404.
export const prerender = false;
import LegalPage from '../../components/LegalPage.astro';
import { privacyPolicy } from '@realadvisor/sites-kit/legal';
import { lang as kitLang, t } from '@realadvisor/sites-kit/i18n';
import { analyticsId } from '@realadvisor/sites-kit/env';
import { legalAgency, loadSite } from '../../lib/data';
import { LANGS, LOCALE_OF, type Lang } from '../../lib/i18n';

const lang = LANGS.slice(1).find((l) => l === Astro.params.lang) as Lang | undefined;
if (!lang) return Astro.rewrite('/404');
const site = await loadSite();
const l = kitLang(LOCALE_OF[lang]);
---
<LegalPage site={site} lang={lang} route="privacy" title={t('privacyPolicy', {}, l)} sections={privacyPolicy(legalAgency(site), { analytics: !!analyticsId() }, l)} />
