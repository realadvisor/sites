---
// Legal notice in the other languages (/en/legal). Any other prefix: 404.
export const prerender = false;
import LegalPage from '../../components/LegalPage.astro';
import { legalNotice } from '@realadvisor/sites-kit-core/legal';
import { lang as kitLang, t } from '@realadvisor/sites-kit-core/i18n';
import { legalAgency, loadSite } from '../../lib/data';
import { LANGS, LOCALE_OF, type Lang } from '../../lib/i18n';

const lang = LANGS.slice(1).find((l) => l === Astro.params.lang) as Lang | undefined;
if (!lang) return Astro.rewrite('/404');
const site = await loadSite();
const l = kitLang(LOCALE_OF[lang]);
---
<LegalPage site={site} lang={lang} route="legal" title={t('legalNotice', {}, l)} sections={legalNotice(legalAgency(site), l)} />
