---
/** Phones only: a bottom tab bar for the three things buyers come for. */
import { href, tr, type Lang, type Route } from '../lib/i18n';
import Icon from './Icon.astro';

interface Props { lang: Lang; route?: Route }
const { lang, route } = Astro.props;
const t = tr(lang);
const TABS = [
  { r: 'units', icon: 'units', label: t.tabs.units },
  { r: 'plans', icon: 'plan', label: t.tabs.plans },
  { r: 'contact', icon: 'contact', label: t.tabs.contact },
] as const;
---
<nav class="tabbar" aria-label={t.tabNav}>
  {TABS.map((x) => (
    <a href={href(x.r, lang)} aria-current={route === x.r ? 'page' : undefined}>
      <Icon name={x.icon} size={22} />
      <span>{x.label}</span>
    </a>
  ))}
</nav>

<style>
  .tabbar { display: none; }
  @media (max-width: 860px) {
    .tabbar {
      position: fixed; inset: auto 0 0 0; z-index: 40; display: grid; grid-template-columns: repeat(3, 1fr);
      background: var(--ink); padding-bottom: env(safe-area-inset-bottom);
    }
    .tabbar a { display: grid; justify-items: center; gap: 4px; padding: 9px 4px 10px; min-height: 60px; color: #e9e1d5; text-decoration: none; font: 600 0.75rem/1 var(--sans); letter-spacing: 0.02em; }
    .tabbar a[aria-current] { color: #fff; box-shadow: inset 0 3px 0 var(--accent); }
    .tabbar a:focus-visible { outline-color: #fff; outline-offset: -4px; }
    :global(body) { padding-bottom: calc(60px + env(safe-area-inset-bottom)); }
  }
</style>
