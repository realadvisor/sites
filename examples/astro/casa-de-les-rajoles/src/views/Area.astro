---
/** The neighbourhood: one aerial, a lead, places with straight-line distances, the map. */
import { img } from '@realadvisor/sites-kit/image';
import Site from '../layouts/Site.astro';
import Photo from '../components/Photo.astro';
import StaticMap from '../components/StaticMap.astro';
import { loadSite } from '../lib/data';
import { alternates, tr, type Lang } from '../lib/i18n';
import { AERIAL, PLACES, km } from '../content/barrio';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
const site = await loadSite();
const { dev } = site;
const here = dev.address.lat != null && dev.address.lng != null ? { lat: dev.address.lat, lng: dev.address.lng } : null;
const places = PLACES.map((p) => ({ ...p, d: here ? km(here, p) : null })).sort((a, b) => (a.d ?? 0) - (b.d ?? 0));
const dist = (d: number) => (d < 1 ? `${Math.round(d * 20) * 50} m` : `${new Intl.NumberFormat(lang === 'es' ? 'es-ES' : 'en-GB', { maximumFractionDigits: 1 }).format(d)} km`);
const near = places.filter((p) => (p.d ?? 99) < 1.6);
---
<Site site={site} lang={lang} route="area" title={`${t.areaH1} | ${dev.title}`} description={t.areaLead} image={img(AERIAL, { w: 1200, h: 630 })} alternates={alternates('area')}>
  <section class="wrap head">
    <h1>{t.areaH1}</h1>
    <p class="lede">{t.areaLead}</p>
  </section>
  <div class="wrap aerial">
    <Photo src={AERIAL} alt={lang === 'es' ? 'Vista aérea del jardín del Turia y la Ciutat de les Arts i les Ciències' : 'Aerial view of the Turia gardens and the City of Arts and Sciences'} width={1600} height={700} priority sizes="(min-width: 1376px) 1280px, 100vw" mobile={{ width: 800, height: 640 }} />
  </div>

  <section class="wrap places" aria-labelledby="d-h">
    <div class="p-head">
      <h2 id="d-h">{t.distTitle}</h2>
      <p class="muted small">{t.distNote}</p>
    </div>
    <ol>
      {places.map((p, i) => (
        <li>
          <p class="row"><span class="i num">{i + 1}</span><b>{p.name[lang]}</b>{p.d != null && <span class="d num">{dist(p.d)}</span>}</p>
          <p class="tx">{p.text[lang]}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="wrap pics" aria-label={lang === 'es' ? 'Fotos del barrio' : 'Photos of the area'}>
    {places.filter((p) => p.photo).map((p, i) => (
      <figure class:list={[`f${i}`]}>
        <Photo src={p.photo!} alt={p.alt?.[lang] ?? p.name[lang]} width={i === 0 ? 900 : 640} height={i === 0 ? 1000 : 480} sizes={i === 0 ? '(min-width: 900px) 40vw, 100vw' : '(min-width: 900px) 30vw, 50vw'} />
        <figcaption>{p.name[lang]}</figcaption>
      </figure>
    ))}
  </section>

  {here && (
    <section class="wrap map" aria-labelledby="m-h">
      <h2 id="m-h">{t.mapTitle}</h2>
      <StaticMap lat={here.lat} lng={here.lng} zoom={15} cols={8} rows={5} lang={lang} label={`${dev.title}, ${dev.address.street}, ${dev.address.postcode} ${dev.address.city}`} marks={near.map((p) => ({ lat: p.lat, lng: p.lng, n: places.indexOf(p) + 1, name: p.name[lang] }))} />
    </section>
  )}
</Site>
<style>
  .head { padding-block: clamp(48px, 6vw, 88px) clamp(28px, 3vw, 40px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 64px; align-items: end; }
  .aerial :global(img) { width: 100%; aspect-ratio: 16 / 7; object-fit: cover; }
  .places, .map { margin-top: var(--space-section); }
  .p-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 28px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(32px, 5vw, 80px); border-top: 1px solid var(--line-strong); }
  li { border-bottom: 1px solid var(--line); padding: 18px 0 16px; }
  .row { display: flex; gap: 12px; align-items: baseline; margin: 0 0 6px !important; }
  .row b { font: 400 1.25rem/1.2 var(--serif); flex: 1; }
  .i { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--ink); color: #fff; font-size: 0.75rem; font-weight: 600; flex: none; transform: translateY(-2px); }
  .d { font-weight: 600; color: var(--accent-strong); }
  .tx { color: var(--muted); font-size: 0.9375rem; margin: 0 0 0 36px !important; max-width: 52ch; }
  .pics { margin-top: var(--space-section); display: grid; grid-template-columns: 1.3fr 1fr 1fr; grid-template-rows: auto auto; gap: clamp(12px, 1.6vw, 24px); }
  .pics figure { margin: 0; }
  .pics :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .pics .f0 { grid-row: 1 / 3; }
  .pics .f0 :global(img) { aspect-ratio: auto; height: calc(100% - 30px); }
  .pics .f0 :global(picture) { height: 100%; }
  figcaption { font-size: 0.875rem; color: var(--muted); margin-top: 8px; }
  .map h2 { margin-bottom: 24px; }
  @media (max-width: 1000px) { .pics { grid-template-columns: 1fr 1fr; } .pics .f0 { grid-row: auto; grid-column: 1 / -1; } .pics .f0 :global(img) { aspect-ratio: 16 / 10; height: auto; } }
  @media (max-width: 700px) { .head { grid-template-columns: 1fr; } ol { grid-template-columns: 1fr; } .tx { margin-left: 0 !important; } .aerial { padding-inline: 0; } }
</style>
