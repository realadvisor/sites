---
/**
 * Gallery: the development's photos in an editorial run of single and paired
 * frames, then the works (fixture only: construction photos). Each photo
 * links to its full-size file; the script turns that into a lightbox with
 * arrows, Escape and a counter.
 */
import { img } from '@realadvisor/sites-kit-core/image';
import Site from '../layouts/Site.astro';
import Photo from '../components/Photo.astro';
import { developmentExtra, loadSite } from '../lib/data';
import { CONTENT_LANG, alternates, fill, tr, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
const site = await loadSite();
const { dev } = site;
const works = developmentExtra(dev).construction_photos ?? []; // fixture only: construction photos
const shots = [
  ...dev.photos.map((p, i) => ({ url: p.url, alt: i === 0 ? (lang === 'es' ? 'Fachada de 1908 de Casa de les Rajoles' : 'The 1908 façade of Casa de les Rajoles') : p.alt, lang: i === 0 ? undefined : CONTENT_LANG })),
];
const workShots = works.map((url, i) => ({ url, alt: lang === 'es' ? `Obras de Casa de les Rajoles, foto ${i + 1}` : `Casa de les Rajoles under construction, photo ${i + 1}`, lang: undefined }));
const all = [...shots, ...workShots];
// Layout rhythm: wide, pair, tall + square, wide, pair...
const SHAPES = ['wide', 'half', 'half', 'tall', 'sq', 'third', 'third', 'third', 'half', 'half'];
const dims: Record<string, [number, number, string]> = {
  wide: [1600, 900, '(min-width: 1376px) 1280px, 100vw'],
  half: [800, 600, '(min-width: 900px) 50vw, 100vw'],
  tall: [800, 1000, '(min-width: 900px) 42vw, 100vw'],
  sq: [900, 1000, '(min-width: 900px) 58vw, 100vw'],
  third: [600, 700, '(min-width: 900px) 33vw, 50vw'],
};
const big = (u: string) => img(u, { w: 1800, fit: 'fit', quality: 75 });
---
<Site site={site} lang={lang} route="gallery" title={`${t.galleryTitle} | ${dev.title}`} description={`${t.galleryLead} ${dev.title}, Russafa, València.`} image={dev.photos[0] && img(dev.photos[0].url, { w: 1200, h: 630 })} alternates={alternates('gallery')}>
  <section class="wrap head">
    <h1>{t.galleryTitle}</h1>
    <p class="lede">{t.galleryLead}</p>
  </section>
  <div class="wrap run" data-gallery>
    {shots.map((p, i) => {
      const s = SHAPES[i % SHAPES.length]!;
      const [w, h, sizes] = dims[s]!;
      return (
        <a class:list={['shot', s]} href={big(p.url)} data-i={i} aria-label={`${t.openPhoto}: ${fill(t.photoOf, { i: i + 1, n: all.length })}`}>
          <Photo src={p.url} alt={p.alt} lang={p.lang} width={w} height={h} sizes={sizes} priority={i === 0} />
        </a>
      );
    })}
  </div>
  {workShots.length > 0 && (
    <section class="wrap works" id="obras" aria-labelledby="o-h">
      <h2 id="o-h">{t.galleryWorks}</h2>
      <div class="w-grid" data-gallery>
        {workShots.map((p, j) => (
          <a class="shot" href={big(p.url)} data-i={shots.length + j} aria-label={`${t.openPhoto}: ${fill(t.photoOf, { i: shots.length + j + 1, n: all.length })}`}>
            <Photo src={p.url} alt={p.alt} width={600} height={720} sizes="(min-width: 900px) 25vw, 50vw" />
          </a>
        ))}
      </div>
    </section>
  )}
  <dialog class="lb" data-lightbox aria-label={t.galleryTitle} data-of={t.photoOf}>
    <img data-lb-img alt="" />
    <p class="count" data-lb-count aria-live="polite"></p>
    <button type="button" class="prev" data-lb-prev>{t.prev}</button>
    <button type="button" class="next" data-lb-next>{t.next}</button>
    <button type="button" class="x" data-lb-close>{t.close}</button>
  </dialog>
  <template data-lb-list>{all.map((p) => <span data-src={big(p.url)} data-alt={p.alt}></span>)}</template>
</Site>
<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const list = [...(document.querySelector<HTMLTemplateElement>('[data-lb-list]')?.content.querySelectorAll<HTMLElement>('span') ?? [])];
  const im = dlg?.querySelector<HTMLImageElement>('[data-lb-img]');
  const count = dlg?.querySelector<HTMLElement>('[data-lb-count]');
  let i = 0;
  const show = (n: number) => {
    if (!im || !list.length) return;
    i = (n + list.length) % list.length;
    im.src = list[i]!.dataset.src!;
    im.alt = list[i]!.dataset.alt ?? '';
    if (count) count.textContent = (dlg?.dataset.of ?? '{i} / {n}').replace('{i}', String(i + 1)).replace('{n}', String(list.length));
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-gallery] a[data-i]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (!dlg || e.metaKey || e.ctrlKey) return;
      e.preventDefault();
      show(Number(a.dataset.i));
      dlg.showModal();
    }),
  );
  dlg?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(i - 1));
  dlg?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(i + 1));
  dlg?.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(i - 1);
    if (e.key === 'ArrowRight') show(i + 1);
  });
</script>
<style>
  .head { padding-block: clamp(48px, 6vw, 88px) clamp(28px, 3vw, 44px); display: grid; gap: 14px; }
  .run { display: grid; grid-template-columns: repeat(6, 1fr); gap: clamp(10px, 1.4vw, 20px); }
  .shot { display: block; overflow: hidden; background: var(--surface); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .shot:hover :global(img) { transform: scale(1.02); }
  .shot :global(picture) { height: 100%; }
  .wide { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
  .half { grid-column: span 3; aspect-ratio: 4 / 3; }
  .tall { grid-column: span 2; aspect-ratio: 4 / 5; }
  .sq { grid-column: span 4; aspect-ratio: 8 / 5; }
  .third { grid-column: span 2; aspect-ratio: 6 / 7; }
  .works { margin-top: var(--space-section); scroll-margin-top: 16px; }
  .works h2 { margin-bottom: 24px; }
  .w-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(10px, 1.4vw, 20px); }
  .w-grid .shot { aspect-ratio: 5 / 6; }
  .lb { border: 0; padding: 0; width: 100vw; height: 100vh; max-width: none; max-height: none; background: #1d1916; color: #fff; }
  .lb::backdrop { background: #1d1916; }
  .lb img { position: absolute; inset: 56px 72px 64px; width: calc(100% - 144px); height: calc(100% - 120px); object-fit: contain; }
  .lb button { position: absolute; min-height: 44px; min-width: 44px; padding: 0 16px; background: rgb(255 255 255 / 0.1); color: #fff; border: 1px solid rgb(255 255 255 / 0.3); font: 600 0.875rem var(--sans); cursor: pointer; }
  .lb .x { top: 8px; right: 8px; }
  .lb .prev { left: 8px; top: 50%; }
  .lb .next { right: 8px; top: 50%; }
  .lb .count { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; font-size: 0.875rem; color: #ddd; }
  .lb button:focus-visible { outline-color: #fff; }
  @media (max-width: 760px) {
    .run { grid-template-columns: 1fr 1fr; }
    .wide, .sq { grid-column: 1 / -1; }
    .half, .tall, .third { grid-column: span 1; }
    .sq { aspect-ratio: 4 / 5; }
    .w-grid { grid-template-columns: 1fr 1fr; }
    .lb img { inset: 56px 8px 110px; width: calc(100% - 16px); height: calc(100% - 166px); }
    .lb .prev, .lb .next { top: auto; bottom: 52px; }
  }
  @media (prefers-reduced-motion: reduce) { .shot :global(img) { transition: none; } }
</style>
