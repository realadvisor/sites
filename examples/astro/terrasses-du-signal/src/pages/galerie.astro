---
// Gallery: the development's photos as an editorial sequence, the
// construction photos (fixture only), and a lightbox that shows each photo
// whole. Without JS every tile links to the large photo.
export const prerender = false;

import Site from '../layouts/Site.astro';
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import { img } from '@realadvisor/sites-kit-core/image';
import ContactBand from '../components/ContactBand.astro';
import BucketPhoto from '../components/BucketPhoto.astro';
import AvifImage from '../components/AvifImage.astro';
import { loadSite } from '../lib/data';
import { CONSTRUCTION } from '../content/construction';

const site = await loadSite();
const { dev } = site;
const photos = dev.photos.map((p, i) => ({ ...p, n: i + 1 }));
// Rows that always fill the width: one wide, a pair, a triple, again. Each
// row has its own height (aspect ratio), its tiles share it, so no gaps at
// any count; a short last row takes the template of its own length.
const PATTERN = [1, 2, 3] as const;
const rows: (typeof photos)[] = [];
for (let i = 0, r = 0; i < photos.length; r++) {
  const n = PATTERN[r % PATTERN.length]!;
  rows.push(photos.slice(i, i + n));
  i += n;
}
const COLS: Record<number, string[]> = { 1: ['1fr'], 2: ['7fr 5fr', '5fr 7fr'], 3: ['1fr 1fr 1fr'] };
// Box per tile (desktop): crop ratio for imgproxy, sizes for the browser.
const box = (n: number, j: number, flip: boolean) =>
  n === 1 ? { w: 1600, h: 800, sizes: '(min-width: 1400px) 1320px, 100vw' }
  : n === 2 ? ((j === 0) !== flip ? { w: 1100, h: 900, sizes: '(min-width: 760px) 55vw, 50vw' } : { w: 800, h: 900, sizes: '(min-width: 760px) 40vw, 50vw' })
  : { w: 800, h: 980, sizes: '(min-width: 760px) 31vw, 50vw' };
const large = (url: string) => img(url, { w: 2000, fit: 'fit', quality: 80 });
---
<Site
  site={site}
  title={`Galerie | ${dev.title}`}
  description={`Images des ${dev.title.replace(/^Les /, "")} à ${dev.address.city} : architecture, intérieurs, vues sur le Léman et étapes du chantier.`}
  image={photos[0] && img(photos[0].url, { w: 1200, h: 630 })}
>
  <section class="wrap intro">
    <h1>Galerie</h1>
    <p class="lede muted">{photos.length} images du projet, visuels non contractuels. Chaque image s’ouvre en grand.</p>
  </section>

  <section class="wrap seq" aria-label="Images du projet">
    {rows.map((row, r) => {
      const variants = COLS[row.length]!;
      const flip = row.length === 2 && Math.floor(r / PATTERN.length) % 2 === 1;
      return (
        <div class={`row n${row.length}`} style={`--cols:${variants[flip ? 1 : 0]}`}>
          {row.map((p, j) => {
            const b = box(row.length, j, flip);
            const first = p.n === 1;
            return (
              <a href={large(p.url)} class="tile zoom" id={`photo-${p.n}`} data-lightbox data-alt={p.alt || dev.title} aria-label={`${p.alt || dev.title}, agrandir`}>
                {first
                  ? <RaImage src={p} alt={p.alt || dev.title} width={b.w} height={b.h} sizes={b.sizes} priority mobile={{ width: 800, height: 600 }} widths={[640, 960, 1280]} quality={58} />
                  : <AvifImage src={p.url} alt={p.alt || `${dev.title}, photo ${p.n}`} width={b.w} height={b.h} sizes={b.sizes} />}
              </a>
            );
          })}
        </div>
      );
    })}
  </section>

  <section class="build" aria-labelledby="c-h">
    <div class="wrap">
      <div class="build-head">
        <h2 id="c-h">Les étapes de la construction</h2>
        <p class="muted small">Images d’illustration d’un chantier résidentiel : elles ne montrent pas ce projet.</p>
      </div>
      <ol class="strip">
        {CONSTRUCTION.map((p, i) => (
          <li>
            <a href={img(p.url, { w: 1600, fit: 'fit' })} class="tile zoom" data-lightbox data-alt={`${p.stage} : ${p.alt} (image d’illustration)`} aria-label={`${p.stage}, agrandir l’image d’illustration`}>
              <BucketPhoto src={p.url} width={p.width} height={p.height} alt={p.alt} sizes="(min-width: 1000px) 19vw, 70vw" />
            </a>
            <p class="stage"><span class="num">{String(i + 1).padStart(2, '0')}</span> {p.stage}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Image agrandie" data-dialog>
    <div class="lb-bar">
      <p class="lb-count" aria-live="polite" data-count></p>
      <button type="button" class="lb-btn" data-close>Fermer <span aria-hidden="true">×</span></button>
    </div>
    <figure class="lb-fig">
      <img alt="" data-img />
      <figcaption data-cap></figcaption>
    </figure>
    <button type="button" class="lb-nav prev" data-prev aria-label="Image précédente"><svg width="28" height="14" viewBox="0 0 28 14" aria-hidden="true"><path d="M27 7H2M7 1 1 7l6 6" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></button>
    <button type="button" class="lb-nav next" data-next aria-label="Image suivante"><svg width="28" height="14" viewBox="0 0 28 14" aria-hidden="true"><path d="M1 7h25M21 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></button>
  </dialog>

  <ContactBand site={site} />
</Site>

<script>
  import '../scripts/lightbox';
</script>

<style>
  .intro { padding-block: clamp(56px, 7vw, 104px) clamp(40px, 5vw, 64px); }
  .intro h1 { margin: 0 0 20px; }
  .seq { display: grid; gap: clamp(10px, 1.4vw, 20px); padding-bottom: var(--space-section); }
  .row { display: grid; grid-template-columns: var(--cols); gap: inherit; }
  .row.n1 { aspect-ratio: 2 / 1; }
  .row.n2 { aspect-ratio: 16 / 7.6; }
  .row.n3 { aspect-ratio: 16 / 6.4; }
  /* Rows far below the fold are not laid out (nor their photos fetched) until
     they come near: the first photo gets the bandwidth. */
  .row:nth-child(n + 3) { content-visibility: auto; contain-intrinsic-size: auto 520px; }
  .build { content-visibility: auto; contain-intrinsic-size: auto 760px; }
  .tile { display: block; overflow: hidden; background: var(--line); cursor: zoom-in; height: 100%; }
  .tile :global(picture) { display: block; height: 100%; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .build { background: var(--paper); border-top: 1px solid var(--line); padding-block: clamp(56px, 7vw, 104px); }
  .build-head { display: flex; justify-content: space-between; align-items: end; gap: 16px 40px; flex-wrap: wrap; margin-bottom: clamp(28px, 3vw, 44px); }
  .build-head h2 { margin: 0; }
  .build-head p { max-width: 38ch; font-size: 0.875rem; }
  .strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .strip .tile { aspect-ratio: 4 / 5; height: auto; }
  .stage { margin-top: 14px; font: 600 0.75rem/1.3 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; }
  .stage .num { color: var(--muted); margin-right: 8px; }

  .lightbox { width: 100vw; height: 100svh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(22 19 15 / 0.97); color: var(--on-dark); }
  .lightbox::backdrop { background: rgb(22 19 15 / 0.9); }
  .lightbox[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .lb-bar { display: flex; justify-content: space-between; align-items: center; padding: 12px var(--gutter); }
  .lb-count { font: 600 0.75rem/1 var(--sans); letter-spacing: 0.16em; }
  .lb-btn { min-height: 44px; padding: 0 4px; background: none; border: 0; color: inherit; font: 600 0.75rem/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; display: inline-flex; gap: 10px; align-items: center; }
  .lb-btn span { font-size: 1.5rem; font-weight: 300; letter-spacing: 0; }
  .lb-fig { margin: 0; min-height: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; justify-items: center; padding: 0 clamp(16px, 8vw, 120px) 24px; }
  .lb-fig img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; min-height: 0; }
  .lb-fig figcaption { padding-top: 14px; font-size: 0.875rem; color: var(--on-dark-muted); text-align: center; }
  .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 56px; height: 56px; display: grid; place-items: center; background: rgb(255 255 255 / 0.06); border: 1px solid rgb(255 255 255 / 0.18); color: inherit; cursor: pointer; }
  .lb-nav:hover { background: rgb(255 255 255 / 0.14); }
  .prev { left: clamp(8px, 2vw, 32px); }
  .next { right: clamp(8px, 2vw, 32px); }
  .lightbox :focus-visible { outline: 2px solid var(--on-dark); outline-offset: 3px; }

  @media (max-width: 1000px) {
    .strip { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 42%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; scrollbar-width: thin; }
    .strip li { scroll-snap-align: start; }
  }
  @media (max-width: 760px) {
    .row, .row.n1, .row.n2, .row.n3 { aspect-ratio: auto; grid-template-columns: 1fr 1fr; }
    .row .tile { aspect-ratio: 4 / 5; height: auto; }
    .row.n1 .tile, .row.n3 .tile:first-child { grid-column: 1 / -1; aspect-ratio: 4 / 3; }
    .strip { grid-auto-columns: 72%; }
    .lb-nav { top: auto; bottom: 16px; transform: none; width: 48px; height: 48px; }
    .lb-fig { padding: 0 8px 80px; }
  }
</style>
