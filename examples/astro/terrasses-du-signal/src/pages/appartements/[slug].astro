---
// One unit: the plan first, then the facts, its place in the building,
// photos and text when the unit is a live listing, and the enquiry with the
// unit preselected. Unknown unit: 404. Sold: noindex.
export const prerender = false;

import Site from '../../layouts/Site.astro';
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import EnquiryForm from '@realadvisor/sites-kit-astro/components/EnquiryForm.astro';
import { sanitizeHtml } from '@realadvisor/sites-kit-core';
import { img } from '@realadvisor/sites-kit-core/image';
import { featureLabel } from '@realadvisor/sites-kit-core/i18n';
import StackingPlan from '../../components/StackingPlan.astro';
import AgentContact from '../../components/AgentContact.astro';
import Arrow from '../../components/Arrow.astro';
import { loadSite } from '../../lib/data';
import {
  deliveryLabel, floorName, formatSurface, orientation, outdoor, planFor, statusLabel, unitFromSlug, unitLabel, unitNumber, unitOptions, unitPath, unitPrice,
} from '../../lib/units';
import { tel } from '../../lib/nav';

const site = await loadSite();
const { dev, agent, team } = site;
const unit = unitFromSlug(dev, Astro.params.slug ?? '');
if (!unit) return Astro.rewrite('/404');

const no = unitNumber(unit);
const o = outdoor(unit);
const plan = planFor(unit, dev.units);
const ori = orientation(unit);
const delivery = deliveryLabel(dev);
const photos = unit.photos ?? [];
const sold = unit.status === 'sold';
const roomsTitle = unit.rooms != null ? `${unit.rooms} pièces` : 'Appartement';
const facts = [
  ['Surface habitable', formatSurface(unit.living_surface)],
  [o?.label ?? '', o ? formatSurface(o.m2) : ''],
  ['Pièces', unit.rooms != null ? String(unit.rooms) : ''],
  ['Chambres', unit.bedrooms != null ? String(unit.bedrooms) : ''],
  ['Salles d’eau', unit.bathrooms != null ? String(unit.bathrooms) : ''],
  ['Étage', floorName(unit)],
  ['Orientation', ori],
  ['Livraison', delivery],
].filter(([k, v]) => k && v) as [string, string][];
const features = unit.features.map((f) => featureLabel(f)).filter(Boolean);
const similar = dev.units.filter((u) => u.id !== unit.id && u.rooms === unit.rooms && u.status === 'available').slice(0, 3);
const phone = agent?.phone ?? team?.phone;
const title = `${roomsTitle}, ${floorName(unit)}${no ? ` (${no})` : ''} | ${dev.title}`;
const description = [`Appartement de ${roomsTitle}`, formatSurface(unit.living_surface), o && `${o.label.toLowerCase()} de ${formatSurface(o.m2)}`, floorName(unit), `aux ${dev.title.replace(/^Les /, "")}, ${dev.address.city}`, unit.status === 'available' ? unitPrice(unit) : statusLabel(unit)].filter(Boolean).join(', ') + '.';
const ogPhoto = photos[0] ?? dev.photos[0];
---
<Site site={site} title={title} description={description} image={ogPhoto && img(ogPhoto.url, { w: 1200, h: 630 })} noindex={sold}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Fil d’Ariane">
      <ol>
        <li><a href="/appartements">Appartements</a></li>
        <li aria-current="page">{no || unitLabel(unit)}</li>
      </ol>
    </nav>

    <header class="head">
      <div>
        <p class="eyebrow">{[no, floorName(unit)].filter(Boolean).join(' · ')}</p>
        <h1>{roomsTitle}{o && ` ${o.kind === 'garden' ? 'avec jardin' : 'avec terrasse'}`}</h1>
      </div>
      <div class="head-price">
        <span class:list={['status', unit.status]}>{statusLabel(unit)}</span>
        {unit.status === 'available' && <p class="price num">{unitPrice(unit)}</p>}
      </div>
    </header>

    <div class="main">
      <figure class="plan">
        {plan ? (
          <span class="plan-box"><img src={plan.replace(/\.svg$/, '-fit.svg')} alt={`Plan indicatif de l’appartement de ${roomsTitle}, ${floorName(unit)}`} width="1000" height="750" fetchpriority="high" decoding="async" /></span>
        ) : (
          <div class="no-plan"><p>Plan sur demande</p></div>
        )}
        <figcaption>
          <span>Plan indicatif, non contractuel. Surfaces de vente selon le descriptif.</span>
          <a class="link" href="/documents/plans-terrasses-du-signal.pdf" download>Tous les plans (PDF) <Arrow dir="down" /></a>
        </figcaption>
      </figure>

      <aside class="card" aria-label="Caractéristiques">
        <div class="big">
          {unit.living_surface && <div><span class="v num">{unit.living_surface}</span><span class="l">m² habitables</span></div>}
          {o && <div><span class="v num">{o.m2}</span><span class="l">m² {o.kind === 'garden' ? 'de jardin' : 'de terrasse'}</span></div>}
        </div>
        <dl class="facts">
          {facts.map(([k, v]) => <div><dt>{k}</dt><dd class="num">{v}</dd></div>)}
        </dl>
        {features.length > 0 && <p class="features">{features.join(' · ')}</p>}
        {!sold ? (
          <a class="button" href="#demande">{unit.status === 'reserved' ? 'Être informé si le lot se libère' : 'Demander ce lot'}</a>
        ) : (
          <a class="button ghost" href="/appartements?dispo=1#lots">Voir les lots disponibles</a>
        )}
        {phone && <p class="call">Ou appelez le <a href={tel(phone)}>{phone}</a></p>}
      </aside>
    </div>
  </div>

  <section class="section place-in" aria-labelledby="pi-h">
    <div class="wrap pi-grid">
      <div>
        <h2 id="pi-h">Position dans l’immeuble</h2>
        <p class="lede">Le lot {no ? `${no.replace('Lot ', '')} ` : ''}est encadré dans le plan de l’immeuble.{ori && ` Il est orienté ${ori.toLowerCase()}.`}</p>
      </div>
      <StackingPlan units={dev.units} current={unit.id} compact label={`Position du lot dans l’immeuble`} />
    </div>
  </section>

  {(photos.length > 0 || unit.description) && (
    <section class="section photos" aria-labelledby="ph-h">
      <div class="wrap">
        <h2 id="ph-h" class="sr-only">Photos et description</h2>
        {unit.description && <div class="prose lede desc" set:html={sanitizeHtml(unit.description)} />}
        {photos.length > 0 && (
          <div class="pgrid">
            {photos.slice(0, 5).map((p, i) => (
              <RaImage src={p} alt={p.alt || `${unitLabel(unit)}, photo ${i + 1}`} width={i === 0 ? 1200 : 800} height={i === 0 ? 800 : 600} sizes={i === 0 ? '(min-width: 1000px) 66vw, 100vw' : '(min-width: 1000px) 33vw, 50vw'} class={`p p${i}`} />
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <section class="section enquiry-sec on-dark" id="demande" aria-labelledby="e-h">
    <div class="wrap e-grid">
      <div class="e-text">
        <h2 id="e-h">{sold ? 'Ce lot est vendu' : `Demande pour le ${no ? no.replace(/^Lot\s*/, 'lot ') : roomsTitle}`}</h2>
        <p>{sold ? 'Indiquez un autre lot : nous vous envoyons son plan et son prix.' : 'Nous vous envoyons le plan, le descriptif et le prix, et vous proposons une visite de l’espace de vente.'}</p>
        {agent && (
          <div class="agent"><AgentContact agent={agent} org={site.org.name} tone="dark" /></div>
        )}
      </div>
      <div class="e-form">
        {sold ? (
          <EnquiryForm developmentId={dev.id} units={unitOptions(dev.units)} agentName={agent?.first_name} message={`Bonjour, je m’intéresse aux ${dev.title.replace(/^Les /, "")}. Merci de me recontacter.`} />
        ) : (
          <EnquiryForm
            developmentId={dev.id}
            lotId={unit.id}
            agentName={agent?.first_name}
            message={`Bonjour, je suis intéressé(e) par le ${[no, unitLabel(unit)].filter(Boolean).join(', ')} aux ${dev.title.replace(/^Les /, "")}. Merci de me recontacter.`}
            submitLabel="Envoyer ma demande"
          />
        )}
      </div>
    </div>
  </section>

  {similar.length > 0 && (
    <section class="section similar" aria-labelledby="s-h">
      <div class="wrap">
        <h2 id="s-h">Autres {roomsTitle} disponibles</h2>
        <ul class="s-list">
          {similar.map((u) => {
            const p = planFor(u, dev.units);
            const so = outdoor(u);
            return (
              <li>
                <a href={unitPath(u)}>
                  {p && <span class="s-plan"><img src={p.replace(/\.svg$/, '-fit.svg')} alt="" width="1000" height="750" loading="lazy" decoding="async" /></span>}
                  <span class="s-t">{[unitNumber(u), floorName(u)].filter(Boolean).join(' · ')}</span>
                  <span class="s-m num">{formatSurface(u.living_surface)}{so && ` · ${so.label.toLowerCase()} ${formatSurface(so.m2)}`}</span>
                  <span class="s-p num">{unitPrice(u)}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}
</Site>

<style>
  .crumbs ol { list-style: none; display: flex; align-items: center; gap: 10px; margin: 0; padding: 28px 0 0; font-size: 0.8125rem; color: var(--muted); }
  .crumbs li { display: flex; align-items: center; }
  .crumbs li + li::before { content: '/'; margin-right: 10px; opacity: 0.6; }
  .crumbs a { display: inline-block; padding-block: 10px; }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; padding: 28px 0 40px; border-bottom: 1px solid var(--line); }
  .head h1 { margin-top: 16px; font-size: clamp(2.75rem, 1.8rem + 3.6vw, 5.25rem); }
  .head-price { display: grid; justify-items: end; gap: 10px; }
  .price { font: 500 clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem)/1 var(--serif); }

  .main { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(300px, 1fr); gap: clamp(32px, 4vw, 64px); padding-block: 40px var(--space-section); align-items: start; }
  .plan { margin: 0; }
  .plan-box, .no-plan { display: block; position: relative; width: 100%; aspect-ratio: 1000 / 720; background: #fff; border: 1px solid var(--line); }
  .plan-box img { position: absolute; inset: 4%; width: 92%; height: 92%; object-fit: contain; }
  .no-plan { aspect-ratio: 25 / 18; display: grid; place-items: center; color: var(--muted); }
  figcaption { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 24px; margin-top: 14px; font-size: 0.8125rem; color: var(--muted); }
  figcaption .link { color: var(--text); }

  .card { position: sticky; top: calc(var(--header-h) + 24px); background: var(--paper); border: 1px solid var(--line); padding: clamp(24px, 3vw, 36px); display: grid; gap: 24px; }
  .big { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
  .big div { display: grid; gap: 6px; }
  .big .v { font: 500 clamp(2.75rem, 2rem + 2vw, 3.75rem)/1 var(--serif); }
  .big .l { font: 600 0.6875rem/1.3 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .facts { margin: 0; display: grid; }
  .facts div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 0.9375rem; }
  .facts div:last-child { border-bottom: 0; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; font-weight: 600; text-align: right; }
  .features { font-size: 0.875rem; color: var(--muted); margin-top: -8px; }
  .card .button { width: 100%; }
  .call { font-size: 0.875rem; color: var(--muted); text-align: center; margin-top: -10px; }
  .call a { color: var(--text); display: inline-block; padding-block: 8px; }

  .place-in { background: var(--paper); border-block: 1px solid var(--line); }
  .pi-grid { display: grid; grid-template-columns: 0.8fr 1.4fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .pi-grid h2 { margin: 16px 0 20px; }

  .desc { margin-bottom: 48px; }
  .pgrid { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-auto-rows: auto; gap: 16px; }
  .pgrid :global(.p) { width: 100%; height: 100%; object-fit: cover; }
  .pgrid :global(.p0) { grid-row: span 2; grid-column: span 1; }

  .enquiry-sec { background: var(--dark); color: var(--on-dark); }
  .e-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(40px, 6vw, 96px); }
  .e-text .eyebrow { color: var(--on-dark-muted); }
  .e-text h2 { color: var(--on-dark); margin: 16px 0 20px; }
  .e-text p:not(.eyebrow) { color: var(--on-dark-muted); max-width: 44ch; }
  .agent { margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--line-dark); }
  .agent :global(.n) { color: var(--on-dark); }
  .enquiry-sec :focus-visible { outline-color: var(--on-dark); }

  .s-list { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .s-list a { display: grid; gap: 8px; text-decoration: none; padding: 16px; border: 1px solid var(--line); background: var(--paper); transition: border-color 0.3s var(--ease); }
  .s-list a:hover { border-color: var(--text); }
  .s-plan { position: relative; display: block; aspect-ratio: 4 / 3; background: #fff; margin-bottom: 8px; }
  .s-plan img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .s-t { font: 500 1.375rem/1.2 var(--serif); }
  .s-m { font-size: 0.875rem; color: var(--muted); }
  .s-p { font-weight: 600; }

  @media (max-width: 1000px) {
    .main, .pi-grid, .e-grid { grid-template-columns: 1fr; }
    .card { position: static; }
    .s-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .head-price { justify-items: start; }
    .pgrid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .pgrid :global(.p0) { grid-column: span 2; grid-row: auto; }
  }
</style>
