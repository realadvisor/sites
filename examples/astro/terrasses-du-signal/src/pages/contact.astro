---
// Contact / register interest: the enquiry form with the unit select
// (?lot=<id> preselects one), the broker, the sales office and the map.
export const prerender = false;

import Site from '../layouts/Site.astro';
import EnquiryForm from '@realadvisor/sites-kit-astro/components/EnquiryForm.astro';
import { img } from '@realadvisor/sites-kit-core/image';
import { agencyJsonLd } from '@realadvisor/sites-kit-core/seo';
import AgentContact from '../components/AgentContact.astro';
import StaticMap from '../components/StaticMap.astro';
import { loadSite, legalAgency } from '../lib/data';
import { unitLabel, unitNumber, unitOptions } from '../lib/units';
import { BROCHURE, tel } from '../lib/nav';

const site = await loadSite();
const { dev, org, team, agents } = site;
const lot = Astro.url.searchParams.get('lot');
const chosen = dev.units.find((u) => u.id === lot && u.status !== 'sold');
const brochure = Astro.url.searchParams.get('demande') === 'brochure';
const brokers = [...dev.agents, ...agents.filter((a) => !dev.agents.some((d) => d.id === a.id))];
const office = [org.address?.street, [org.address?.postcode, org.address?.city].filter(Boolean).join(' ')].filter(Boolean).join(', ');
const message = chosen
  ? `Bonjour, je suis intéressé(e) par le ${[unitNumber(chosen), unitLabel(chosen)].filter(Boolean).join(', ')} aux ${dev.title.replace(/^Les /, "")}. Merci de me recontacter.`
  : brochure
    ? `Bonjour, je souhaite recevoir la brochure, les plans et la liste de prix des ${dev.title.replace(/^Les /, "")}.`
    : `Bonjour, je souhaite en savoir plus sur les ${dev.title.replace(/^Les /, "")} et visiter l’espace de vente.`;
---
<Site
  site={site}
  bar={false}
  title={`Contact et espace de vente | ${dev.title}`}
  description={`Demandez la brochure, un plan ou un rendez-vous à l’espace de vente des ${dev.title.replace(/^Les /, "")}, ${dev.address.city}. Commercialisation : ${org.name}.`}
  image={dev.photos[0] && img(dev.photos[0].url, { w: 1200, h: 630 })}
  jsonLd={agencyJsonLd(legalAgency(site), Astro.site?.href ?? '/')}
>
  <div class="wrap grid">
    <div class="left">
      <h1>Contact</h1>
      <p class="lede">Demandez un plan, la liste de prix ou un rendez-vous à l’espace de vente de {org.address?.city ?? dev.address.city}. Indiquez le lot qui vous intéresse si vous l’avez choisi.</p>

      <ul class="people">
        {brokers.map((a) => (
          <li><AgentContact agent={a} org={org.name} /></li>
        ))}
      </ul>

      <dl class="office">
        <div><dt>Commercialisation</dt><dd>{org.name}{office && <><br />{office}</>}</dd></div>
        {team?.phone && <div><dt>Téléphone</dt><dd><a href={tel(team.phone)}>{team.phone}</a></dd></div>}
        {team?.email && <div><dt>E-mail</dt><dd><a href={`mailto:${team.email}`}>{team.email}</a></dd></div>}
        <div><dt>Brochure</dt><dd><a href={BROCHURE} download>Télécharger (PDF)</a></dd></div>
      </dl>
    </div>

    <div class="right">
      <div class="panel">
        <h2>Votre demande</h2>
        <EnquiryForm
          id="contact"
          developmentId={dev.id}
          units={unitOptions(dev.units)}
          selectedUnit={chosen?.id}
          agentName={site.agent?.first_name}
          message={message}
        />
      </div>
    </div>
  </div>

  {org.address?.lat != null && org.address?.lng != null && (
    <section class="wrap map-sec" aria-labelledby="m-h">
      <h2 id="m-h">Espace de vente</h2>
      <StaticMap lat={org.address.lat} lng={org.address.lng} zoom={15} label={[org.name, office].filter(Boolean).join(', ')} />
    </section>
  )}
</Site>

<style>
  .grid { display: grid; grid-template-columns: 1fr minmax(0, 560px); gap: clamp(40px, 7vw, 120px); padding-block: clamp(56px, 7vw, 104px); align-items: start; }
  h1 { margin: 0 0 24px; }
  .people { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px; }
  .office { margin: 48px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 24px 32px; padding-top: 32px; border-top: 1px solid var(--line); }
  .office dt { font: 600 0.6875rem/1.4 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  .office dd { margin: 0; font-size: 0.9375rem; }
  .office a { display: inline-block; padding-block: 4px; }
  .panel { background: var(--paper); border: 1px solid var(--line); padding: clamp(24px, 3.4vw, 44px); position: sticky; top: calc(var(--header-h) + 24px); }
  .panel h2 { font-size: 2rem; margin-bottom: 24px; }
  .map-sec { padding-bottom: var(--space-section); }
  .map-sec h2 { margin-bottom: 24px; }
  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr; } .panel { position: static; } }
  @media (max-width: 520px) { .office { grid-template-columns: 1fr; } }
</style>
