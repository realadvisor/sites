---
/**
 * Three-zone header: links left, wordmark centred, brochure + contact right.
 * `overlay`: transparent over the home hero (a scrim keeps it readable).
 * Phone: wordmark and a menu button (44x44, Escape closes, scroll locked).
 */
import { NAV, CONTACT, BROCHURE } from '../lib/nav';
import type { Site } from '../lib/data';

interface Props { site: Site; overlay?: boolean }
const { site, overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined);
const city = site.dev.address.city;
---
<header class:list={['site-header', { overlay }]} data-header>
  <div class="bar wrap">
    <nav class="left" aria-label="Navigation principale">
      <ul>
        {NAV.slice(0, 3).map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="mark" href="/">
      <span class="name">{site.dev.title}</span>
      {city && <span class="city">{city}</span>}
    </a>
    <div class="right">
      <a href={NAV[3].href} class="text" aria-current={current(NAV[3].href)}>{NAV[3].label}</a>
      <a href={CONTACT.href} class="cta" aria-current={current(CONTACT.href)}>Nous contacter</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
        <span class="sr-only">Menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18M3 16h18" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
      </button>
    </div>
  </div>
  <div class="menu" id="menu" data-menu>
    <nav aria-label="Menu">
      <ul>
        {[...NAV, CONTACT].map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
      </ul>
      <p class="menu-foot">
        <a href={BROCHURE} download>Télécharger la brochure (PDF)</a>
      </p>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) { set(false); btn.focus(); }
    });
    matchMedia('(min-width: 1001px)').addEventListener('change', (m) => m.matches && set(false));
  }
  // Home: the header over the hero turns solid as soon as the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-header].overlay');
  if (header) {
    let ticking = false;
    const update = () => { header.classList.toggle('is-solid', window.scrollY > 24); ticking = false; };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: rgb(246 242 235 / 0.97); border-bottom: 1px solid var(--line); }
  /* Over the home hero: transparent, then solid once the page scrolls. It stays sticky like on every page. */
  .site-header.overlay { margin-bottom: calc(-1 * var(--header-h) - 1px); background: linear-gradient(rgb(20 17 13 / 0.55), rgb(20 17 13 / 0)); border-color: transparent; color: #fff; transition: background-color 0.35s var(--ease), color 0.35s var(--ease), border-color 0.35s var(--ease); }
  .site-header.overlay.is-solid { background: rgb(246 242 235 / 0.97); color: var(--text); border-color: var(--line); }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: var(--header-h); gap: 24px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .left ul { display: flex; gap: clamp(18px, 2.4vw, 36px); }
  .left a, .right .text {
    font: 600 0.75rem/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none;
    padding-block: 14px; border-bottom: 1px solid transparent; transition: border-color 0.3s var(--ease);
  }
  .left a:hover, .left a[aria-current], .right .text:hover, .right .text[aria-current] { border-bottom-color: currentColor; }
  .mark { display: grid; justify-items: center; text-decoration: none; gap: 3px; }
  .name { font: 500 clamp(1.375rem, 1.1rem + 0.7vw, 1.75rem)/1 var(--serif); letter-spacing: 0.01em; white-space: nowrap; }
  .city { font: 600 0.625rem/1 var(--sans); letter-spacing: 0.32em; text-transform: uppercase; opacity: 0.8; padding-left: 0.32em; }
  .right { display: flex; justify-content: flex-end; align-items: center; gap: 28px; }
  .cta {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px;
    font: 600 0.75rem/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none;
    border: 1px solid currentColor; transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .cta:hover { background: var(--text); color: var(--bg); border-color: var(--text); }
  .overlay:not(.is-solid) .cta:hover { background: #fff; color: var(--dark); border-color: #fff; }
  .menu-btn { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; margin-right: -10px; background: none; border: 0; color: inherit; cursor: pointer; }
  .menu {
    position: fixed; inset: var(--header-h) 0 0 0; z-index: 39; background: var(--bg); color: var(--text);
    padding: 32px var(--gutter); overflow-y: auto;
    visibility: hidden; pointer-events: none; opacity: 0; transition: opacity 0.35s var(--ease), visibility 0s 0.35s;
  }
  .menu.is-open { visibility: visible; pointer-events: auto; opacity: 1; transition: opacity 0.35s var(--ease); }
  .menu li { border-bottom: 1px solid var(--line); }
  .menu li a { display: block; padding: 18px 0; font: 500 2rem/1.1 var(--serif); text-decoration: none; }
  .menu li a[aria-current] { font-style: italic; }
  .menu-foot { margin-top: 28px; font-size: 0.9375rem; }
  :global(html.menu-open) { overflow: hidden; }
  :global(html.menu-open) .site-header.overlay { background: var(--bg); color: var(--text); }

  @media (max-width: 1000px) {
    .bar { grid-template-columns: 1fr auto; }
    .left, .right .text, .right .cta { display: none; }
    .mark { justify-items: start; }
    .menu-btn { display: inline-flex; }
  }
  @media (min-width: 1001px) { .menu { display: none; } }
</style>
