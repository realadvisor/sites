---
/** Shell of the legal pages: the kit's text (LegalContent), our layout. */
import LegalContent from '@realadvisor/sites-kit-astro/components/LegalContent.astro';
import type { LegalSection } from '@realadvisor/sites-kit-core/legal';
import Site from '../layouts/Site.astro';
import type { Site as SiteData } from '../lib/data';

interface Props { site: SiteData; title: string; sections: LegalSection[] }
const { site, title, sections } = Astro.props;
---
<Site site={site} title={`${title} | ${site.dev.title}`} description={`${title} – ${site.org.name}, ${site.dev.title}.`}>
  <div class="wrap page">
    <h1>{title}</h1>
    <LegalContent sections={sections} class="legal-body" />
  </div>
</Site>
<style>
  .page { max-width: calc(820px + 2 * var(--gutter)); padding-block: clamp(56px, 7vw, 104px) var(--space-section); }
  h1 { font-size: clamp(2.5rem, 1.8rem + 2.6vw, 4rem); margin-bottom: 48px; }
  .page :global(.legal-body section) { padding: 28px 0; border-top: 1px solid var(--line); }
  .page :global(.legal-body h2) { font-size: 1.75rem; margin-bottom: 16px; }
  .page :global(.legal-body dl) { margin: 0; display: grid; gap: 10px; }
  .page :global(.legal-body dl div) { display: grid; grid-template-columns: 200px 1fr; gap: 16px; }
  .page :global(.legal-body dt) { color: var(--muted); }
  .page :global(.legal-body dd) { margin: 0; }
  .page :global(.legal-body p) { max-width: 64ch; }
  .page :global(.legal-body p + p) { margin-top: 0.8em; }
  @media (max-width: 560px) { .page :global(.legal-body dl div) { grid-template-columns: 1fr; gap: 2px; } }
</style>
