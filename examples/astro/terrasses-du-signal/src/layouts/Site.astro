---
/**
 * Site shell: fonts, tokens, skip link, header, footer, phone action bar.
 * Every page renders through it (Base writes the <head> SEO tags).
 */
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource-variable/manrope/wght.css';
import serif500 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import serifItalic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import sans from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Site as SiteData } from '../lib/data';

interface Props {
  site: SiteData;
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Header over the hero photo (home). */
  overlay?: boolean;
  /** Hide the phone action bar (contact page has its own form). */
  bar?: boolean;
}
const { site, title, description, image, jsonLd, noindex, overlay = false, bar = true } = Astro.props;
---
<Base title={title} description={description} image={image} jsonLd={jsonLd} noindex={noindex}>
  <link slot="head" rel="preload" as="font" type="font/woff2" crossorigin href={serif500} />
  <link slot="head" rel="preload" as="font" type="font/woff2" crossorigin href={serifItalic} />
  <link slot="head" rel="preload" as="font" type="font/woff2" crossorigin href={sans} />
  <meta slot="head" name="theme-color" content="#f6f2eb" />
  <a class="skip" href="#main">Aller au contenu</a>
  <Header site={site} overlay={overlay} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer site={site} />
  {bar && (
    <nav class="phone-bar" aria-label="Actions rapides">
      <a href="/appartements">Appartements</a>
      <a href="/contact" class="primary">Nous contacter</a>
    </nav>
  )}
</Base>

<style>
  main { display: block; outline: none; }
  .phone-bar { display: none; }
  @media (max-width: 760px) {
    .phone-bar {
      position: fixed; inset: auto 0 0 0; z-index: 30; display: grid; grid-template-columns: 1fr 1fr;
      gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
      background: rgb(246 242 235 / 0.96); border-top: 1px solid var(--line);
      backdrop-filter: blur(8px);
    }
    .phone-bar a {
      display: flex; align-items: center; justify-content: center; min-height: 48px;
      font: 600 0.75rem/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none;
      border: 1px solid var(--line-strong); color: var(--text);
    }
    .phone-bar a.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    :global(body) { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
  }
</style>
