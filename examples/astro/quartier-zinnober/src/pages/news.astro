---
// Baustelle (News): the construction timeline from the content collection
// src/content/news, with the development's construction photos (fixture only)
// and the planned move-in dates.
export const prerender = false;

import Site from '../layouts/Site.astro';
import PageHead from '../components/PageHead.astro';
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import BucketPicture from '../components/BucketPicture.astro';
import Icon from '../components/Icon.astro';
import { img } from '@realadvisor/sites-kit-core/image';
import { site as load } from '../lib/data';
import { news, newsDate, newsMonth } from '../lib/news';
import { render } from 'astro:content';

const site = await load();
const { dev } = site;
const entries = await news(dev.id);
const now = Date.now();
// Even spacing (the dates cluster); today sits between the last past and the first future entry.
const pos = (i: number) => (entries.length > 1 ? (i / (entries.length - 1)) * 100 : 0);
const past = entries.filter((e) => e.data.date.getTime() <= now).length;
const today = past <= 0 ? 0 : past >= entries.length ? 100 : pos(past - 0.5);
const todayLabel = new Intl.DateTimeFormat('de-CH', { month: 'long', year: 'numeric' }).format(new Date(now));
const done = entries.filter((e) => !e.data.planned);
const newestFirst = await Promise.all([...entries].reverse().map(async (e) => ({ e, Body: (await render(e)).Content })));
const lead = done.at(-1);
const ogPhoto = lead?.photoUrl ?? dev.photos[0]?.url;
---
<Site
  site={site}
  title={`Baustelle: Etappen und Neuigkeiten | ${dev.title}`}
  description={`Vom Spatenstich bis zum Bezug: die Etappen des ${dev.title}${lead ? `, zuletzt «${lead.data.title}» (${newsMonth(lead.data.date)})` : ''}.`}
  image={ogPhoto && img(ogPhoto, { w: 1200, h: 630 })}
>
  <PageHead title="Baustelle" lead="Vom Spatenstich bis zum Bezug des letzten Hauses: hier halten wir fest, was auf der Baustelle passiert." tone="ink" />

  {entries.length > 0 && (
    <section class="line-band" aria-label="Zeitstrahl">
      <div class="wrap">
        <div class="line" style={`--today:${today}%`}>
          <div class="track" aria-hidden="true"><span class="fill"></span></div>
          <span class="today" aria-hidden="true"><span>Heute · {todayLabel}</span></span>
          <ol class="marks">
            {entries.map((e, i) => (
              <li class:list={{ planned: e.data.planned }} style={`left:${pos(i)}%`}>
                <a href={`#${e.id}`}>
                  <span class="dot" aria-hidden="true"></span>
                  <span class="lbl"><strong>{e.data.phase}</strong><span>{newsMonth(e.data.date)}</span></span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  <section class="wrap feed" aria-label="Neuigkeiten">
    <ol class="items">
      {newestFirst.map(({ e, Body }) => (
        <li class:list={['item', { planned: e.data.planned }]} id={e.id}>
          <div class="when">
            <time datetime={e.data.date.toISOString().slice(0, 10)}>{e.data.planned ? newsMonth(e.data.date) : newsDate(e.data.date)}</time>
            <span class:list={['state', { 'state--planned': e.data.planned }]}>{e.data.planned ? 'Geplant' : 'Erledigt'}</span>
          </div>
          <article class="body">
            <div class="txt">
              <p class="houses">{e.data.houses.map((h) => <span class={`h h--${h.toLowerCase()}`}>Haus {h}</span>)}</p>
              <h2>{e.data.title}</h2>
              <div class="prose"><Body /></div>
            </div>
            {(e.photoUrl || e.photoLocal) && (
              <figure class="pic">
                {e.photoLocal ? (
                  <BucketPicture name={e.photoLocal} alt={e.data.photoAlt ?? e.data.title} ratio={3 / 2} sizes="(min-width: 1000px) 40vw, 100vw" />
                ) : (
                  <RaImage src={e.photoUrl!} alt={e.data.photoAlt ?? e.data.title} width={900} height={600} sizes="(min-width: 1000px) 40vw, 100vw" />
                )}
              </figure>
            )}
          </article>
        </li>
      ))}
    </ol>
  </section>

  <section class="band band--butter">
    <div class="wrap end">
      <h2>Freie Wohnungen nach Haus und Bezugstermin</h2>
      <a class="cta" href="/wohnungen">Zu den Wohnungen <Icon name="arrow" /></a>
    </div>
  </section>
</Site>
<style>
  .line-band { background: var(--ink); color: #fff; padding-block: 8px clamp(48px, 6vw, 80px); overflow: hidden; }
  .line { position: relative; height: 130px; margin-inline: 12px; }
  .track { position: absolute; left: 0; right: 0; top: 54px; height: 6px; border-radius: 3px; background: rgb(255 255 255 / 0.25); }
  .fill { position: absolute; inset: 0 auto 0 0; width: var(--today); background: var(--zinnober); border-radius: 3px; }
  .today { position: absolute; left: var(--today); top: 0; height: 66px; border-left: 2px dashed var(--butter); }
  .today span { position: absolute; left: 8px; top: 0; white-space: nowrap; font-size: 0.8125rem; font-weight: 650; color: var(--butter); }
  .marks { list-style: none; margin: 0; padding: 0; }
  .marks li { position: absolute; top: 44px; transform: translateX(-13px); }
  .marks a { display: grid; justify-items: start; gap: 10px; text-decoration: none; color: #fff; }
  .dot { width: 26px; height: 26px; border-radius: 50%; background: var(--zinnober); border: 3px solid #fff; }
  .planned .dot { background: var(--ink); border-style: dashed; }
  .lbl { display: grid; font-size: 0.8125rem; line-height: 1.25; width: 9.5em; }
  .lbl strong { font-size: 0.875rem; text-wrap: balance; }
  .lbl span { color: #d9d4ee; }
  .marks li:last-child { transform: translateX(-100%) translateX(13px); }
  .marks li:last-child a { justify-items: end; text-align: right; }
  .marks a:hover strong { text-decoration: underline; }

  .feed { padding-block: clamp(40px, 6vw, 88px); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; }
  .item { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: clamp(16px, 3vw, 48px); padding-block: clamp(28px, 4vw, 48px); border-top: 2px solid var(--ink); }
  .when { display: grid; gap: 10px; align-content: start; }
  .when time { font: 750 var(--step-1)/1.1 var(--display); }
  .state { justify-self: start; padding: 4px 10px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 0.8125rem; font-weight: 650; }
  .state--planned { background: transparent; color: var(--ink); border: 2px dashed var(--ink); }
  .body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 40px); align-items: start; }
  .planned .body { grid-template-columns: minmax(0, 1fr); }
  .txt { display: grid; gap: 14px; }
  .txt h2 { font-size: var(--step-3); }
  .houses { display: flex; gap: 6px; flex-wrap: wrap; }
  .h { padding: 4px 10px; border-radius: 8px; border: 2px solid var(--ink); font-size: 0.8125rem; font-weight: 700; }
  .h--a { background: var(--haus-a); }
  .h--b { background: var(--haus-b); }
  .h--c { background: var(--haus-c); }
  .pic { margin: 0; border-radius: var(--radius-card); overflow: hidden; border: 2px solid var(--ink); }
  .pic :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .end { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; }
  .end h2 { font-size: var(--step-3); max-width: 20ch; }

  @media (max-width: 900px) {
    .line-band { display: none; }
    .item { grid-template-columns: 1fr; }
    .body { grid-template-columns: 1fr; }
    .when { grid-auto-flow: column; justify-content: start; align-items: center; gap: 14px; }
  }
</style>
