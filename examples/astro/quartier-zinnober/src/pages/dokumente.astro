---
// Dokumente: brochure, rent list and plans as PDFs (generated by
// scripts/documents.mjs), plus each unit type's plan.
export const prerender = false;

import Site from '../layouts/Site.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { site as load } from '../lib/data';
import { rowsOf, surface, types } from '../lib/units';
import docs from '../lib/documents.json';

const site = await load();
const { dev } = site;
const typeList = types(rowsOf(dev));
const size = (b: number) => `${new Intl.NumberFormat('de-CH', { maximumFractionDigits: b > 1e6 ? 1 : 0 }).format(b > 1e6 ? b / 1e6 : b / 1e3)} ${b > 1e6 ? 'MB' : 'kB'}`;
const date = (iso: string) => new Intl.DateTimeFormat('de-CH', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${iso}T12:00:00Z`));
const TONES = ['zinnober', 'lilac', 'butter'];
---
<Site
  site={site}
  title={`Dokumente: Broschüre, Mietzinsliste, Grundrisse | ${dev.title}`}
  description={`Broschüre, Mietzinsliste und Grundrisse des ${dev.title} als PDF zum Herunterladen.`}
>
  <PageHead title="Dokumente" lead="Alles zum Herunterladen: die Broschüre, die aktuelle Mietzinsliste und die Grundrisse aller Wohnungstypen." tone="sand" />

  <section class="wrap docs">
    <ul class="list">
      {docs.map((d, i) => (
        <li class={`doc doc--${TONES[i % TONES.length]}`}>
          <a href={d.file} download>
            <span class="ic" aria-hidden="true"><Icon name="file" size={30} /></span>
            <span class="nm">{d.name}</span>
            <span class="tx">{d.text}</span>
            <span class="meta">PDF · <span class="num">{d.pages} {d.pages === 1 ? 'Seite' : 'Seiten'} · {size(d.bytes)}</span> · Stand {date(d.date)}</span>
            <span class="dl"><Icon name="download" size={22} /> Herunterladen</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="band band--sand plans">
    <div class="wrap">
      <h2 class="h">Grundrisse einzeln</h2>
      <ul class="pl">
        {typeList.filter((t) => t.plan).map((t) => (
          <li>
            <a href={t.plan} download={`quartier-zinnober-grundriss-${String(t.rooms).replace('.', '-')}-zimmer.svg`}>
              <img src={t.plan} width="600" height="470" loading="lazy" decoding="async" alt={`Grundriss indikativ, ${String(t.rooms)} Zimmer`} />
              <span class="row"><strong>{String(t.rooms)} Zimmer</strong>{t.surface && <span class="num">{surface(t.surface)}</span>}<span class="svg"><Icon name="download" size={18} /> SVG</span></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="muted note">Grundrisse indikativ, nicht massgebend. Massgebend sind die Ausführungspläne.</p>
    </div>
  </section>
</Site>
<style>
  .docs { padding-block: clamp(40px, 6vw, 88px); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); }
  .doc a { display: grid; gap: 12px; align-content: start; height: 100%; padding: clamp(22px, 2.6vw, 32px); border: 2px solid var(--ink); border-radius: var(--radius-card); text-decoration: none; color: var(--ink); transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .doc a:hover { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--ink); text-decoration: none; }
  .doc--zinnober a { background: var(--zinnober); }
  .doc--lilac a { background: var(--lilac); }
  .doc--butter a { background: var(--butter); }
  .ic { width: 60px; height: 60px; display: grid; place-items: center; border-radius: 14px; background: var(--paper); border: 2px solid var(--ink); }
  .nm { font: 800 var(--step-3)/1 var(--display); letter-spacing: -0.03em; margin-top: 8px; }
  .meta { font-size: 0.875rem; font-weight: 600; }
  .dl { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; font-weight: 700; border-bottom: 2px solid currentColor; justify-self: start; padding-bottom: 2px; }
  .h { font-size: var(--step-3); margin-bottom: 24px; }
  .pl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .pl a { display: grid; gap: 10px; text-decoration: none; }
  .pl img { width: 100%; border: 2px solid var(--ink); border-radius: 14px; background: #fff; }
  .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .svg { margin-left: auto; display: inline-flex; align-items: center; gap: 4px; font-weight: 650; font-size: 0.875rem; }
  .pl a:hover strong { text-decoration: underline; }
  .note { margin-top: 18px; font-size: 0.875rem; }
  @media (max-width: 960px) { .list { grid-template-columns: 1fr; } .pl { grid-template-columns: 1fr 1fr; } }
</style>
