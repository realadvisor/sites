---
/** Home: framed hero, the figures a buyer needs, the project, availability by type beside the drawing, the place, the sales office. */
import { sanitizeHtml } from '@realadvisor/sites-kit-core';
import { img } from '@realadvisor/sites-kit-core/image';
import Site from '../layouts/Site.astro';
import Photo from '../components/Photo.astro';
import IsoDrawing from '../components/IsoDrawing.astro';
import AgentCard from '../components/AgentCard.astro';
import { developmentExtra, loadSite } from '../lib/data';
import { href, tel, type L } from '../lib/routes';
import { c } from '../lib/copy';
import { brochure } from '../lib/docs';
import { deliveryLabel, formatAmount, formatRooms, planSrc, planKey, range, unitTypes } from '../lib/units';
import { DESCRIPTION_DE } from '../content/project';
import { photoAlt } from '../content/photo-alts';
import { crowKm, km, PHOTOS, PLACES } from '../content/place';

interface Props { l: L }
const { l } = Astro.props;
const site = await loadSite();
const { dev, team, org } = site;
const units = dev.units;
const available = units.filter((u) => u.status === 'available');
const rooms = range(units.flatMap((u) => (u.rooms != null ? [u.rooms] : [])));
const surf = range(units.flatMap((u) => (u.living_surface ? [u.living_surface] : [])));
const prices = available.flatMap((u) => (u.price && !u.price_on_request ? [u.price] : []));
const delivery = deliveryLabel(dev, l);
const types = unitTypes(units);
const extra = developmentExtra(dev); // fixture only: buildings
const houses = (extra.buildings ?? []).length;
const photos = dev.photos;
const hero = photos[0];
const pdf = brochure(l);
const dash = ' – ';
const where = dev.address.lat != null && dev.address.lng != null ? { lat: dev.address.lat, lng: dev.address.lng } : null;
const near = where ? PLACES.slice(0, 3).map((p) => ({ name: p.name[l], d: km(crowKm(where, p), l) })) : [];

const T = {
  it: {
    title: `${dev.title}, appartamenti nuovi a Castagnola, Lugano`,
    lead: `${units.length} appartamenti${houses ? ` in ${houses === 2 ? 'due' : houses} palazzine` : ''} sul pendio di Castagnola, sopra il lago di Lugano.`,
    seeUnits: 'Vedi gli appartamenti',
    projectH: 'Sul pendio, davanti al lago',
    availH: 'Disponibilità per tipologia',
    availP: 'Ogni segmento del disegno è un appartamento. Passa sopra o clicca per aprirlo.',
    allUnits: `Tutti i ${units.length} appartamenti`,
    outdoorLine: 'Ogni appartamento ha il suo spazio esterno: giardino al piano terra, loggia ai piani, terrazza negli attici.',
    placeH: 'Castagnola, Lugano',
    placeP: 'Un quartiere residenziale sul versante del Monte Brè, tra Cassarate e Gandria. Il centro di Lugano è a dieci minuti, il sentiero dell’olivo verso Gandria parte poco sotto la residenza.',
    crow: 'in linea d’aria',
    morePlace: 'La posizione',
    salesH: 'Visite e informazioni',
    salesP: 'Le visite del cantiere e dell’ufficio vendite si fissano su appuntamento.',
    none: 'nessuno disponibile',
    avShort: 'disp.',
    figAv: 'disponibili',
    figUnits: `su ${units.length}`,
  },
  de: {
    title: `${dev.title}, Neubauwohnungen in Castagnola, Lugano`,
    lead: `${units.length} Wohnungen${houses ? ` in ${houses === 2 ? 'zwei' : houses} kleinen Häusern` : ''} am Hang von Castagnola, über dem Luganersee.`,
    seeUnits: 'Wohnungen ansehen',
    projectH: 'Am Hang, vor dem See',
    availH: 'Verfügbarkeit nach Wohnungstyp',
    availP: 'Jedes Feld der Zeichnung ist eine Wohnung. Darüberfahren oder anklicken, um sie zu öffnen.',
    allUnits: `Alle ${units.length} Wohnungen`,
    outdoorLine: 'Jede Wohnung hat ihren Aussenraum: Garten im Erdgeschoss, Loggia in den Obergeschossen, Terrasse in der Attika.',
    placeH: 'Castagnola, Lugano',
    placeP: 'Ein Wohnquartier am Hang des Monte Brè, zwischen Cassarate und Gandria. Das Zentrum von Lugano ist zehn Minuten entfernt, der Olivenweg nach Gandria beginnt knapp unterhalb der Residenz.',
    crow: 'Luftlinie',
    morePlace: 'Zur Lage',
    salesH: 'Besichtigung und Beratung',
    salesP: 'Besichtigungen der Baustelle und des Verkaufsbüros nach Vereinbarung.',
    none: 'keine verfügbar',
    avShort: 'verf.',
    figAv: 'verfügbar',
    figUnits: `von ${units.length}`,
  },
}[l];
const typeName = (t: (typeof types)[number]) => (t.penthouse ? `${c('penthouse', l)} ${formatRooms(t.rooms, l)}` : formatRooms(t.rooms, l));
const typeHref = (t: (typeof types)[number]) => `${href('units', l)}?rooms=${t.rooms}${t.penthouse ? '&floor=top' : ''}`;
const sample = (t: (typeof types)[number]) => planSrc(planKey(t.available[0] ?? t.units[0]!, units), l, true);
const description = l === 'it' ? null : DESCRIPTION_DE;
---
<Site site={site} l={l} route="home" title={T.title} description={T.lead} image={hero ? img(hero.url, { w: 1200, h: 630 }) : undefined}>
  {hero && (
    <section class="hero">
      <div class="frame" data-hero>
        <Photo src={hero.url} alt={photoAlt(hero.url, l, hero.alt)} width={1600} height={900} sizes="(max-width: 640px) 100vw, calc(100vw - 32px)" priority mobile={{ width: 4, height: 5 }} />
        <div class="hero-text">
          <h1 class="h1">{dev.title}</h1>
          <p class="lede">{T.lead}</p>
          <p class="actions">
            <a class="btn light" href={href('units', l)}>{T.seeUnits}</a>
            {pdf && <a class="btn hero-ghost" href={pdf} download>{c('brochure', l)} (PDF)</a>}
          </p>
        </div>
      </div>
    </section>
  )}

  <section class="wrap figures" aria-label={l === 'de' ? 'Eckdaten' : 'In breve'}>
    <dl>
      <div><dt>{T.figAv}</dt><dd><span class="num">{available.length}</span> <small>{T.figUnits}</small></dd></div>
      {rooms && <div><dt>{c('rooms', l)}</dt><dd class="num">{String(rooms.min)}{dash}{String(rooms.max)}</dd></div>}
      {surf && <div><dt>{c('livingArea', l)}</dt><dd class="num">{surf.min}{dash}{surf.max} m²</dd></div>}
      {prices.length > 0 && <div><dt>{c('price', l)}</dt><dd><small>{c('from', l)}</small> <span class="num">{formatAmount(Math.min(...prices))}</span></dd></div>}
      {delivery && <div><dt>{c('deliveryPlanned', l)}</dt><dd>{delivery}</dd></div>}
    </dl>
  </section>

  <section class="wrap section project">
    {photos[1] && (
      <div class="project-photo">
        <Photo class="arch" src={photos[1].url} alt={photoAlt(photos[1].url, l, photos[1].alt)} width={800} height={1040} sizes="(max-width: 860px) 80vw, 34vw" />
      </div>
    )}
    <div class="project-text">
      <h2 class="h2">{T.projectH}</h2>
      {description ? (
        <div class="prose">{description.map((p) => <p>{p}</p>)}</div>
      ) : (
        dev.description && <div class="prose" set:html={sanitizeHtml(dev.description)} />
      )}
      {(dev.architect?.name || dev.developer?.name) && (
        <dl class="credits">
          {dev.architect?.name && <div><dt>{c('architect', l)}</dt><dd>{dev.architect?.name}</dd></div>}
          {dev.developer?.name && <div><dt>{c('developer', l)}</dt><dd>{dev.developer?.name}</dd></div>}
        </dl>
      )}
    </div>
  </section>

  <section class="avail">
    <div class="wrap section avail-grid">
      <div class="avail-head">
        <h2 class="h2">{T.availH}</h2>
        <p class="muted">{T.availP}</p>
      </div>
      <IsoDrawing units={units} l={l} class="avail-drawing" />
      <ul class="types">
        {types.map((t) => (
          <li>
            <a href={typeHref(t)}>
              {sample(t) && <img class="plan" src={sample(t)} alt="" width="128" height="96" loading="lazy" decoding="async" />}
              <span class="t-name">{typeName(t)}</span>
              {t.surface && <span class="t-surf num">{t.surface.min === t.surface.max ? t.surface.min : `${t.surface.min}${dash}${t.surface.max}`} m²</span>}
              <span class="t-av">{t.available.length ? `${t.available.length} ${c('available', l)}` : T.none}</span>
              <span class="t-price num">{t.priceFrom ? `${c('from', l)} ${formatAmount(t.priceFrom)}` : ''}</span>
              <svg class="arrow" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </a>
          </li>
        ))}
      </ul>
      <p class="avail-all"><a class="btn" href={href('units', l)}>{T.allUnits}</a></p>
    </div>
  </section>

  {photos[2] && (
    <section class="bleed">
      <Photo src={photos[2].url} alt={photoAlt(photos[2].url, l, photos[2].alt)} width={1920} height={820} sizes="100vw" mobile={{ width: 4, height: 5 }} />
      <p class="bleed-line wrap">{T.outdoorLine}</p>
    </section>
  )}

  <section class="wrap section place">
    <div class="place-text">
      <h2 class="h2">{T.placeH}</h2>
      <p class="lede">{T.placeP}</p>
      {near.length > 0 && (
        <ul class="near">
          {near.map((n) => <li><span>{n.name}</span><span class="num">{n.d}</span></li>)}
        </ul>
      )}
      {near.length > 0 && <p class="muted small">{T.crow}</p>}
      <p><a class="link" href={href('location', l)}>{T.morePlace}</a></p>
    </div>
    <Photo class="place-photo" src={PHOTOS.fromBre.url} alt={PHOTOS.fromBre.alt[l]} width={1100} height={800} sizes="(max-width: 860px) 100vw, 55vw" />
  </section>

  <section class="sales">
    <div class="wrap section sales-grid">
      <div>
        <h2 class="h2">{T.salesH}</h2>
        <p class="lede">{T.salesP}</p>
        <p class="actions"><a class="btn" href={href('contact', l)}>{c('writeUs', l)}</a></p>
      </div>
      <div class="sales-people">
        {site.agent && <AgentCard agent={site.agent} l={l} />}
        <div class="office">
          <p class="o-name">{team?.name ?? org.name}</p>
          {team?.address && <p class="muted">{team.address.street}, {team.address.postcode} {team.address.city}</p>}
          {team?.phone && <p><a href={tel(team.phone)} class="num">{team.phone}</a></p>}
          {team?.email && <p><a href={`mailto:${team.email}`}>{team.email}</a></p>}
        </div>
      </div>
    </div>
  </section>
</Site>

<style>
  .hero { padding: 12px 16px 0; }
  .frame { position: relative; border-radius: var(--radius-frame); overflow: hidden; height: min(calc(100svh - var(--header-h) - 28px), 860px); min-height: 520px; background: var(--stone); }
  .frame :global(picture), .frame :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-text {
    position: absolute; inset: auto 0 0 0; padding: clamp(28px, 5vw, 72px); padding-top: 160px; color: #fff;
    background: linear-gradient(to top, rgb(24 20 15 / 0.72), rgb(24 20 15 / 0.42) 55%, rgb(24 20 15 / 0));
    display: grid; gap: 18px; justify-items: start;
  }
  .hero-text .h1 { max-width: 12ch; }
  .hero-text .lede { color: #fff; max-width: 36ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .hero-ghost { background: transparent; color: #fff; border-color: rgb(255 255 255 / 0.7); }
  .hero-ghost:hover { background: rgb(255 255 255 / 0.12); border-color: #fff; }

  .figures dl { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0; border-bottom: 1px solid var(--line); }
  .figures div { padding: 28px 20px 30px 0; }
  .figures div + div { padding-left: 24px; border-left: 1px solid var(--line); }
  .figures dt { font-size: 0.875rem; color: var(--muted); margin-bottom: 6px; }
  .figures dd { margin: 0; font: 400 clamp(1.5rem, 1.2rem + 1vw, 2.25rem)/1.1 var(--serif); }
  .figures small { font: 500 0.875rem/1 var(--sans); color: var(--muted); }

  .project { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(40px, 7vw, 120px); align-items: center; }
  .project-photo { max-width: 460px; justify-self: end; width: 100%; }
  .project-photo :global(picture) { display: block; aspect-ratio: 10 / 13; }
  .project-text { display: grid; gap: 28px; max-width: 620px; }
  .credits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 8px 0 0; padding-top: 20px; border-top: 1px solid var(--line); }
  .credits dt { font-size: 0.875rem; color: var(--muted); }
  .credits dd { margin: 2px 0 0; }

  .avail { background: var(--paper); border-block: 1px solid var(--line); }
  .avail-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-areas: 'head head' 'draw list' 'draw all'; gap: 32px clamp(32px, 5vw, 80px); align-items: start; }
  .avail-head { grid-area: head; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 40px; }
  .avail-head p { max-width: 42ch; }
  .avail-grid :global(.avail-drawing) { grid-area: draw; }
  .types { grid-area: list; list-style: none; border-top: 1px solid var(--line-strong); }
  .types li { border-bottom: 1px solid var(--line); }
  .types a { display: grid; grid-template-columns: 96px minmax(0, 1fr) auto 18px; grid-template-areas: 'plan name price arrow' 'plan meta av arrow'; gap: 2px 16px; align-items: center; padding: 14px 0; text-decoration: none; }
  .types a:hover .t-name { text-decoration: underline; text-underline-offset: 0.18em; }
  .plan { grid-area: plan; width: 96px; height: 72px; object-fit: contain; background: #fff; border: 1px solid var(--line); border-radius: 6px; }
  .t-name { grid-area: name; font: 400 1.375rem/1.1 var(--serif); }
  .t-surf { grid-area: meta; font-size: 0.9375rem; color: var(--muted); }
  .t-av { grid-area: av; font-size: 0.875rem; color: var(--muted); justify-self: end; }
  .t-price { grid-area: price; font-weight: 600; justify-self: end; }
  .arrow { grid-area: arrow; color: var(--muted); }
  .avail-all { grid-area: all; }

  .bleed { position: relative; }
  .bleed :global(picture) { display: block; aspect-ratio: 1920 / 820; }
  .bleed-line { position: relative; padding-block: 28px 0; font: 400 var(--step-2)/1.2 var(--serif); max-width: calc(30ch + 2 * var(--gutter)); margin-left: 0; }
  @media (min-width: 1400px) { .bleed-line { margin-left: calc((100vw - var(--max)) / 2 - var(--gutter)); } }

  .place { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .place-text { display: grid; gap: 22px; }
  .near { list-style: none; border-top: 1px solid var(--line); }
  .near li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .small { font-size: 0.875rem; margin-top: -12px; }
  .place :global(.place-photo) { display: block; aspect-ratio: 11 / 8; border-radius: var(--radius-card); overflow: hidden; }

  .sales { background: var(--paper); border-top: 1px solid var(--line); }
  .sales-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); }
  .sales-grid .lede { margin-top: 20px; }
  .sales-people { display: grid; gap: 36px; }
  .office { padding-top: 24px; border-top: 1px solid var(--line); display: grid; gap: 2px; }
  .office a { display: inline-block; padding-block: 6px; }
  .o-name { font: 400 1.375rem/1.2 var(--serif); }

  @media (max-width: 1100px) { .figures dl { grid-template-columns: repeat(3, minmax(0, 1fr)); } .figures div:nth-child(4) { border-left: 0; padding-left: 0; } }
  @media (max-width: 860px) {
    .project, .place, .sales-grid { grid-template-columns: 1fr; }
    .project-photo { justify-self: start; max-width: 340px; }
    .avail-grid { grid-template-columns: 1fr; grid-template-areas: 'head' 'list' 'all' 'draw'; }
  }
  @media (max-width: 640px) {
    .hero { padding: 8px 8px 0; }
    .frame { height: auto; min-height: 0; aspect-ratio: 4 / 5; max-height: calc(100svh - var(--header-h) - 90px); border-radius: 16px; }
    .hero-text { padding: 22px; padding-top: 120px; gap: 12px; }
    .hero-text .lede { font-size: 1.0625rem; }
    .figures dl { grid-template-columns: 1fr 1fr; }
    .figures div, .figures div + div { padding: 18px 12px 18px 0; border-left: 0; border-bottom: 1px solid var(--line); }
    .figures div:nth-child(even) { padding-left: 16px; border-left: 1px solid var(--line); }
    .figures div:last-child { grid-column: 1 / -1; border-bottom: 0; padding-left: 0; border-left: 0; }
    .bleed :global(picture) { aspect-ratio: 4 / 5; }
    .types a { grid-template-columns: 56px minmax(0, 1fr) auto; grid-template-areas: 'plan name price' 'plan meta av'; }
    .plan { width: 56px; height: 44px; }
    .arrow { display: none; }
    .credits { grid-template-columns: 1fr; }
  }
</style>
