---
/** Documents: the PDFs we generate from our own HTML (fixture only: the API has no documents yet), per language. */
import { img } from '@realadvisor/sites-kit-core/image';
import Site from '../layouts/Site.astro';
import { loadSite } from '../lib/data';
import { href, type L } from '../lib/routes';
import { c } from '../lib/copy';
import { DOCS, docsFor } from '../lib/docs';

interface Props { l: L }
const { l } = Astro.props;
const site = await loadSite();
const { dev } = site;
const files = docsFor(l);
const date = new Intl.DateTimeFormat(l === 'de' ? 'de-CH' : 'it-CH', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(DOCS.updated));
const T = {
  it: {
    title: `Documenti: brochure, listino prezzi e piante | ${dev.title}`,
    h1: 'Documenti',
    intro: 'Brochure, listino prezzi e piante indicative da scaricare. Il capitolato completo lo inviamo su richiesta.',
    updated: `Aggiornati al ${date}.`,
    pages: (n: number) => `${n} ${n === 1 ? 'pagina' : 'pagine'}`,
    ask: 'Capitolato e documenti tecnici su richiesta',
  },
  de: {
    title: `Dokumente: Broschüre, Preisliste und Grundrisse | ${dev.title}`,
    h1: 'Dokumente',
    intro: 'Broschüre, Preisliste und indikative Grundrisse zum Herunterladen. Den vollständigen Baubeschrieb senden wir auf Anfrage.',
    updated: `Stand ${date}.`,
    pages: (n: number) => `${n} ${n === 1 ? 'Seite' : 'Seiten'}`,
    ask: 'Baubeschrieb und technische Unterlagen auf Anfrage',
  },
}[l];
const kb = (b: number) => (b > 1024 * 1024 ? `${(b / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`);
const cover = dev.photos[0];
---
<Site site={site} l={l} route="documents" title={T.title} description={T.intro} image={cover ? img(cover.url, { w: 1200, h: 630 }) : undefined}>
  <div class="wrap grid">
    <div class="head">
      <h1 class="h1">{T.h1}</h1>
      <p class="lede">{T.intro}</p>
      <p class="muted">{T.updated}</p>
    </div>
    <ul class="docs">
      {files.map((d) => (
        <li>
          <a href={d.href} download>
            <span class="t">{d.title}</span>
            <span class="d muted">{d.description}</span>
            <span class="m num">PDF · {T.pages(d.pages)} · {kb(d.bytes)}</span>
            <svg width="22" height="22" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0 3.2-3.2M8 10 4.8 6.8M3 13h10" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </li>
      ))}
      <li class="ask"><a href={href('contact', l)}><span class="t">{T.ask}</span><span class="d muted">{c('writeUs', l)}</span></a></li>
    </ul>
  </div>
</Site>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 112px); padding-block: clamp(40px, 6vw, 88px) var(--section); align-items: start; }
  .head { display: grid; gap: 20px; }
  .docs { list-style: none; border-top: 1px solid var(--line-strong); }
  .docs li { border-bottom: 1px solid var(--line); }
  .docs a { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 't icon' 'd icon' 'm icon'; gap: 4px 24px; align-items: center; padding: 26px 4px; text-decoration: none; }
  .docs a:hover .t { text-decoration: underline; text-underline-offset: 0.15em; }
  .t { grid-area: t; font: 400 var(--step-2)/1.1 var(--serif); }
  .d { grid-area: d; }
  .m { grid-area: m; font-size: 0.875rem; color: var(--muted); }
  .docs svg { grid-area: icon; color: var(--accent-strong); }
  .ask .t { font-size: var(--step-1); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
