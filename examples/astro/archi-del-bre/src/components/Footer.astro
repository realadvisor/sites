---
/**
 * Footer: the development and its address, the sales office (primary team),
 * the people behind it, nav, languages and the legal links
 * in the page's language (kit legalPath / privacyPath).
 */
import { legalPath, privacyPath, t } from '@realadvisor/sites-kit/i18n';
import type { Site } from '../lib/data';
import { href, LOCALE, tel, type L } from '../lib/routes';
import { c } from '../lib/copy';

interface Props { site: Site; l: L; alternates?: { lang: string; href: string }[] }
const { site, l, alternates } = Astro.props;
const { dev, team, org } = site;
const credits = [
  [c('developer', l), dev.developer?.name],
  [c('architect', l), dev.architect?.name],
  [c('contractor', l), dev.general_contractor?.name],
].filter((x): x is [string, string] => !!x[1]);
const a = dev.address;
const office = team?.address ?? org.address;
const langs = (['it', 'de'] as const).map((x) => ({ l: x, href: alternates?.find((y) => y.lang === LOCALE[x])?.href ?? href('home', x), name: x === 'it' ? 'Italiano' : 'Deutsch' }));
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="intro">
      <p class="name">{dev.title}</p>
      <p class="muted">{[a.street, [a.postcode, a.city].filter(Boolean).join(' ')].filter(Boolean).join(', ')}</p>
    </div>
    <div>
      <h2 class="label">{c('salesOffice', l)}</h2>
      <p>{team?.name ?? org.name}</p>
      {office && <p class="muted">{office.street}, {office.postcode} {office.city}</p>}
      <p class="lines">
        {team?.phone && <a href={tel(team.phone)}>{team.phone}</a>}
        {team?.email && <a href={`mailto:${team.email}`}>{team.email}</a>}
      </p>
    </div>
    {credits.length > 0 && (
      <dl class="credits">
        {credits.map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
      </dl>
    )}
    <nav aria-label={c('mainNav', l)} class="links">
      <ul>
        <li><a href={href('units', l)}>{c('units', l)}</a></li>
        <li><a href={href('location', l)}>{c('location', l)}</a></li>
        <li><a href={href('gallery', l)}>{c('gallery', l)}</a></li>
        <li><a href={href('documents', l)}>{c('documents', l)}</a></li>
        <li><a href={href('contact', l)}>{c('contact', l)}</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap base">
    <p>© {new Date().getFullYear()} {org.name}</p>
    <ul class="legal">
      <li><a href={legalPath(LOCALE[l])}>{t('legalNotice', {}, l)}</a></li>
      <li><a href={privacyPath(LOCALE[l])}>{t('privacyPolicy', {}, l)}</a></li>
    </ul>
    <ul class="legal" aria-label={c('language', l)}>
      {langs.map((x) => <li><a href={x.href} hreflang={LOCALE[x.l]} lang={LOCALE[x.l]} aria-current={x.l === l ? 'true' : undefined}>{x.name}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--sand); padding-top: clamp(56px, 7vw, 96px); font-size: 0.9375rem; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 0.8fr; gap: 40px; padding-bottom: 56px; }
  .name { font: 400 var(--step-2)/1.05 var(--serif); margin-bottom: 10px; }
  .label { font: 600 0.8125rem/1.3 var(--sans); color: var(--muted); margin-bottom: 8px; }
  .lines { display: grid; gap: 2px; margin-top: 10px; }
  .lines a, .links a, .legal a { text-decoration: none; display: inline-block; padding-block: 4px; }
  .lines a:hover, .links a:hover, .legal a:hover { text-decoration: underline; }
  .credits { display: grid; gap: 14px; margin: 0; }
  .credits dd { margin: 0; }
  .links ul, .legal { list-style: none; }
  .links ul { display: grid; gap: 2px; }
  .base { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; padding-block: 18px 22px; border-top: 1px solid var(--line-strong); color: var(--muted); font-size: 0.875rem; }
  .base p { margin-right: auto; }
  .legal { display: flex; gap: 20px; }
  .legal a { min-height: 44px; display: inline-flex; align-items: center; }
  .legal a[aria-current] { color: var(--text); }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; gap: 28px; } .base p { width: 100%; } }
</style>
