---
/**
 * Document shell: <head> SEO tags only (title, description, canonical,
 * hreflang, OG, JSON-LD, favicons). Every page passes its own og:image.
 */
import { analyticsId } from '@realadvisor/sites-kit-core/env';
import { canonicalUrl, safeJsonLd } from '@realadvisor/sites-kit-core/seo';
import ConsentBanner from '@realadvisor/sites-kit-astro/components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  /** Absolute URL, ~1200x630: the page's main photo. */
  image?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Every language version of this page, this one included (x-default = the first). */
  alternates?: { lang: string; href: string }[];
  locale: string;
}
const { title, description, image, jsonLd, noindex, alternates, locale } = Astro.props;
const base = Astro.site ?? Astro.url;
const canonical = canonicalUrl(Astro.url, base);
const gaId = analyticsId();
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates?.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, base).href} />)}
    {alternates?.[0] && <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, base).href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Guard: nothing may undo `hidden` (an invisible open menu layer blocks every click). Never remove. */}
    <style is:inline>[hidden]{display:none!important}</style>
    {jsonLd && <script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
    {gaId && <ConsentBanner analyticsId={gaId} locale={locale} />}
  </body>
</html>
