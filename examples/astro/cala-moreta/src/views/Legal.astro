---
// Legal notice and privacy policy: text only from the kit (built from the
// agency data), in the site's layout. Never edit the words.
import LegalContent from '@realadvisor/sites-kit-astro/components/LegalContent.astro';
import { agencyOf } from '@realadvisor/sites-kit-core/agency';
import { legalNotice, privacyPolicy } from '@realadvisor/sites-kit-core/legal';
import { analyticsId } from '@realadvisor/sites-kit-core/env';
import { t } from '@realadvisor/sites-kit-core/i18n';
import Site from '../layouts/Site.astro';
import { agency } from '../lib/data';
import { alternates, type Lang } from '../lib/i18n';

interface Props { lang: Lang; page: 'legal' | 'privacy' }
const { lang, page } = Astro.props;
const ag = (({ org, team }) => agencyOf(org, team))(await agency());
const title = t(page === 'legal' ? 'legalNotice' : 'privacyPolicy', {}, lang);
const sections = page === 'legal' ? legalNotice(ag, lang) : privacyPolicy(ag, { analytics: !!analyticsId() }, lang);
---
<Site lang={lang} title={`${title} | ${ag.name}`} description={`${title} ${ag.name}`} alternates={alternates(page)} switchToHome>
  <header class="phead wrap"><h1 class="display-l">{title}</h1></header>
  <div class="wrap doc"><LegalContent sections={sections} class="doc-body" /></div>
</Site>
<style>
  .doc { padding-bottom: var(--section); }
  .doc :global(.doc-body) { max-width: 760px; display: grid; gap: 48px; border-top: 1px solid var(--text); padding-top: 40px; }
  .doc :global(.doc-body h2) { font: 300 1.75rem/1.2 var(--font-display); margin-bottom: 16px; }
  .doc :global(.doc-body dl) { margin: 0; }
  .doc :global(.doc-body dl div) { display: grid; grid-template-columns: 220px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .doc :global(.doc-body dt) { color: var(--muted); }
  .doc :global(.doc-body dd) { margin: 0; overflow-wrap: anywhere; }
  .doc :global(.doc-body a) { color: var(--accent-strong); }
  .doc :global(.doc-body p + p) { margin-top: 14px; }
  @media (max-width: 640px) { .doc :global(.doc-body dl div) { grid-template-columns: 1fr; gap: 2px; } }
</style>
