---
import Site from '../layouts/Site.astro';
import Photo from '../components/Photo.astro';
import { PHOTOS, photoOg } from '../lib/photos';
import AgentPortrait from '../components/AgentPortrait.astro';
import { agency, agentSlug, sites } from '../lib/data';
import { UI, alternates, fill, href, type Lang } from '../lib/i18n';
import { languageList } from '../lib/format';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = UI[lang];
const [ag, agents] = await Promise.all([agency(), sites.agents()]);
const name = ag.team?.name ?? ag.org.name;
const town = ag.team?.address.city ?? ag.org.address?.city ?? '';
const langs = languageList([...new Set(agents.flatMap((a) => a.languages ?? []))], lang);

// Site copy (not API data): the agency's way of working, and the usual steps
// of a purchase in Spain for a buyer from abroad. General steps, no figures.
const COPY = {
  es: {
    story: [
      'Conocemos estas casas porque vivimos aquí. Sabemos qué cala se llena en agosto, qué camino se corta con la lluvia y qué masía tiene el mejor pozo.',
      'Trabajamos con pocas casas a la vez para poder enseñarlas bien. Cada una tiene un agente que la ha visitado, que conoce a los propietarios y que responde al teléfono.',
      'Muchos compradores viven fuera de España. Atendemos en {langs} y les ponemos en contacto con abogados y gestores independientes de la zona.',
    ],
    steps: [
      ['NIE', 'Solicite el número de identificación de extranjero. Lo pedirán el banco, la notaría y Hacienda.'],
      ['Banco', 'Abra una cuenta en un banco español para los pagos de la compra y los recibos de la casa.'],
      ['Abogado', 'Elija un abogado independiente. Revisará la nota simple del Registro, las licencias y las cargas.'],
      ['Arras', 'Firme el contrato de arras con una señal. Fija el precio, el plazo y las condiciones de la compra.'],
      ['Notaría', 'La escritura se firma ante notario: se paga el resto del precio y recibe las llaves.'],
      ['Registro', 'Se pagan los impuestos de la compra y la escritura se inscribe a su nombre en el Registro de la Propiedad.'],
    ],
    cta: 'Escribir a la oficina',
  },
  en: {
    story: [
      'We know these houses because we live here. We know which cove fills up in August, which track floods after rain and which farmhouse has the best well.',
      'We work with few houses at a time so we can show them properly. Each one has an agent who has visited it, knows the owners and answers the phone.',
      'Many buyers live outside Spain. We work in {langs} and put them in touch with independent local lawyers and gestores.',
    ],
    steps: [
      ['NIE', 'Apply for the foreigner’s identification number. The bank, the notary and the tax office will ask for it.'],
      ['Bank', 'Open an account with a Spanish bank for the purchase payments and the house bills.'],
      ['Lawyer', 'Choose an independent lawyer. They will review the Land Registry extract (nota simple), licences and charges.'],
      ['Deposit', 'Sign the deposit contract (arras). It sets the price, the timing and the conditions of the purchase.'],
      ['Notary', 'The deed is signed before a notary: the balance is paid and you receive the keys.'],
      ['Registry', 'The purchase taxes are paid and the deed is recorded in your name at the Land Registry.'],
    ],
    cta: 'Write to the office',
  },
}[lang];
const photo = PHOTOS.aboutBand;
---
<Site lang={lang} current="about" title={`${ui.nav.about} | ${name}`} description={fill(ui.aboutLead, { name, town })}
  image={photoOg(PHOTOS.about, Astro.url)} alternates={alternates('about')}>
  <header class="phead wrap">
    <h1 class="display-l">{fill(ui.aboutH1, { town })}</h1>
  </header>

  <section class="wrap story">
    <div class="story-photo"><Photo photo={PHOTOS.about} lang={lang} priority landscapeAt="(max-width: 900px)" sizes="(min-width: 900px) 42vw, 100vw" /></div>
    <div class="story-text">
      <p class="story-lead">{fill(ui.aboutLead, { name, town })}</p>
      {COPY.story.map((p) => <p>{fill(p, { langs })}</p>)}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="process-h">
    <div class="section-head">
      <div>
        <h2 id="process-h" class="display-l">{ui.processTitle}</h2>
        <p class="lead">{ui.processLead}</p>
      </div>
    </div>
    <ol class="process">
      {COPY.steps.map(([word, line]) => (
        <li><span class="p-word">{word}</span><span class="p-line">{line}</span></li>
      ))}
    </ol>
  </section>

  <section class="band">
    <Photo photo={photo} lang={lang} decorative />
  </section>

  {agents.length > 0 && (
    <section class="section wrap">
      <div class="section-head">
        <h2 class="display-m">{ui.teamTitle}</h2>
        <a class="link" href={href('team', lang)}>{ui.teamAll} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="team-row">
        {agents.map((a) => (
          <li>
            <AgentPortrait agent={a} sizes="(min-width: 861px) 22vw, 70vw" class="team-photo" />
            <h3 class="team-name"><a href={href('team', lang, agentSlug(a))}>{a.first_name} {a.last_name}</a></h3>
            {a.title && <p>{a.title}</p>}
            {a.languages?.length ? <p class="team-langs">{ui.speaks} {languageList(a.languages, lang)}</p> : null}
            {a.phone && <p><a class="num" href={`tel:${a.phone.replace(/[^\d+]/g, '')}`}>{a.phone}</a></p>}
            {a.email && <p><a href={`mailto:${a.email}`}>{a.email}</a></p>}
          </li>
        ))}
      </ul>
      <p class="about-cta"><a class="cta cta-accent" href={href('contact', lang)}>{COPY.cta}</a></p>
    </section>
  )}
</Site>
<style>
  .story { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(40px, 7vw, 120px); align-items: start; padding-bottom: var(--section); }
  .story-photo { aspect-ratio: 9 / 11; overflow: hidden; }
  .story-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .story-text { display: grid; gap: 22px; font-size: 1.125rem; max-width: 60ch; }
  .story-lead { font: 300 clamp(1.5rem, 2.4vw, 2.125rem)/1.3 var(--font-display); }
  @media (max-width: 900px) { .story { grid-template-columns: 1fr; } .story-photo { aspect-ratio: 4 / 3; } }
  .process { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--text); }
  .process li { padding-block: 20px; border-bottom: 1px solid var(--line); max-width: 72ch; }
  .p-word { font: 300 1.375rem/1.3 var(--font-display); margin-right: .6em; }
  .p-line { color: var(--muted); font-size: 1.0625rem; }
  @media (min-width: 900px) { .process li { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 24px; align-items: baseline; max-width: none; } }
  .band { aspect-ratio: 16 / 7; overflow: hidden; }
  .band :global(img), .band :global(picture) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 760px) { .band { aspect-ratio: 8 / 9; } }
  .team-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; border-top: 1px solid var(--line); }
  .team-row li { display: grid; gap: 2px; align-content: start; padding-top: 28px; font-size: .9375rem; }
  .team-row a { text-decoration: none; overflow-wrap: anywhere; }
  .team-row a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .team-row :global(.team-photo) { margin-bottom: 14px; max-width: 280px; }
  .team-name { font: 300 1.625rem/1.1 var(--font-display); margin-bottom: 6px; }
  .team-name a { text-decoration: none; }
  .team-langs { color: var(--muted); font-size: .9375rem; }
  .about-cta { margin-top: clamp(48px, 6vw, 80px); }
</style>
