---
import Site from '../layouts/Site.astro';
import AgentPortrait from '../components/AgentPortrait.astro';
import { agency, agentSlug, sites } from '../lib/data';
import { UI, alternates, fill, href, type Lang } from '../lib/i18n';
import { languageList } from '../lib/format';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = UI[lang];
const [ag, agents, all] = await Promise.all([agency(), sites.agents(), sites.allListings({ status: 'available' })]);
const name = ag.team?.name ?? ag.org.name;
const town = ag.team?.address.city ?? ag.org.address?.city ?? '';
const countOf = (id: string) => all.filter((l) => l.agent?.id === id).length;
const houses = (n: number) => (lang === 'es' ? (n === 1 ? '1 casa' : `${n} casas`) : n === 1 ? '1 house' : `${n} houses`);
---
<Site lang={lang} current="team" title={`${ui.teamH1} | ${name}`} description={fill(ui.teamLead, { town, n: agents.length })} alternates={alternates('team')}>
  <header class="phead wrap">
    <h1 class="display-l">{ui.teamH1}</h1>
    <p class="lead">{fill(ui.teamLead, { town, n: agents.length })}</p>
  </header>
  <section class="wrap team">
    <ul class="agents">
      {agents.map((a, i) => {
        const tel = a.phone?.replace(/[^\d+]/g, '');
        const n = countOf(a.id);
        return (
          <li class="agent">
            {a.photo?.url && (
              <a class="agent-photo" href={href('team', lang, agentSlug(a))} tabindex="-1" aria-hidden="true">
                <AgentPortrait agent={a} sizes="(min-width: 961px) 28vw, 80vw" priority={i === 0} />
              </a>
            )}
            <div class="agent-body">
              <h2 class="agent-name"><a href={href('team', lang, agentSlug(a))}>{a.first_name} {a.last_name}</a></h2>
              {a.title && <p class="agent-title">{a.title}</p>}
              {a.languages?.length ? <p class="agent-meta">{ui.speaks} {languageList(a.languages, lang)}</p> : null}
              {n > 0 && <p class="agent-meta">{houses(n)}</p>}
              <p class="agent-contact">
                {a.phone && <a class="num" href={`tel:${tel}`}>{a.phone}</a>}
                {a.email && <a href={`mailto:${a.email}`}>{a.email}</a>}
              </p>
              <a class="link" href={href('team', lang, agentSlug(a))}>{ui.agentProfile} <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          </li>
        );
      })}
    </ul>
  </section>
  <section class="band">
    <div class="wrap band-in">
      <h2 class="display-m">{ui.sellTitle}</h2>
      <p class="band-actions">
        <a class="cta cta-light" href={href('sell', lang)}>{ui.sellCta}</a>
        <a class="cta cta-light" href={href('contact', lang)}>{ui.writeUs}</a>
      </p>
    </div>
  </section>
</Site>
<style>
  .team { padding-bottom: var(--section); }
  .band { background: var(--accent); color: #fff; }
  .band-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 48px; padding-block: clamp(56px, 7vw, 96px); }
  .band-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .agents { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--text); }
  .agent { display: grid; align-content: start; padding: 48px 32px 48px 0; border-bottom: 1px solid var(--line); }
  .agent + .agent { padding-left: 32px; border-left: 1px solid var(--line); }
  .agent { gap: 28px; }
  .agent-photo { display: block; max-width: 340px; }
  .agent-body { display: grid; gap: 8px; justify-items: start; }
  .agent-name { font: 300 clamp(1.75rem, 2.6vw, 2.5rem)/1.05 var(--font-display); margin-bottom: 6px; }
  .agent-name a { text-decoration: none; }
  .agent-title, .agent-meta { color: var(--muted); }
  .agent-contact { display: grid; gap: 2px; margin: 12px 0 16px; }
  .agent-contact a { text-decoration: none; overflow-wrap: anywhere; }
  .agent-contact a:hover { text-decoration: underline; }
  @media (max-width: 960px) {
    .agents { grid-template-columns: 1fr; }
    .agent, .agent + .agent { padding: 36px 0; border-left: 0; }
  }
</style>
