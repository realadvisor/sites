---
import EnquiryForm from '@realadvisor/sites-kit/components/EnquiryForm.astro';
import { sanitizeHtml } from '@realadvisor/sites-kit';
import { img } from '@realadvisor/sites-kit/image';
import { featureLabel, offerTypeLabel, t } from '@realadvisor/sites-kit/i18n';
import { listingJsonLd, listingRef, listingTitle } from '@realadvisor/sites-kit/seo';
import Site from '../layouts/Site.astro';
import Gallery from '../components/Gallery.astro';
import ListingCard from '../components/ListingCard.astro';
import EnergyScale from '../components/EnergyScale.astro';
import AgentPortrait from '../components/AgentPortrait.astro';
import { agentSlug, energyClass, extraFacts, sites, slugify, towns, type Listing } from '../lib/data';
import { CONTENT_LANG, LOCALE_OF, UI, alternates, fill, href, type Lang } from '../lib/i18n';
import { price, surface, typeLabel } from '../lib/format';

interface Props { lang: Lang; listing: Listing }
const { lang, listing: l } = Astro.props;
const ui = UI[lang];
const locale = LOCALE_OF[lang];
const textLang = lang === CONTENT_LANG ? undefined : CONTENT_LANG;
const city = l.address.city;
const [sameCity, all] = await Promise.all([
  city ? sites.allListings({ city }) : Promise.resolve([] as Listing[]),
  sites.allListings(),
]);
const kind = typeLabel(l, lang);
const sold = l.status === 'sold';
const agent = l.agent;
const ref = listingRef(l);
const energy = energyClass(l.id); // fixture only: energy class
const extra = extraFacts(l.id); // fixture only: terrace surface, year built
const back = sold ? 'sold' : l.offer_type === 'buy' ? 'buy' : 'rent';
const backLabel = sold ? ui.nav.sold : l.offer_type === 'buy' ? ui.nav.buy : ui.nav.rent;
const similar = sameCity.filter((x) => x.id !== l.id && x.status === 'available').slice(0, 3);
const hasArea = !!city && towns(all).some((tw) => tw.slug === slugify(city));
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const title = `${listingTitle(l, sameCity)} | ${price(l, lang)}`;
const facts: [string, string][] = [
  [ui.type, kind],
  [t('offer', {}, lang), offerTypeLabel(l.offer_type, locale)],
  ...(city ? [[ui.town, city] as [string, string]] : []),
  ...(l.bedrooms ? [[ui.bedrooms, String(l.bedrooms)] as [string, string]] : []),
  ...(l.bathrooms ? [[ui.bathrooms, String(l.bathrooms)] as [string, string]] : []),
  ...(l.rooms ? [[ui.rooms, String(l.rooms)] as [string, string]] : []),
  ...(l.living_surface ? [[ui.living, surface(l.living_surface)] as [string, string]] : []),
  ...(l.land_surface ? [[ui.land, surface(l.land_surface)] as [string, string]] : []),
  ...(extra.terrace ? [[ui.terrace, surface(extra.terrace)] as [string, string]] : []), // fixture only: terrace_surface
  ...(extra.yearBuilt ? [[ui.yearBuilt, String(extra.yearBuilt)] as [string, string]] : []), // fixture only: year_built
  ...(energy ? [[ui.energy, energy] as [string, string]] : []), // fixture only: energy class
];
const keyFacts = [
  l.bedrooms ? [String(l.bedrooms), ui.bedrooms] : null,
  l.bathrooms ? [String(l.bathrooms), ui.bathrooms] : null,
  l.living_surface ? [surface(l.living_surface), ui.living] : null,
  l.land_surface ? [surface(l.land_surface), ui.land] : null,
].filter(Boolean) as [string, string][];
const osm = l.address.lat != null && l.address.lng != null
  ? `https://www.openstreetmap.org/?mlat=${l.address.lat}&mlon=${l.address.lng}#map=14/${l.address.lat}/${l.address.lng}`
  : undefined;
const tel = agent?.phone?.replace(/[^\d+]/g, '');
const desc = (l.description_text ?? '').replace(/\s+/g, ' ').trim();
---
<Site lang={lang} current={back} title={title} description={(desc || l.title).slice(0, 158)} noindex={sold}
  image={l.photos[0] && img(l.photos[0].url, { w: 1200, h: 630 })}
  alternates={alternates('listing', l.slug)} jsonLd={listingJsonLd(l, pageUrl)}>
  <div class="wrap lp">
    <nav class="crumbs" aria-label={backLabel}>
      <a href={href(back, lang)}><span aria-hidden="true">←</span> {fill(ui.backTo, { page: backLabel })}</a>
    </nav>

    <header class="lp-head">
      <div>
        <p class="lp-where">{[city, kind].filter(Boolean).join(' · ')}</p>
        <h1 class="display-l" lang={textLang}>{l.title}</h1>
      </div>
      <div class="lp-price">
        <p class="num lp-price-v">{price(l, lang)}</p>
        <p class="lp-ref">{ui.ref} {ref}</p>
      </div>
    </header>

    <Gallery photos={l.photos} alt={`${kind}${city ? `, ${city}` : ''}`} lang={lang} empty={kind} />

    {keyFacts.length > 0 && (
      <ul class="kf">
        {keyFacts.map(([v, k]) => <li><span class="kf-v num">{v}</span><span class="kf-k">{k}</span></li>)}
      </ul>
    )}

    <div class="lp-body">
      <div class="lp-main">
        {l.description && (
          <section class="lp-sec">
            {textLang && <p class="lp-note">{ui.descriptionLang}</p>}
            <div class="prose lp-desc" lang={textLang} set:html={sanitizeHtml(l.description)} />
          </section>
        )}

        <section class="lp-sec" aria-labelledby="facts-h">
          <h2 id="facts-h" class="lp-h">{ui.features}</h2>
          <dl class="spec-wide">
            {facts.map(([k, v]) => <div><dt>{k}</dt><dd class="num">{v}</dd></div>)}
          </dl>
          {l.features.length > 0 && (
            <ul class="feat">{l.features.map((f) => <li>{featureLabel(f, locale)}</li>)}</ul>
          )}
        </section>

        {energy && (
          <section class="lp-sec">
            <EnergyScale value={energy} lang={lang} />
          </section>
        )}

        {city && (
          <section class="lp-sec" aria-labelledby="loc-h">
            <h2 id="loc-h" class="lp-h">{ui.location}</h2>
            <p class="loc">{[l.address.postcode, city].filter(Boolean).join(' ')}</p>
            <p class="loc-links">
              {hasArea && <a class="link" href={href('areas', lang, slugify(city))}>{fill(ui.areaH1, { town: city })} <span class="arrow" aria-hidden="true">→</span></a>}
              {osm && <a class="link" href={osm} rel="noopener" target="_blank">{ui.openMap} <span aria-hidden="true">↗</span></a>}
            </p>
            {osm && <p class="lp-note">{ui.approx}</p>}
          </section>
        )}
      </div>

      <aside class="lp-aside">
        <div class="card-sticky">
          <p class="aside-k">{offerTypeLabel(l.offer_type, locale)}</p>
          <p class="num aside-price">{price(l, lang)}</p>
          {agent && (
            <div class="aside-agent">
              <p class="aside-k">{ui.yourAgent}</p>
              <AgentPortrait agent={agent} sizes="120px" class="aside-photo" />
              <p class="aside-name"><a href={href('team', lang, agentSlug(agent))}>{agent.first_name} {agent.last_name}</a></p>
            </div>
          )}
          {!sold && <a class="cta cta-accent" href="#enquiry">{ui.askVisit}</a>}
          {agent?.phone && <a class="cta cta-line num" href={`tel:${tel}`}>{agent.phone}</a>}
          {agent?.email && <a class="aside-mail" href={`mailto:${agent.email}`}>{agent.email}</a>}
        </div>
      </aside>
    </div>
  </div>

  {!sold && (
    <section class="ask" aria-labelledby="ask-h">
      <div class="wrap ask-in">
        <div class="ask-intro">
          <h2 id="ask-h" class="display-m">{ui.askAbout}</h2>
          {agent && (
            <div class="ask-agent">
              <AgentPortrait agent={agent} sizes="140px" class="ask-photo" />
              <p class="ask-name">{agent.first_name} {agent.last_name}</p>
              {agent.phone && <p><a class="num" href={`tel:${tel}`}>{agent.phone}</a></p>}
              {agent.email && <p><a href={`mailto:${agent.email}`}>{agent.email}</a></p>}
            </div>
          )}
        </div>
        <EnquiryForm listingId={l.id} agentId={agent?.id} agentName={agent?.first_name} locale={locale}
          message={t('interested', { title: l.title, ref }, lang)} class="ask-form" />
      </div>
    </section>
  )}

  {similar.length > 0 && city && (
    <section class="section wrap">
      <div class="section-head">
        <div><h2 class="display-m">{fill(ui.similar, { town: city })}</h2></div>
        {hasArea && <a class="link" href={href('areas', lang, slugify(city))}>{fill(ui.areaH1, { town: city })} <span class="arrow" aria-hidden="true">→</span></a>}
      </div>
      <ul class="grid3">{similar.map((x) => <li><ListingCard listing={x} lang={lang} /></li>)}</ul>
    </section>
  )}

  {!sold && (
    <div class="mbar" aria-label={ui.askAbout}>
      {agent?.phone && <a class="cta cta-line" href={`tel:${tel}`}>{ui.call}</a>}
      <a class="cta cta-accent" href="#enquiry">{ui.write}</a>
    </div>
  )}
</Site>

<style>
  .lp { padding-top: 28px; }
  .crumbs a { font-size: .875rem; color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--text); }
  .lp-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 18px 48px; padding-block: clamp(24px, 3vw, 40px); }
  .lp-head > div:first-child { display: grid; gap: 16px; max-width: 840px; }
  .lp-price { text-align: right; display: grid; gap: 6px; }
  .lp-price-v { font: 300 clamp(1.75rem, 3vw, 2.5rem)/1 var(--font-display); }
  .lp-ref { font-size: .8125rem; color: var(--muted); letter-spacing: .06em; }
  @media (max-width: 760px) { .lp-price { text-align: left; } }

  .kf { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); border-bottom: 1px solid var(--line); }
  .kf li { display: grid; gap: 6px; padding: 28px 24px 28px 0; }
  .kf li + li { padding-left: 24px; border-left: 1px solid var(--line); }
  .kf-v { font: 300 clamp(1.75rem, 2.6vw, 2.25rem)/1 var(--font-display); }
  .kf-k { font: 500 .6875rem/1.2 var(--font-body); letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 640px) {
    .kf { grid-template-columns: 1fr 1fr; }
    .kf li { padding: 20px 0; }
    .kf li + li { padding-left: 0; border-left: 0; }
    .kf li:nth-child(even) { padding-left: 20px; border-left: 1px solid var(--line); }
  }

  .lp-body { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: clamp(40px, 6vw, 112px); padding-block: clamp(40px, 5vw, 72px) var(--section); }
  .lp-main { display: grid; gap: clamp(40px, 4vw, 56px); align-content: start; }
  .lp-sec { display: grid; gap: 20px; }
  .lp-h { font: 300 clamp(1.5rem, 2.2vw, 1.875rem)/1.15 var(--font-display); }
  .lp-desc { font-size: 1.125rem; }
  .lp-desc :global(p:first-child) { font: 300 clamp(1.375rem, 2vw, 1.75rem)/1.4 var(--font-display); }
  .lp-note { font-size: .875rem; color: var(--muted); }
  .spec-wide { margin: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 40px; border-top: 1px solid var(--line); }
  .spec-wide div { display: flex; justify-content: space-between; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--line); }
  .spec-wide dt { color: var(--muted); }
  .spec-wide dd { margin: 0; text-align: right; }
  @media (max-width: 640px) { .spec-wide { grid-template-columns: 1fr; } }
  .feat { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .feat li { padding: 8px 16px; border: 1px solid var(--stone); border-radius: 999px; font-size: .9375rem; }
  .loc { font: 300 1.5rem/1.3 var(--font-display); }
  .loc-links { display: flex; flex-wrap: wrap; gap: 16px 32px; }

  .lp-aside { position: relative; }
  .card-sticky { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 16px; padding: 32px; background: var(--paper); border: 1px solid var(--line); }
  .aside-price { font: 300 2rem/1 var(--font-display); padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .aside-agent { display: grid; gap: 2px; padding-block: 4px 8px; }
  .lp-where { color: var(--muted); font-size: 1.0625rem; }
  .aside-k { font-size: .8125rem; color: var(--muted); }
  .aside-agent :global(.aside-photo) { width: 120px; margin-block: 6px; }
  .ask-agent :global(.ask-photo) { width: 140px; margin-bottom: 12px; }
  .aside-name { font: 300 1.25rem/1.2 var(--font-display); }
  .aside-name a { text-decoration: none; }
  .aside-name a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .aside-mail { font-size: .875rem; color: var(--muted); text-align: center; overflow-wrap: anywhere; }
  @media (max-width: 960px) {
    .lp-body { grid-template-columns: 1fr; }
    .lp-aside { display: none; }
  }

  .ask { background: var(--surface); scroll-margin-top: var(--header-h); }
  .ask-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 112px); padding-block: var(--section); }
  .ask-intro { display: grid; gap: 22px; align-content: start; }
  .ask-agent { display: grid; gap: 2px; padding-top: 12px; }
  .ask-agent a { text-decoration: none; }
  .ask-agent a:hover { text-decoration: underline; }
  .ask-name { font: 300 1.5rem/1.2 var(--font-display); margin-bottom: 4px; }
  @media (max-width: 860px) { .ask-in { grid-template-columns: 1fr; } }


  .mbar { display: none; }
  @media (max-width: 960px) {
    .mbar { position: sticky; bottom: 0; z-index: 30; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 10px; padding: 12px var(--gutter) max(12px, env(safe-area-inset-bottom)); background: var(--bg); border-top: 1px solid var(--line); }
    .mbar .cta { min-height: 48px; padding: 0 12px; }
  }
</style>
