---
/**
 * Listing card in two forms:
 * - `spec` (default): photo, town and type, title, then a key / value spec
 *   table split by hairlines (price, bedrooms, living area, plot).
 * - `overlay`: the search grid; full photo with name and price over it,
 *   bedrooms / bathrooms / area on the right.
 * Listing titles are Spanish: on English pages they carry lang="es".
 */
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import type { Listing } from '@realadvisor/sites-sdk/types';
import { CONTENT_LANG, UI, listingHref, type Lang } from '../lib/i18n';
import { price, specRows, surface, typeLabel } from '../lib/format';

interface Props {
  listing: Listing;
  lang: Lang;
  variant?: 'spec' | 'overlay';
  priority?: boolean;
  sizes?: string;
  heading?: 'h2' | 'h3';
}
const { listing: l, lang, variant = 'spec', priority = false, heading: H = 'h3' } = Astro.props;
const ui = UI[lang];
const url = listingHref(l, lang);
const photo = l.photos[0];
const kind = typeLabel(l, lang);
const textLang = lang === CONTENT_LANG ? undefined : CONTENT_LANG;
const sizes = Astro.props.sizes ?? (variant === 'overlay' ? '(min-width: 1360px) 650px, (min-width: 760px) 48vw, 100vw' : '(min-width: 1360px) 430px, (min-width: 760px) 31vw, 100vw');
const badge = l.status === 'sold' ? ui.sold : null;
const alt = photo?.alt || `${kind}, ${l.address.city ?? ''}`;
const kicker = [l.address.city, kind].filter(Boolean).join(' · ');
const facts = [
  l.bedrooms ? `${l.bedrooms} ${lang === 'es' ? 'dorm.' : 'bed'}` : '',
  l.bathrooms ? `${l.bathrooms} ${lang === 'es' ? (l.bathrooms === 1 ? 'baño' : 'baños') : l.bathrooms === 1 ? 'bath' : 'baths'}` : '',
  surface(l.living_surface),
].filter(Boolean);
---
{variant === 'spec' ? (
  <article class="card">
    <div class="card-photo">
      {photo
        ? <RaImage src={photo} alt={alt} width={720} height={540} sizes={sizes} priority={priority} />
        : <span class="card-nophoto" aria-hidden="true">{kind}</span>}
      {badge && <span class="card-badge">{badge}</span>}
    </div>
    <p class="card-kicker" title={kicker}>{kicker}</p>
    <H class="card-title"><a href={url} lang={textLang}>{l.title}</a></H>
    <dl class="spec">
      {specRows(l, lang, { price: l.status !== 'sold' }).map(([k, v]) => (
        <div><dt>{k}</dt><dd class="num">{v}</dd></div>
      ))}
    </dl>
  </article>
) : (
  <article class="ocard">
    {photo
      ? <RaImage src={photo} alt={alt} width={800} height={600} sizes={sizes} priority={priority} />
      : <span class="card-nophoto" aria-hidden="true">{kind}</span>}
    <div class="ocard-body">
      <div class="ocard-main">
        <p class="ocard-kicker" title={kicker}>{kicker}</p>
        <H class="ocard-title"><a href={url} lang={textLang}>{l.title}</a></H>
        <p class="ocard-price num">{price(l, lang)}</p>
      </div>
      {facts.length > 0 && (
        <ul class="ocard-facts">{facts.map((f) => <li class="num">{f}</li>)}</ul>
      )}
    </div>
  </article>
)}

<style>
  .card { position: relative; display: grid; gap: 0; }
  .card-photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--surface); margin-bottom: 22px; }
  .card-photo :global(img), .ocard > :global(img), .ocard > :global(picture img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .card:hover .card-photo :global(img) { transform: scale(1.03); }
  .card-nophoto { display: grid; place-items: center; width: 100%; height: 100%; aspect-ratio: 4 / 3; background: var(--surface); color: var(--muted); font: 300 1.5rem var(--font-display); }
  .card-badge { position: absolute; left: 0; top: 18px; background: var(--paper); color: var(--text); padding: 8px 14px; font: 500 .6875rem/1 var(--font-body); letter-spacing: .2em; text-transform: uppercase; }
  .card-kicker { font-size: .9375rem; color: var(--muted); margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card-title { font: 300 clamp(1.375rem, 1.8vw, 1.75rem)/1.15 var(--font-display); margin-bottom: 18px; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; min-height: calc(2 * 1.15em); }
  .card-title a { text-decoration: none; }
  .card-title a::after { content: ''; position: absolute; inset: 0; }
  .card-title a:focus-visible { outline: none; }
  .card:has(a:focus-visible) { outline: 2px solid var(--accent-strong); outline-offset: 6px; }
  .spec { margin: 0; border-top: 1px solid var(--line); }
  .spec div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: .9375rem; }
  .spec dt { color: var(--muted); }
  .spec dd { margin: 0; text-align: right; }
  .spec div:first-child dd { font-weight: 500; }

  .ocard { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--sea); color: #fff; isolation: isolate; }
  .ocard > :global(img), .ocard > :global(picture) { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  .ocard > :global(picture img) { display: block; }
  .ocard::after { content: ''; position: absolute; inset: 35% 0 0; z-index: -1; background: linear-gradient(rgb(16 14 12 / 0), rgb(16 14 12 / .72)); pointer-events: none; }
  .ocard:hover > :global(img), .ocard:hover > :global(picture img) { transform: scale(1.03); }
  .ocard-body { position: absolute; inset: auto 0 0; display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding: clamp(18px, 2.4vw, 32px); text-shadow: 0 1px 12px rgb(0 0 0 / .3); }
  .ocard-main { min-width: 0; }
  .ocard-kicker { font-size: .875rem; margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ocard-title { font: 300 clamp(1.375rem, 2.2vw, 2.125rem)/1.08 var(--font-display); margin-bottom: 10px; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; min-height: calc(2 * 1.08em); }
  .ocard-title a { text-decoration: none; }
  .ocard-title a::after { content: ''; position: absolute; inset: 0; }
  .ocard-title a:focus-visible { outline: none; }
  .ocard:has(a:focus-visible) { outline: 2px solid var(--accent-strong); outline-offset: 4px; }
  .ocard-price { font-size: 1.0625rem; font-weight: 500; letter-spacing: .02em; }
  .ocard-facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; justify-items: end; font-size: .875rem; flex: none; }
  @media (max-width: 520px) {
    .ocard { aspect-ratio: 4 / 4.2; }
    .ocard-body { flex-direction: column; align-items: flex-start; gap: 10px; }
    .ocard-facts { display: flex; gap: 14px; justify-items: start; }
  }
</style>
