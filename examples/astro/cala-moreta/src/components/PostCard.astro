---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import { PHOTOS } from '../lib/photos';
import { UI, href, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';
interface Props { post: CollectionEntry<'blog'>; lang: Lang; heading?: 'h2' | 'h3'; priority?: boolean; /** Layout width of the card photo. */ sizes?: string }
const { post, lang, heading: H = 'h3', priority = false, sizes = '(min-width: 1360px) 430px, (min-width: 640px) 45vw, 100vw' } = Astro.props;
const d = post.data;
---
<article class="post">
  <div class="post-photo">
    <Photo photo={PHOTOS[d.cover]} lang={lang} landscapeAt sizes={sizes} priority={priority} />
  </div>
  <p class="post-meta"><span>{d.tag}</span><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date, lang)}</time></p>
  <H class="post-title"><a href={href('blog', lang, d.path)}>{d.title}</a></H>
  <p class="post-excerpt">{d.excerpt}</p>
  <span class="visually-hidden">{UI[lang].readMore}</span>
</article>
<style>
  .post { position: relative; display: grid; }
  .post-photo { aspect-ratio: 3 / 2; overflow: hidden; background: var(--stone); margin-bottom: 20px; }
  .post-photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .post:hover .post-photo :global(img) { transform: scale(1.03); }
  .post-meta { display: flex; gap: 14px; font-size: .875rem; color: var(--muted); margin-bottom: 8px; }
  .post-title { font: 300 clamp(1.375rem, 1.9vw, 1.75rem)/1.15 var(--font-display); margin-bottom: 12px; }
  .post-title a { text-decoration: none; }
  .post-title a::after { content: ''; position: absolute; inset: 0; }
  .post-title a:focus-visible { outline: none; }
  .post:has(a:focus-visible) { outline: 2px solid var(--accent-strong); outline-offset: 6px; }
  .post-excerpt { color: var(--muted); }
</style>
