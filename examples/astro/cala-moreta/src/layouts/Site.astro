---
/**
 * Site shell: fonts, tokens, header (three zones, language switch, phone
 * menu), footer with the legal links of the page language.
 */
import '@fontsource/fraunces/latin-300.css';
import '@fontsource/fraunces/latin-300-italic.css';
import '@fontsource/fraunces/latin-400.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import fraunces300 from '@fontsource/fraunces/files/fraunces-latin-300-normal.woff2?url';
import jost400 from '@fontsource/jost/files/jost-latin-400-normal.woff2?url';
import '@realadvisor/sites-kit-core/styles/form.css';
import '../styles/global.css';
import Base from './Base.astro';
import { t } from '@realadvisor/sites-kit-core/i18n';
import { agency } from '../lib/data';
import { LANGS, LOCALE_OF, UI, href, type Lang, type Route } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  alternates?: { lang: string; href: string }[];
  /** Header over the first photo (home, area pages). */
  overlay?: boolean;
  current?: Route;
  /**
   * Legal pages: the language switch goes to the other language's home, since
   * check:deploy fails any link from one language to the other's legal page.
   */
  switchToHome?: boolean;
}
const { lang, title, description, image, jsonLd, noindex, alternates, overlay = false, current, switchToHome = false } = Astro.props;
const ui = UI[lang];
const { org, team } = await agency();
const name = team?.name ?? org.name;
const locale = LOCALE_OF[lang];
const left: Route[] = ['buy', 'rent', 'sell', 'areas'];
const right: Route[] = ['team', 'about', 'blog', 'contact'];
const label = (r: Route) => (ui.nav as Record<string, string>)[r] ?? r;
const other = (l: Lang) => (switchToHome && l !== lang ? undefined : alternates?.find((a) => a.lang === LOCALE_OF[l])?.href) ?? href('home', l);
const tel = team?.phone?.replace(/[^\d+]/g, '');
const year = new Date().getFullYear();
const addr = org.address ?? team?.address;
---
<Base title={title} description={description} image={image} jsonLd={jsonLd} noindex={noindex} alternates={alternates} locale={locale}>
  <link slot="head" rel="preload" as="font" type="font/woff2" crossorigin href={fraunces300} />
  <link slot="head" rel="preload" as="font" type="font/woff2" crossorigin href={jost400} />
  <meta slot="head" name="theme-color" content="#f6f0e7" />
  <a class="skip" href="#main">{ui.skip}</a>
  <header class:list={['hdr', { 'hdr-overlay': overlay }]} data-header>
    <div class="hdr-in">
      <nav class="hdr-nav hdr-left" aria-label={ui.mainNav}>
        {left.map((r) => <a href={href(r, lang)} aria-current={current === r ? 'page' : undefined}>{label(r)}</a>)}
      </nav>
      <a class="mark" href={href('home', lang)}>
        <span class="mark-name">{name}</span>
        {addr?.city && <span class="mark-sub">{addr.city} · Costa Brava</span>}
      </a>
      <div class="hdr-right">
        <nav class="hdr-nav" aria-label={ui.nav.about}>
          {right.map((r) => <a href={href(r, lang)} aria-current={current === r ? 'page' : undefined}>{label(r)}</a>)}
        </nav>
        <nav class="langs" aria-label={ui.langSwitch}>
          {LANGS.map((l, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <a href={other(l)} hreflang={LOCALE_OF[l]} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
            </>
          ))}
        </nav>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label={ui.menu} data-menu-open>
          <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
          <span class="menu-label">{ui.menu}</span>
        </button>
      </div>
    </div>
  </header>

  <div class="menu" id="site-menu" data-menu role="dialog" aria-modal="true" aria-label={ui.menu}>
    <div class="menu-top">
      <span class="mark-name">{name}</span>
      <button class="menu-close" type="button" data-menu-close aria-label={ui.close}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" /></svg>
      </button>
    </div>
    <nav class="menu-nav" aria-label={ui.mainNav}>
      {[...left, 'sold' as Route, ...right].map((r) => <a href={href(r, lang)} aria-current={current === r ? 'page' : undefined}>{label(r)}</a>)}
    </nav>
    <div class="menu-foot">
      <nav class="langs" aria-label={ui.langSwitch}>
        {LANGS.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={other(l)} hreflang={LOCALE_OF[l]} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
          </>
        ))}
      </nav>
      {team?.phone && <a class="num" href={`tel:${tel}`}>{team.phone}</a>}
      {team?.email && <a href={`mailto:${team.email}`}>{team.email}</a>}
    </div>
  </div>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="ftr">
    <div class="wrap ftr-grid">
      <div class="ftr-brand">
        <a class="ftr-mark" href={href('home', lang)}>{name}</a>
        <p>{ui.footerTag}</p>
      </div>
      <div>
        <h2 class="ftr-h">{ui.footerVisit}</h2>
        {addr && (
          <address>
            {addr.street && <>{addr.street}<br /></>}
            {[addr.postcode, addr.city].filter(Boolean).join(' ')}
          </address>
        )}
        <p class="ftr-contact">
          {team?.phone && <a class="num" href={`tel:${tel}`}>{team.phone}</a>}
          {team?.email && <a href={`mailto:${team.email}`}>{team.email}</a>}
        </p>
      </div>
      <div>
        <h2 class="ftr-h">{ui.footerExplore}</h2>
        <ul>
          {(['buy', 'rent', 'sell', 'sold', 'areas'] as Route[]).map((r) => <li><a href={href(r, lang)}>{label(r)}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="ftr-h">{ui.footerAgency}</h2>
        <ul>
          {(['team', 'about', 'blog', 'contact'] as Route[]).map((r) => <li><a href={href(r, lang)}>{label(r)}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="wrap ftr-base">
      <p>© {year} {org.name}</p>
      <p class="ftr-legal">
        <a href={href('legal', lang)}>{t('legalNotice', {}, lang)}</a>
        <a href={href('privacy', lang)}>{t('privacyPolicy', {}, lang)}</a>
        <span class="langs">
          {LANGS.map((l, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <a href={other(l)} hreflang={LOCALE_OF[l]} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
            </>
          ))}
        </span>
      </p>
    </div>
  </footer>
</Base>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const open = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const set = (on: boolean) => {
    if (!menu || !open) return;
    menu.classList.toggle('is-open', on);
    open.setAttribute('aria-expanded', String(on));
    document.documentElement.classList.toggle('no-scroll', on);
    if (on) close?.focus();
    else open.focus();
  };
  open?.addEventListener('click', () => set(true));
  close?.addEventListener('click', () => set(false));
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) set(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) set(false);
  });
</script>

<style>
  .skip { position: absolute; left: 16px; top: -60px; z-index: 100; background: var(--sea); color: var(--paper); padding: 12px 18px; text-decoration: none; }
  .skip:focus { top: 12px; }
  main { display: block; outline: none; }
  :global(html.no-scroll) { overflow: hidden; }

  .hdr { position: sticky; top: 0; z-index: 40; height: var(--header-h); background: var(--bg); border-bottom: 1px solid var(--line); color: var(--text); transition: background-color .25s, color .25s, border-color .25s; }
  /* Over the first photo: scrolls away with it (no JS, never white on white). */
  .hdr-overlay { position: absolute; inset: 0 0 auto; background: transparent; border-color: rgb(255 255 255 / .22); color: #fff; }
  .hdr-overlay::before { content: ''; position: absolute; inset: 0 0 -60px; background: linear-gradient(rgb(20 18 15 / .55), rgb(20 18 15 / 0)); pointer-events: none; }
  .hdr-in { position: relative; height: 100%; max-width: 1560px; margin: 0 auto; padding-inline: var(--gutter); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; }
  .hdr-nav { display: flex; gap: clamp(16px, 2vw, 32px); }
  .hdr-nav a, .langs a { font: 500 .75rem/1 var(--font-body); letter-spacing: .2em; text-transform: uppercase; text-decoration: none; padding-block: 10px; border-bottom: 1px solid transparent; }
  .hdr-nav a:hover, .hdr-nav a[aria-current='page'] { border-bottom-color: currentColor; }
  .hdr-right { display: flex; align-items: center; justify-content: flex-end; gap: clamp(18px, 2.2vw, 36px); }
  .langs { display: flex; align-items: center; gap: 6px; }
  .langs span { opacity: .6; font-size: .75rem; }
  .langs a { padding-inline: 2px; }
  .langs a[aria-current] { border-bottom-color: currentColor; }
  .langs a:hover { border-bottom-color: currentColor; }
  .mark { display: grid; justify-items: center; gap: 4px; text-decoration: none; text-align: center; }
  .mark-name { font: 300 clamp(1.5rem, 2.2vw, 1.875rem)/1 var(--font-display); letter-spacing: .01em; white-space: nowrap; }
  .mark-sub { font: 500 .625rem/1 var(--font-body); letter-spacing: .3em; text-transform: uppercase; opacity: .8; white-space: nowrap; }
  .menu-btn { display: none; align-items: center; gap: 10px; min-height: 44px; min-width: 44px; padding: 0 4px; background: none; border: 0; color: inherit; cursor: pointer; font: 500 .75rem/1 var(--font-body); letter-spacing: .2em; text-transform: uppercase; }
  .menu-lines { display: grid; gap: 6px; width: 24px; }
  .menu-lines span { height: 1px; background: currentColor; }

  .menu { position: fixed; inset: 0; z-index: 60; background: var(--sea); color: var(--on-sea); display: flex; flex-direction: column; padding: 0 var(--gutter) max(28px, env(safe-area-inset-bottom)); visibility: hidden; pointer-events: none; opacity: 0; transition: opacity .2s, visibility 0s .2s; overflow-y: auto; }
  .menu.is-open { visibility: visible; pointer-events: auto; opacity: 1; transition: opacity .2s; }
  .menu-top { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgb(255 255 255 / .16); }
  .menu-close { width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 0; color: inherit; cursor: pointer; }
  .menu-nav { display: grid; padding-block: 24px; }
  .menu-nav a { font: 300 clamp(2rem, 8vw, 2.75rem)/1.15 var(--font-display); text-decoration: none; padding-block: 8px; }
  .menu-nav a[aria-current='page'] { font-style: italic; }
  .menu-foot { margin-top: auto; display: grid; gap: 12px; padding-top: 24px; border-top: 1px solid rgb(255 255 255 / .16); }
  .menu-foot a { text-decoration: none; color: var(--on-sea); }
  .menu-foot .langs a { padding-block: 12px; }

  @media (max-width: 1180px) {
    .hdr-nav { display: none; }
    .menu-btn { display: inline-flex; }
    .hdr-in { grid-template-columns: auto 1fr; }
    .mark { grid-column: 1; grid-row: 1; justify-items: start; text-align: left; }
    .hdr-right { grid-column: 2; }
  }
  @media (max-width: 560px) {
    .hdr-right > .langs, .menu-label { display: none; }
    .mark-sub { letter-spacing: .24em; }
  }

  .ftr { background: var(--sea); color: var(--on-sea); padding-top: clamp(64px, 8vw, 112px); }
  .ftr a { color: inherit; text-decoration: none; }
  .ftr a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .ftr-grid { display: grid; grid-template-columns: 1.4fr 1fr .8fr .8fr; gap: 48px; padding-bottom: clamp(48px, 6vw, 88px); }
  .ftr-mark { font: 300 clamp(2.25rem, 4vw, 3.5rem)/1 var(--font-display); display: inline-block; margin-bottom: 18px; }
  .ftr-brand p { color: var(--on-sea-muted); max-width: 30ch; }
  .ftr-h { font: 500 .75rem/1 var(--font-body); letter-spacing: .22em; text-transform: uppercase; color: var(--on-sea-muted); margin-bottom: 20px; }
  .ftr address { font-style: normal; margin-bottom: 14px; }
  .ftr-contact { display: grid; gap: 4px; }
  .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ftr-base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; padding-block: 28px 36px; position: relative; font-size: .875rem; color: var(--on-sea-muted); }
  .ftr-base::before { content: ''; position: absolute; top: 0; inset-inline: var(--gutter); border-top: 1px solid rgb(255 255 255 / .16); }
  .ftr-legal { display: flex; flex-wrap: wrap; gap: 8px 28px; align-items: center; }
  .ftr-legal a { padding-block: 6px; }
  @media (max-width: 900px) { .ftr-grid { grid-template-columns: 1fr 1fr; } .ftr-brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .ftr-grid { grid-template-columns: 1fr; gap: 36px; } }
</style>
