{
  "name": "arvel-promotion",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --port ${PORT:-4416}",
    "build": "astro build",
    "preview": "wrangler dev --port 4416",
    "check": "astro check && astro build",
    "screenshot": "sites-kit screenshot",
    "check:quality": "sites-kit check quality",
    "check:deploy": "sites-kit check deploy",
    "check:edge": "sites-kit check edge",
    "kit": "sites-kit",
    "plans": "node --experimental-strip-types --no-warnings scripts/plans.ts",
    "documents": "node --experimental-strip-types --no-warnings scripts/documents.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@realadvisor/sites-kit-astro": "file:../../../kit-astro",
    "@realadvisor/sites-kit-core": "file:../../../kit-core",
    "@realadvisor/sites-sdk": "file:../../../sdk",
    "astro": "5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "lighthouse": "13.5.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  },
  "packageManager": "pnpm@10.11.1"
}
