---
/**
 * Document shell: <head> SEO tags. Data through the site's SitesClient
 * (src/lib/data.ts), never the kit's `ra`.
 */
import { LOCALE } from '@realadvisor/sites-kit/format';
import { analyticsId } from '@realadvisor/sites-kit/env';
import { img } from '@realadvisor/sites-kit/image';
import { canonicalUrl, safeJsonLd } from '@realadvisor/sites-kit/seo';
import ConsentBanner from '@realadvisor/sites-kit/components/ConsentBanner.astro';
import { sites } from '../lib/data';

interface Props {
  title: string;
  description: string;
  /** Absolute URL, ~1200x630: the page's main photo. */
  image?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description, jsonLd, noindex } = Astro.props;
const ogFallback = async () => {
  const org = await sites.organisation();
  if (org.logo?.url) return img(org.logo.url, { w: 1200, h: 630, fit: 'fit' });
  const photo = (await sites.developments())[0]?.photos[0]?.url;
  return photo ? img(photo, { w: 1200, h: 630 }) : undefined;
};
const image = Astro.props.image || (await ogFallback().catch(() => undefined));
const base = Astro.site ?? Astro.url;
const canonical = canonicalUrl(Astro.url, base);
const gaId = analyticsId();
---
<!doctype html>
<html lang={LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0E1A24" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALE.replace('-', '_')} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Guard: nothing may undo `hidden` (an invisible open menu layer blocks every click). Never remove. */}
    <style is:inline>[hidden]{display:none!important}</style>
    {jsonLd && <script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
    {gaId && <ConsentBanner analyticsId={gaId} locale={LOCALE} />}
  </body>
</html>
