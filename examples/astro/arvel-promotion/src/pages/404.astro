---
// Not-found page, rendered on request so routes can rewrite to it.
export const prerender = false;

import Site from '../layouts/Site.astro';
import PageHead from '../components/PageHead.astro';
import { t } from '@realadvisor/sites-kit-core/i18n';
import { programmes as allProgrammes } from '../lib/data';
import { programmeUrl, programmeStatus, PROGRAMMES_PATH } from '../lib/fr';

const programmes = await allProgrammes();
const title = t('notFound');
---
<Site title={title} description={title} noindex>
  <PageHead title="Cette page n’existe pas ou plus">
    <p class="lead nf">Le lien est peut-être ancien, ou le logement a été retiré. Nos programmes, eux, sont toujours là.</p>
  </PageHead>
  <section class="section section--tight">
    <div class="wrap">
      <ul class="nf-list">
        {programmes.map((d) => (
          <li><a href={programmeUrl(d)}><span class="t">{d.title}</span><span class="m">{d.address.city}{programmeStatus(d) && ` · ${programmeStatus(d)}`}</span></a></li>
        ))}
      </ul>
      <p class="nf-links"><a class="link" href={PROGRAMMES_PATH}>Tous nos programmes</a> <a class="link" href="/">{t('home')}</a></p>
    </div>
  </section>
</Site>
<style>
  .nf { margin-top: 28px; }
  .nf-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .nf-list a { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; padding: 26px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .nf-list a:hover .t { text-decoration: underline; }
  .t { font: 500 clamp(1.8rem, 3.4vw, 2.8rem) / 1.05 var(--serif); }
  .m { font-size: 0.75rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  .nf-links { display: flex; flex-wrap: wrap; gap: 8px 40px; margin-top: 40px; }
</style>
