---
// Contact: the developer's office, the advisers per programme and the
// general enquiry form (kit EnquiryForm, contactReason other).
export const prerender = false;

import Site from '../layouts/Site.astro';
import PageHead from '../components/PageHead.astro';
import EnquiryForm from '@realadvisor/sites-kit-astro/components/EnquiryForm.astro';
import AgentPhoto from '../components/AgentPhoto.astro';
import { primaryTeam, programmes as allProgrammes, sites } from '../lib/data';
import { addressLine, languageList, programmeUrl, telHref } from '../lib/fr';
import { organisationJsonLd } from '../lib/seo';

const [org, team, programmes, agents] = await Promise.all([sites.organisation(), primaryTeam(), allProgrammes(), sites.agents()]);
const name = team?.name ?? org.name;
const advisers = agents.map((a) => ({ agent: a, programmes: programmes.filter((d) => d.agents.some((x) => x.id === a.id)) }));
const address = team ? addressLine(team.address) : '';
---
<Site title={`Contact | ${name}`} description={`Contacter ${name}${address ? `, ${address}` : ''} : téléphone, e-mail et formulaire.`} jsonLd={organisationJsonLd(org, team, Astro.site?.href ?? Astro.url.origin)} current="contact">
  <PageHead title="Nous écrire ou nous rencontrer" />
  <section class="section section--tight">
    <div class="wrap grid">
      <div class="side">
        {team && (
          <div class="office">
            <h2 class="h3">{name}</h2>
            <address>
              {address && <p>{address}</p>}
              {team.phone && <p><a class="big num" href={telHref(team.phone)}>{team.phone}</a></p>}
              {team.email && <p><a href={`mailto:${team.email}`}>{team.email}</a></p>}
            </address>
          </div>
        )}
        {advisers.length > 0 && (
          <div class="advisers">
            <h2 class="h3 adv-h">Vos conseillers</h2>
            <ul>
              {advisers.map(({ agent: a, programmes: ps }) => (
                <li>
                  <AgentPhoto agent={a} />
                  <div>
                    <p class="an">{a.first_name} {a.last_name}</p>
                    {ps.length > 0 && <p class="ap">Ventes, {ps.map((d, i) => <>{i > 0 && ', '}<a href={programmeUrl(d)}>{d.title}</a></>)}</p>}
                    {a.languages?.length ? <p class="ap">{languageList(a.languages)}</p> : null}
                    <p class="ac">
                      {a.phone && <a href={telHref(a.phone)} class="num">{a.phone}</a>}
                      {a.email && <a href={`mailto:${a.email}`}>{a.email}</a>}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <div class="paper card" id="message">
        <h2 class="h3 fh">Votre message</h2>
        <p class="fl">Une question sur un programme précis ? Écrivez depuis sa page : votre demande arrive directement à son conseiller.</p>
        <EnquiryForm contactReason="other" submitLabel="Envoyer mon message" />
      </div>
    </div>
  </section>
</Site>
<style>
  .grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 56px clamp(32px, 6vw, 112px); align-items: start; }
  .side { display: grid; gap: 56px; }
  .office { display: grid; gap: 20px; }
  address { font-style: normal; display: grid; gap: 6px; }
  address p { margin: 0; color: var(--muted); }
  address a { color: var(--text); display: inline-flex; min-height: 40px; align-items: center; }
  .big { font: 500 clamp(1.8rem, 3vw, 2.4rem) / 1.1 var(--serif); text-decoration: none; }
  .advisers ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .adv-h { margin-bottom: 20px; }
  .advisers li { display: flex; gap: 20px; align-items: flex-start; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .advisers p { margin: 0; }
  .an { font: 500 1.5rem / 1.1 var(--serif); }
  .ap { font-size: 0.8125rem; color: var(--muted); margin-top: 4px !important; }
  .ap a { display: inline-flex; min-height: 28px; align-items: center; }
  .ac { display: flex; flex-wrap: wrap; gap: 0 18px; font-size: var(--fs-small); }
  .ac a { display: inline-flex; min-height: 40px; align-items: center; overflow-wrap: anywhere; }
  .card { padding: clamp(24px, 4vw, 52px); }
  .fh { margin-bottom: 10px; }
  .fl { color: var(--on-paper-muted); font-size: var(--fs-small); margin-bottom: 28px; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
