---
// About the developer: written content (src/content/about.ts), figures
// computed from the data, the architects and builders per programme (fixture
// only) and the buying steps. No awards, no invented figures.
export const prerender = false;

import Site from '../layouts/Site.astro';
import Hero from '../components/Hero.astro';
import ContactBand from '../components/ContactBand.astro';
import AgentPhoto from '../components/AgentPhoto.astro';
import { developmentExtra, primaryTeam, programmes as allProgrammes, sites } from '../lib/data';
import { contentFor } from '../content/programmes';
import { ABOUT } from '../content/about';
import { languageList, programmeStatus, programmeUrl, telHref } from '../lib/fr';
import { ogImage } from '../lib/seo';

const [org, team, programmes, agents] = await Promise.all([sites.organisation(), primaryTeam(), allProgrammes(), sites.agents()]);
const name = team?.name ?? org.name;
const photoOf = (i: number) => {
  const d = programmes[i % Math.max(1, programmes.length)];
  return d ? d.photos[(contentFor(d.slug).hero ?? 0)] ?? d.photos[0] : undefined;
};
// Art direction: the delivered programme (last in the list) shows best what the developer builds.
const hero = photoOf(Math.max(0, programmes.length - 1));
// fixture only: developer, architect, general contractor
const credits = programmes.map((d) => ({ d, x: developmentExtra(d) })).filter(({ x }) => x.architect || x.general_contractor);
---
<Site title={`À propos | ${name}, promoteur immobilier`} description={`${name}, promoteur immobilier à Annecy et Lyon : qui nous sommes, nos architectes, l’achat d’un logement neuf et vos conseillers.`} image={ogImage(hero?.url)} current="about">
  <Hero slot="hero" size="band" photo={hero?.url} alt={hero?.alt ?? name} kicker="À propos" title={name} line="Promoteur immobilier, bureau à Annecy, programmes en Haute-Savoie et dans le Rhône." />

  <section class="section" aria-labelledby="h-who">
    <div class="wrap grid">
      <h2 id="h-who" class="display">Qui nous sommes</h2>
      <div class="text">
        {ABOUT.intro.map((p, i) => <p class:list={[i === 0 ? 'lead' : 'muted']}>{p}</p>)}
      </div>
    </div>
    <div class="wrap">
      <p class="muted figs-note">Programmes présentés sur ce site : {programmes.map((d, i) => <>{i > 0 && ', '}<a href={programmeUrl(d)}>{d.title}</a> ({d.address.city}{programmeStatus(d) && `, ${programmeStatus(d).toLowerCase()}`})</>)}.</p>
    </div>
  </section>

  <section class="section section--deep" aria-labelledby="h-pr">
    <div class="wrap grid">
      <h2 id="h-pr" class="display">Comment nous construisons</h2>
      <div class="text cols2">
        {ABOUT.approach.map((p) => <p class="muted">{p}</p>)}
      </div>
    </div>
  </section>

  {credits.length > 0 && (
    <section class="section" aria-labelledby="h-cr">
      <div class="wrap">
        <h2 id="h-cr" class="display">Architectes et entreprises</h2>
        <div class="tablebox">
          <table class="credits">
            <thead><tr><th scope="col">Programme</th><th scope="col">Architecte</th><th scope="col">Entreprise générale</th></tr></thead>
            <tbody>
              {credits.map(({ d, x }) => (
                <tr><th scope="row"><a href={programmeUrl(d)}>{d.title}</a><span class="muted"> · {d.address.city}</span></th><td>{x.architect ?? ''}</td><td>{x.general_contractor ?? ''}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="section section--paper" aria-labelledby="h-steps">
    <div class="wrap">
      <h2 id="h-steps" class="display">Acheter un logement neuf en VEFA</h2>
      <ol class="steps">
        {ABOUT.steps.map((s, i) => (
          <li class="reveal"><span class="sn num">{i + 1}</span><h3 class="st">{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  {agents.length > 0 && (
    <section class="section section--tight" aria-labelledby="h-team">
      <div class="wrap">
        <h2 id="h-team" class="h3 team-h">Vos interlocuteurs</h2>
        <ul class="team">
          {agents.map((a) => {
            const ps = programmes.filter((d) => d.agents.some((x) => x.id === a.id));
            return (
              <li>
                <AgentPhoto agent={a} size="card" />
                <p class="an">{a.first_name} {a.last_name}</p>
                <p class="ap muted">{ps.length > 0 ? `Ventes, ${ps.map((d) => d.title).join(', ')}` : 'Ventes'}</p>
                {a.languages?.length ? <p class="ap muted">{languageList(a.languages)}</p> : null}
                {a.phone && <a href={telHref(a.phone)} class="num">{a.phone}</a>}
                {a.email && <a href={`mailto:${a.email}`}>{a.email}</a>}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}
  <ContactBand team={team} />
</Site>
<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 32px clamp(40px, 7vw, 128px); align-items: start; }
  .text p { max-width: 56ch; }
  .figs-note { font-size: var(--fs-small); margin-top: clamp(40px, 5vw, 72px); max-width: 70ch; }
  .tablebox { overflow-x: auto; margin-top: 48px; }
  .credits { width: 100%; border-collapse: collapse; }
  .credits th, .credits td { text-align: left; padding: 18px 16px 18px 0; border-bottom: 1px solid var(--line); vertical-align: baseline; }
  .credits thead th { font: 500 var(--fs-small) / 1.3 var(--sans); color: var(--muted); border-bottom-color: var(--line-strong); }
  .credits tbody th { font: 500 1.375rem / 1.2 var(--serif); }
  .credits tbody th a { text-decoration: none; }
  .credits tbody th span { font: 400 var(--fs-small) var(--sans); }
  .steps { list-style: none; margin: clamp(48px, 6vw, 88px) 0 0; padding: 0; border-top: 1px solid #CFC6B8; }
  .steps li { display: grid; grid-template-columns: 80px minmax(0, 0.9fr) minmax(0, 1.4fr); gap: 16px 40px; align-items: baseline; padding: 30px 0; border-bottom: 1px solid #CFC6B8; }
  .sn { font: 500 0.9375rem / 1.6 var(--sans); color: var(--on-paper-muted); }
  .st { font: 500 clamp(1.7rem, 2.6vw, 2.4rem) / 1.05 var(--serif); }
  .steps p { margin: 0; color: var(--on-paper-muted); max-width: 56ch; }
  .team-h { margin-bottom: 32px; }
  .team { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .team li { display: grid; gap: 6px; justify-items: start; padding: 28px; border: 1px solid var(--line); }
  .team li p { margin: 0; }
  .team li :global(.agent-photo) { margin-bottom: 10px; }
  .team .an { font: 500 1.6rem / 1.1 var(--serif); }
  .cols2 p { margin: 0 0 1.1em; }
  .team .ap { font-size: 0.8125rem; }
  .team a { display: inline-flex; min-height: 40px; align-items: center; font-size: var(--fs-small); overflow-wrap: anywhere; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
        .steps li { grid-template-columns: 48px minmax(0, 1fr); }
    .steps p { grid-column: 2; }
  }
  @media (max-width: 560px) {
      .credits thead { display: none; }
    .credits, .credits tbody, .credits tr, .credits th, .credits td { display: block; }
    .credits tr { padding: 18px 0; border-bottom: 1px solid var(--line); }
    .credits th, .credits td { border: 0; padding: 2px 0; }
  }
</style>
