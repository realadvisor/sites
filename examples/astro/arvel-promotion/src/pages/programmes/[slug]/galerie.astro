---
// Gallery: every photo of the programme, then the construction photos.
export const prerender = false;

import Site from '../../../layouts/Site.astro';
import Hero from '../../../components/Hero.astro';
import Gallery from '../../../components/Gallery.astro';
import Lightbox from '../../../components/Lightbox.astro';
import EnquiryBlock from '../../../components/EnquiryBlock.astro';
import { developmentExtra, sites } from '../../../lib/data';
import { contentFor } from '../../../content/programmes';
import { constructionFor } from '../../../content/construction';
import { plural } from '../../../lib/fr';
import { ogImage } from '../../../lib/seo';

const d = await sites.development(Astro.params.slug!);
if (!d) return Astro.rewrite('/404');
const c = contentFor(d.slug);
const hero = d.photos[c.hero ?? 0] ?? d.photos[0];
const photos = d.photos.filter((p) => p !== hero).map((p, i) => ({ url: p.url, alt: p.alt || `${d.title}, photo ${i + 2}` }));
const seen = new Set(d.photos.map((p) => p.url));
// Site illustration photos (content/construction.ts) win; otherwise the
// fixture only: construction_photos, minus those already in the gallery.
const illustrations = constructionFor(d.slug);
const site = illustrations.length > 0
  ? illustrations.map((p) => ({ local: p.name, alt: p.alt }))
  : (developmentExtra(d).construction_photos ?? []).filter((u) => !seen.has(u)).map((u, i) => ({ url: u, alt: `${d.title}, chantier, photo ${i + 1}` }));
const siteTitle = d.status === 'delivered' ? 'Retour sur le chantier' : d.status === 'construction' ? 'Le chantier' : 'Le projet';
---
<Site title={`Galerie · ${d.title} | Arvel Promotion`} description={`${plural(d.photos.length + site.length, 'photo', 'photos')} de ${d.title}, ${d.address.city ?? ''}.`} image={ogImage(hero?.url)} programme={d} section="gallery" current="programmes">
  <Hero slot="hero" size="band" photo={hero?.url} alt={hero?.alt ?? d.title} kicker={d.title} title="Galerie" line={plural(d.photos.length, 'photo', 'photos')} />

  <section class="section section--tight" aria-labelledby="h-g">
    <div class="wrap">
      <h2 id="h-g" class="sr-only">Photos de {d.title}</h2>
      {photos.length > 0 ? <Gallery photos={photos} id="programme" /> : <p class="muted">Les photos de ce programme arrivent bientôt.</p>}
    </div>
  </section>

  {site.length > 0 && (
    <section class="section section--tight section--deep" aria-labelledby="h-s">
      <div class="wrap">
        <div class="shead">
          <h2 id="h-s" class="display">{siteTitle}</h2>
          {illustrations.length > 0 && <p class="muted note">Photos d’illustration d’un chantier résidentiel : elles ne montrent pas ce programme.</p>}
        </div>
        <Gallery photos={site} id="site" />
      </div>
    </section>
  )}
  <p class="wrap disclaimer muted">Visuels non contractuels.</p>
  <Lightbox />
  <EnquiryBlock programme={d} />
</Site>
<style>
  .shead { margin-bottom: 40px; }
  .note { margin: 14px 0 0; font-size: var(--fs-small); }
  .disclaimer { font-size: 0.8125rem; padding-block: 20px; }
</style>
