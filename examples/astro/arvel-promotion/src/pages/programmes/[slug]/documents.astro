---
// Documents: brochure, indicative plans per type and the price list (PDFs
// generated by the site, see src/content/documents.ts), plus each type plan.
export const prerender = false;

import Site from '../../../layouts/Site.astro';
import Hero from '../../../components/Hero.astro';
import EnquiryBlock from '../../../components/EnquiryBlock.astro';
import { sites } from '../../../lib/data';
import { documentsFor, formatBytes } from '../../../content/documents';
import { programmeUrl, typeMix } from '../../../lib/fr';
import { ogImage } from '../../../lib/seo';

const d = await sites.development(Astro.params.slug!);
if (!d) return Astro.rewrite('/404');
const photo = d.photos[d.photos.length - 1] ?? d.photos[0];
const docs = documentsFor(d.slug);
const mix = typeMix(d);
const fmtDate = (iso: string) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));
const NAMES: Record<number, string> = { 1: 'Studio', 2: 'Deux pièces', 3: 'Trois pièces', 4: 'Quatre pièces', 5: 'Cinq pièces' };
---
<Site title={`Documents · ${d.title} | Arvel Promotion`} description={`Brochure, plans et grille des prix de ${d.title} à télécharger.`} image={ogImage(photo?.url)} programme={d} section="documents" current="programmes">
  <Hero slot="hero" size="band" photo={photo?.url} alt={photo?.alt ?? d.title} kicker={d.title} title="Documents à télécharger" />

  <section class="section section--tight" aria-labelledby="h-docs">
    <div class="wrap">
      <h2 id="h-docs" class="sr-only">Documents de {d.title}</h2>
      {docs.length > 0 ? (
        <ul class="docs">
          {docs.map((doc) => (
            <li class="reveal">
              <a href={doc.href} download>
                <span class="kind">{doc.kind === 'brochure' ? 'Brochure' : doc.kind === 'plans' ? 'Plans' : 'Prix'}</span>
                <span class="t">{doc.title}</span>
                <span class="desc muted">{doc.description}</span>
                <span class="meta num">PDF · {doc.pages} p. · {formatBytes(doc.bytes)} · mis à jour le {fmtDate(doc.date)}</span>
                <span class="dl" aria-hidden="true">Télécharger ↓</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">Les documents de ce programme sont envoyés sur demande. <a href="#contact">Demander la brochure</a></p>
      )}
    </div>
  </section>

  {mix.length > 0 && (
    <section class="section section--tight section--deep" aria-labelledby="h-plans">
      <div class="wrap">
        <div class="phead">
          <h2 id="h-plans" class="h3">Plans types</h2>
          <p class="muted">Plans indicatifs et non contractuels, un par typologie. Le plan de chaque logement est sur sa page, depuis <a href={programmeUrl(d, 'logements')}>le plan de la résidence</a>.</p>
        </div>
        <ul class="plans">
          {mix.map((t) => (
            <li>
              <a href={`/plans/t${Math.min(5, t.rooms)}.svg`} download={`plan-${d.slug}-${t.code.toLowerCase()}.svg`}>
                <img src={`/plans/t${Math.min(5, t.rooms)}.svg`} alt={`Plan indicatif ${t.code}`} width="400" height="340" loading="lazy" decoding="async" />
                <span class="pc"><b>{t.code}</b> {NAMES[t.rooms]}<span class="muted num"> · {t.minSurface === t.maxSurface ? `${t.minSurface} m²` : `${t.minSurface} à ${t.maxSurface} m²`}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <EnquiryBlock programme={d} title="Recevoir la brochure par e-mail" />
</Site>
<style>
  .docs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .docs a { display: grid; gap: 12px; align-content: start; height: 100%; padding: 32px 28px; border: 1px solid var(--line-strong); text-decoration: none; transition: background 0.3s var(--ease); }
  .docs a:hover { background: var(--surface); }
  .kind { font: 500 0.6875rem / 1 var(--sans); letter-spacing: 0.22em; text-transform: uppercase; color: var(--brass); }
  .t { font: 500 2rem / 1.05 var(--serif); }
  .desc { font-size: var(--fs-small); }
  .meta { font-size: 0.8125rem; color: var(--muted); white-space: normal; }
  .dl { margin-top: 12px; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; }
  .phead { display: grid; gap: 12px; margin-bottom: 32px; max-width: 720px; }
  .phead p { margin: 0; }
  .plans { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; }
  .plans a { display: grid; gap: 12px; text-decoration: none; }
  .plans img { width: 100%; height: 220px; object-fit: contain; background: var(--paper); padding: 14px; }
  .pc b { font: 500 1.375rem / 1 var(--serif); margin-right: 6px; }
  @media (max-width: 900px) { .docs { grid-template-columns: 1fr; } }
</style>
