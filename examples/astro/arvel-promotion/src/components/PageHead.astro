---
/** Title block of a page without a photo hero (legal, contact, 404). */
interface Props { title: string }
const { title } = Astro.props;
---
<header class="phead">
  <div class="wrap">
    <h1 class="display">{title}</h1>
    <slot />
  </div>
</header>
<style>
  .phead { padding: clamp(56px, 9vw, 128px) 0 clamp(40px, 6vw, 80px); border-bottom: 1px solid var(--line); }
  .display { font-size: clamp(2.6rem, 6.4vw, 6rem); max-width: 18ch; }
</style>
