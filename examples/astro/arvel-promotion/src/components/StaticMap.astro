---
/**
 * Static map of one address from OpenStreetMap tiles (allowed host, no
 * library, no iframe): a grid of tiles centred on the point, a marker, the
 * attribution and links to open the place in a map app. Coordinates from the
 * API are rounded, so the marker says "approximate".
 */
interface Props { lat: number; lng: number; label: string; zoom?: number }
const { lat, lng, label, zoom = 15 } = Astro.props;
const n = 2 ** zoom;
const fx = ((lng + 180) / 360) * n;
const rad = (lat * Math.PI) / 180;
const fy = ((1 - Math.log(Math.tan(rad) + 1 / Math.cos(rad)) / Math.PI) / 2) * n;
const cx = Math.floor(fx);
const cy = Math.floor(fy);
const COLS = 5;
const ROWS = 3;
const x0 = cx - Math.floor(COLS / 2);
const y0 = cy - Math.floor(ROWS / 2);
const tiles = [];
for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) tiles.push({ x: x0 + c, y: y0 + r, c, r });
// point position inside the tile grid, in % of the grid
const px = ((fx - x0) / COLS) * 100;
const py = ((fy - y0) / ROWS) * 100;
const osm = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=${zoom + 1}/${lat}/${lng}`;
const gmaps = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
---
<figure class="smap">
  <div class="viewport">
    <div class="grid" style={`--px:${px.toFixed(3)}%;--py:${py.toFixed(3)}%`}>
      {tiles.map((t) => (
        <img src={`https://tile.openstreetmap.org/${zoom}/${t.x}/${t.y}.png`} alt="" width="256" height="256" loading="lazy" decoding="async" style={`grid-column:${t.c + 1};grid-row:${t.r + 1}`} />
      ))}
    </div>
    <span class="pin" aria-hidden="true"></span>
    <span class="attr">© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a></span>
  </div>
  <figcaption>
    <span>{label} <span class="muted">· emplacement approximatif</span></span>
    <span class="links"><a href={osm} rel="noopener">OpenStreetMap</a><a href={gmaps} rel="noopener">Google Maps</a></span>
  </figcaption>
</figure>
<style>
  .smap { margin: 0; }
  .viewport { position: relative; overflow: hidden; aspect-ratio: 16 / 10; background: #E8E4DC; }
  .grid {
    position: absolute; left: 50%; top: 50%; width: 1280px; height: 768px;
    display: grid; grid-template-columns: repeat(5, 256px); grid-template-rows: repeat(3, 256px);
    transform: translate(calc(-1 * var(--px)), calc(-1 * var(--py)));
    filter: grayscale(1) contrast(0.9) brightness(0.98) sepia(0.12);
  }
  .grid img { width: 256px; height: 256px; max-width: none; }
  .pin { position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 6px rgb(14 26 36 / 0.25), 0 0 0 1px #fff inset; }
  .pin::after { content: ''; position: absolute; inset: 7px; border-radius: 50%; background: var(--brass); }
  .attr { position: absolute; right: 0; bottom: 0; padding: 3px 8px; font-size: 0.6875rem; background: rgb(255 255 255 / 0.85); color: #222; }
  .attr a { color: inherit; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-top: 14px; font-size: var(--fs-small); }
  .links { display: flex; gap: 20px; }
  .links a { display: inline-flex; min-height: 44px; align-items: center; }
</style>
