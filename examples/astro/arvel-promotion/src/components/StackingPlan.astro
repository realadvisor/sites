---
/**
 * Stacking plan: one row per floor, top floor first; each unit a block whose
 * width follows its living surface, status as fill and text. Every block
 * links to its lot page. Server-rendered (works without JS); the filters on
 * the Logements page dim blocks with `data-dim` (scripts/units.ts).
 * Order on the floor is fixture only.
 */
import type { DevelopmentWithUnits } from '@realadvisor/sites-sdk/types';
import { unitsInOrder } from '../lib/data';
import { floorName, floorShort, formatSurface, statusLabel, typeCode, unitPrice, unitUrl } from '../lib/fr';

interface Props {
  programme: DevelopmentWithUnits;
  /** Filter state from the URL: a type code (T1..T5) and "only available". */
  type?: string;
  onlyAvailable?: boolean;
  compact?: boolean;
  /** Unit to highlight (lot page). */
  current?: string;
  labelledby?: string;
}
const { programme: d, type, onlyAvailable, compact = false, labelledby, current } = Astro.props;
const units = unitsInOrder(d);
const floors = [...new Set(units.map((u) => u.floor ?? 0))].sort((a, b) => b - a);
const dim = (u: (typeof units)[number]) => (!!type && typeCode(u) !== type) || (!!onlyAvailable && u.status !== 'available');
---
<div class:list={['stack', compact && 'stack--compact']} data-stack role="group" aria-labelledby={labelledby}>
  <div class="roof" aria-hidden="true"></div>
  {floors.map((f) => {
    const row = units.filter((u) => (u.floor ?? 0) === f);
    const label = floorName(row[0]!);
    return (
      <div class="floor">
        <p class="fl"><span class="fl-long">{label}</span><span class="fl-short" aria-hidden="true">{floorShort(f)}</span></p>
        <ul class="row" aria-label={label}>
          {row.map((u) => {
            const m2 = u.living_surface ? formatSurface(u.living_surface) : '';
            const desc = [typeCode(u), m2, label, unitPrice(u)].filter(Boolean).join(', ');
            return (
              <li style={`flex-grow:${u.living_surface ?? 50}`} data-unit data-type={typeCode(u)} data-st={u.status} data-dim={dim(u) ? '' : undefined}>
                <a class="u" href={unitUrl(d, u)} aria-current={current === u.id ? 'page' : undefined} aria-label={u.reference ? `Lot ${u.reference} : ${desc}` : desc}>
                  {u.reference && <span class="n num">{u.reference}</span>}
                  <span class="ty">{typeCode(u)}</span>
                  {!compact && m2 && <span class="m2 num">{m2}</span>}
                  <span class="pr num">{u.status === 'available' ? unitPrice(u) : statusLabel(u)}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    );
  })}
  <div class="ground" aria-hidden="true"></div>
</div>
<style>
  .stack { display: grid; gap: 6px; --fl-w: 132px; }
  .roof, .ground { margin-left: calc(var(--fl-w) + 12px); }
  .roof { height: 14px; border: 1px solid var(--line-strong); border-bottom: 0; }
  .ground { height: 8px; background: repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px 9px); border-top: 1px solid var(--line-strong); }
  .floor { display: grid; grid-template-columns: var(--fl-w) minmax(0, 1fr); gap: 12px; align-items: stretch; }
  .fl { margin: 0; align-self: center; text-align: right; font: 500 0.6875rem / 1.2 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .fl-short { display: none; }
  .row { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; min-width: 0; }
  .row li { flex-basis: 0; min-width: 0; display: flex; transition: opacity 0.3s var(--ease); }
  .u {
    flex: 1; min-width: 0; display: grid; align-content: space-between; gap: 2px; min-height: 84px; padding: 10px 12px;
    text-decoration: none; position: relative; overflow: hidden; transition: transform 0.25s var(--ease), box-shadow 0.25s;
  }
  [data-st='available'] .u { background: var(--st-available); color: var(--st-available-ink); }
  [data-st='reserved'] .u { background: var(--st-reserved); color: var(--st-reserved-ink); }
  [data-st='sold'] .u { background: repeating-linear-gradient(135deg, rgb(238 232 221 / 0.05) 0 1px, transparent 1px 8px), var(--st-sold); color: var(--st-sold-ink); box-shadow: inset 0 0 0 1px var(--line); }
  .u:hover { transform: translateY(-2px); box-shadow: 0 0 0 1px currentColor; }
  .u:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; z-index: 1; }
  .n { font-size: 0.6875rem; letter-spacing: 0.08em; opacity: 0.8; }
  .ty { font: 500 1.375rem / 1 var(--serif); }
  .m2 { font-size: 0.8125rem; }
  .pr { font-size: 0.75rem; letter-spacing: 0.04em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  li[data-dim] { opacity: 0.22; }
  .u[aria-current='page'] { outline: 2px solid var(--brass); outline-offset: 2px; z-index: 1; }
  li[data-dim] .u:hover { transform: none; }
  .stack--compact .u { min-height: 58px; padding: 8px 10px; }
  .stack--compact .ty { font-size: 1.125rem; }
  .stack--compact .n { display: none; }
  @media (max-width: 760px) {
    .stack { --fl-w: 34px; }
    .fl-long { display: none; }
    .fl-short { display: inline; }
    .fl { letter-spacing: 0.04em; }
    .u { min-height: 60px; padding: 7px 6px; }
    .ty { font-size: 1.05rem; }
    .m2, .n { display: none; }
    .pr { display: none; }
  }
</style>
