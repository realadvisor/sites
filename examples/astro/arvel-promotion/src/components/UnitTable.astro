---
/**
 * Availability table: the accessible companion of the stacking plan, and
 * the phone layout (one card per unit). Rows hidden by the filters get
 * `hidden`.
 */
import type { DevelopmentWithUnits } from '@realadvisor/sites-sdk/types';
import { orientationCode, unitsInOrder } from '../lib/data';
import { floorName, formatSurface, orientationLabel, statusLabel, typeCode, typeName, unitPrice, unitUrl, programmeUrl } from '../lib/fr';

interface Props { programme: DevelopmentWithUnits; type?: string; onlyAvailable?: boolean; enquiryPath?: string }
const { programme: d, type, onlyAvailable, enquiryPath } = Astro.props;
const units = [...unitsInOrder(d)].sort((a, b) => (b.floor ?? 0) - (a.floor ?? 0) || 0);
const hide = (u: (typeof units)[number]) => (!!type && typeCode(u) !== type) || (!!onlyAvailable && u.status !== 'available');
const ask = (id: string) => `${enquiryPath ?? programmeUrl(d)}?lot=${encodeURIComponent(id)}#contact`;
---
<div class="tablebox">
  <table class="units">
    <caption class="sr-only">Logements de {d.title}</caption>
    <thead>
      <tr>
        <th scope="col">Lot</th>
        <th scope="col">Type</th>
        <th scope="col">Étage</th>
        <th scope="col" class="r">Surface</th>
        <th scope="col" class="r">Extérieur</th>
        <th scope="col">Orientation</th>
        <th scope="col" class="r">Prix</th>
        <th scope="col">Statut</th>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      {units.map((u) => {
        const outdoor = u.terrace_surface ?? u.balcony_surface;
        return (
          <tr data-unit data-type={typeCode(u)} data-st={u.status} hidden={hide(u) || undefined}>
            <td class="c-lot num" data-l="Lot">{u.reference ?? '—'}</td>
            <th scope="row" class="c-type"><a href={unitUrl(d, u)}><span class="code">{typeCode(u)}</span> <span class="tname">{typeName(u)}</span></a></th>
            <td class="c-floor">{floorName(u)}</td>
            <td class="r num c-m2">{u.living_surface ? formatSurface(u.living_surface) : ''}</td>
            <td class="r num c-out">{outdoor ? <>{formatSurface(outdoor)}<span class="out-l"> {u.terrace_surface ? 'terrasse' : 'balcon'}</span></> : ''}</td>
            <td class="c-or">{orientationLabel(orientationCode(u))}</td>
            <td class="r num c-price">{u.status === 'available' ? unitPrice(u) : ''}</td>
            <td class="c-st"><span class="pill" data-st={u.status}>{statusLabel(u)}</span></td>
            <td class="c-sum" aria-hidden="true">{[floorName(u), u.living_surface && formatSurface(u.living_surface), outdoor && `${u.terrace_surface ? 'terrasse' : 'balcon'} ${formatSurface(outdoor)}`, orientationLabel(orientationCode(u))].filter(Boolean).join(' · ')}</td>
            <td class="c-act">
              <a class="act" href={unitUrl(d, u)}>Plan<span class="sr-only"> du {typeCode(u)}, {floorName(u)}</span></a>
              {u.status !== 'sold' && <a class="act act--ask" href={ask(u.id)}>Se renseigner<span class="sr-only"> sur le {typeCode(u)}, {floorName(u)}</span></a>}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
<style>
  .tablebox { overflow-x: auto; }
  .units { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  th, td { padding: 16px 14px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; vertical-align: middle; }
  thead th { font: 500 0.6875rem / 1 var(--sans); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); padding-block: 14px; border-bottom-color: var(--line-strong); }
  .r { text-align: right; }
  tbody tr { transition: background 0.2s; }
  tbody tr:hover { background: rgb(238 232 221 / 0.04); }
  tr[data-st='sold'] td, tr[data-st='sold'] .c-type { color: var(--st-sold-ink); }
  .c-type { font-weight: 400; }
  .c-type a { text-decoration: none; display: inline-flex; gap: 10px; align-items: baseline; min-height: 32px; align-items: center; }
  .code { font: 500 1.375rem / 1 var(--serif); }
  .tname { color: var(--muted); }
  .c-type a:hover .tname { text-decoration: underline; }
  .out-l { color: var(--muted); }
  .c-act { text-align: right; }
  .act { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; border: 1px solid var(--line-strong); }
  .act + .act { margin-left: 6px; }
  .act:hover { background: var(--text); color: var(--brand); }
  .act--ask { background: var(--text); color: var(--brand); border-color: var(--text); }
  .act--ask:hover { background: var(--brass); border-color: var(--brass); }
  .c-sum { display: none; }
  @media (max-width: 900px) {
    thead { display: none; }
    .units, tbody, td, tbody th { display: block; }
    tbody { display: grid; gap: 10px; }
    tbody tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 16px; padding: 18px; border: 1px solid var(--line); background: var(--surface); }
    tbody tr[hidden] { display: none; }
    td, tbody th { padding: 0; border: 0; white-space: normal; text-align: left; }
    .c-lot, .c-floor, .c-m2, .c-out, .c-or { display: none; }
    .c-type { grid-column: 1; grid-row: 1; }
    .c-st { grid-column: 2; grid-row: 1; justify-self: end; align-self: center; }
    .c-sum { display: block; grid-column: 1 / -1; color: var(--muted); font-size: 0.875rem; }
    .c-price { grid-column: 1 / -1; font: 500 1.5rem / 1.1 var(--serif); text-align: left; }
    .c-price:empty { display: none; }
    .c-act { grid-column: 1 / -1; text-align: left; display: flex; gap: 8px; margin-top: 6px; }
    .act { flex: 1; justify-content: center; min-height: 44px; }
    .act + .act { margin-left: 0; }
  }
</style>
