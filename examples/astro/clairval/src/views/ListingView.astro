---
/**
 * Listing page: 1 + 4 gallery with "view all photos" (dialog); price, title
 * and key facts beside the agent card and enquiry form (sticky on desktop);
 * description, facts table, energy class, location; similar listings. On
 * phones a sticky "Message / Call" bar. Sold listings show no price and are
 * noindex.
 */
import EnquiryForm from '@realadvisor/sites-kit/components/EnquiryForm.astro';
import { sanitizeHtml } from '@realadvisor/sites-kit';
import { featureLabel } from '@realadvisor/sites-kit/i18n';
import { img } from '@realadvisor/sites-kit/image';
import { listingJsonLd, listingRef, listingTitle } from '@realadvisor/sites-kit/seo';
import type { Listing } from '@realadvisor/sites-sdk/types';
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import Gallery from '../components/Gallery.astro';
import AgentCard from '../components/AgentCard.astro';
import ListingCard from '../components/ListingCard.astro';
import StaticMap from '../components/StaticMap.astro';
import EnergyScale from '../components/EnergyScale.astro';
import { extraNum, extraStr, siteData, sites } from '../lib/data';
import { href, LOCALE, type L } from '../lib/routes';
import { cityName, tx } from '../lib/copy';
import { bathrooms, bedrooms, formatSurface, money, price, tel, typeLabel } from '../lib/format';
import { teamOf } from '../lib/regions';

interface Props { l: L; listing: Listing }
const { l, listing: x } = Astro.props;
const t = tx(l);
const [{ org, teams, agents }, sameTeam] = await Promise.all([
  siteData(),
  sites.allListings({ status: 'available', team_id: x.team_ids[0] }),
]);
const sold = x.status === 'sold';
const team = teamOf(x, teams);
const agent = x.agent ? (agents.find((a) => a.id === x.agent!.id) ?? x.agent) : undefined;
const callPhone = agent?.phone ?? team?.phone;
const city = cityName(x.address.city, l);
const country = x.address.country === 'Switzerland' ? (l === 'fr' ? 'Suisse' : 'Switzerland') : x.address.country;
const similar = sameTeam.filter((o) => o.id !== x.id && o.offer_type === x.offer_type).slice(0, 3);
const kitX = x;
const all = await sites.allListings();
const sameCity = all.filter((o) => o.address.city === x.address.city);

// fixture only: energy class, year built, terrace, floor and extra costs (not in the API yet)
const energy = extraStr('listings', x.id, 'energy_class');
const yearBuilt = extraNum('listings', x.id, 'year_built');
const terrace = extraNum('listings', x.id, 'terrace_surface');
const floor = extraNum('listings', x.id, 'floor');
const charges = x.offer_type === 'rent' ? extraNum('listings', x.id, 'charges') : undefined;

const C = {
  en: {
    about: 'About this property', facts: 'Key facts', type: 'Type', rooms: 'Rooms', bedrooms: 'Bedrooms', bathrooms: 'Bathrooms',
    living: 'Living area', land: 'Land', terrace: 'Terrace', floor: 'Floor', built: 'Year built', charges: 'Extra costs',
    features: 'Features', location: 'Location', map: 'Open in OpenStreetMap', area: (c: string) => `Approximate location in ${c}`,
    energy: x.address.country === 'France' ? 'Energy performance (DPE)' : 'Energy class', klass: (c: string) => `Class ${c}`,
    ask: 'Ask about this property', askSold: 'Looking for something similar?', similar: sold ? 'Available in the same area' : 'Similar properties',
    month: 'month', ref: 'Ref.', approx: 'The address is shown approximately; the agent gives the exact location.',
    interested: `I am interested in “${x.title}” (ref. ${listingRef(x)}).`, call: 'Call', message: 'Message',
  },
  fr: {
    about: 'Le bien', facts: 'Caractéristiques', type: 'Type', rooms: 'Pièces', bedrooms: 'Chambres', bathrooms: 'Salles de bains',
    living: 'Surface habitable', land: 'Terrain', terrace: 'Terrasse', floor: 'Étage', built: 'Année de construction', charges: 'Charges',
    features: 'Équipements', location: 'Situation', map: 'Ouvrir dans OpenStreetMap', area: (c: string) => `Situation approximative à ${c}`,
    energy: x.address.country === 'France' ? 'Diagnostic de performance énergétique (DPE)' : 'Classe énergétique', klass: (c: string) => `Classe ${c}`,
    ask: 'Demander des informations', askSold: 'Vous cherchez un bien semblable ?', similar: sold ? 'Disponibles dans le même secteur' : 'Biens semblables',
    month: 'mois', ref: 'Réf.', approx: 'L’adresse est indiquée de façon approximative ; l’agent vous donne la situation exacte.',
    interested: `Je suis intéressé(e) par « ${x.title} » (réf. ${listingRef(x)}).`, call: 'Appeler', message: 'Message',
  },
}[l];
const facts: [string, string][] = [
  [C.type, typeLabel(x.property_type, l)],
  x.rooms != null ? [C.rooms, String(x.rooms)] : null,
  x.bedrooms != null ? [C.bedrooms, String(x.bedrooms)] : null,
  x.bathrooms != null ? [C.bathrooms, String(x.bathrooms)] : null,
  x.living_surface ? [C.living, formatSurface(x.living_surface)] : null,
  x.land_surface ? [C.land, formatSurface(x.land_surface)] : null,
  terrace ? [C.terrace, formatSurface(terrace)] : null,
  floor != null ? [C.floor, String(floor)] : null,
  yearBuilt ? [C.built, String(yearBuilt)] : null,
  charges ? [C.charges, `${money(charges, x.currency, l)} / ${C.month}`] : null,
].filter(Boolean) as [string, string][];
const summary = [bedrooms(x.bedrooms, l), bathrooms(x.bathrooms, l), x.living_surface ? formatSurface(x.living_surface) : '', x.land_surface ? `${formatSurface(x.land_surface)} ${t('land')}` : ''].filter(Boolean);
const section = sold ? 'sold' : x.offer_type === 'rent' ? 'rent' : 'buy';
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const title = `${listingTitle(kitX, sameCity)} | ${price(x, l)}`;
---
<Site l={l} route="listing" segs={[x.slug]} section={section} barSpace
  title={title} description={(x.description_text ?? x.title).slice(0, 155)}
  image={x.photos[0] && img(x.photos[0].url, { w: 1200, h: 630 })}
  jsonLd={listingJsonLd(kitX, pageUrl)} noindex={sold}>
  <div class="wrap top">
    <Crumbs label={t('breadcrumb')} items={[
      { label: t('home'), href: href('home', l) },
      { label: sold ? t('navSold') : x.offer_type === 'rent' ? t('navRent') : t('navBuy'), href: href(section, l) },
      { label: city || x.title },
    ]} />
    <Gallery photos={x.photos} title={x.title} l={l} badge={sold ? t('sold') : undefined} />
  </div>

  <div class="wrap body">
    <div class="main">
      <header class="intro">
        <p class="intro__price num">{price(x, l)}</p>
        <h1 class="intro__title">{x.title}</h1>
        {summary.length > 0 && <p class="intro__facts">{summary.map((s) => <span class="num">{s}</span>)}</p>}
        <p class="intro__place">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z" /><circle cx="12" cy="9" r="2.5" /></svg>
          {[x.address.postcode, city].filter(Boolean).join(' ')}{country && `, ${country}`}
          <span class="intro__ref">{C.ref} {listingRef(x)}</span>
        </p>
      </header>

      {x.description && (
        <section class="block">
          <h2 class="block__h">{C.about}</h2>
          <div class="prose" set:html={sanitizeHtml(x.description)} />
        </section>
      )}

      <section class="block">
        <h2 class="block__h">{C.facts}</h2>
        <dl class="facts">
          {facts.map(([k, v]) => <div><dt>{k}</dt><dd class="num">{v}</dd></div>)}
        </dl>
        {x.features.length > 0 && (
          <>
            <h3 class="block__sub">{C.features}</h3>
            <ul class="plain feats">{x.features.map((f) => <li>{featureLabel(f, LOCALE[l])}</li>)}</ul>
          </>
        )}
      </section>

      {energy && (
        <section class="block">
          {/* fixture only: energy class */}
          <h2 class="block__h">{C.energy}</h2>
          <EnergyScale value={energy} label={C.energy} classLabel={C.klass(energy)} />
        </section>
      )}

      {x.address.lat != null && x.address.lng != null && (
        <section class="block">
          <h2 class="block__h">{C.location}</h2>
          <StaticMap lat={x.address.lat} lng={x.address.lng} zoom={13} area label={C.area(city)} linkLabel={C.map} height={360} />
          <p class="small muted note">{C.approx}</p>
        </section>
      )}
    </div>

    <aside class="side" id="contact-agent">
      <div class="side__card">
        {agent && <AgentCard agent={agent as never} all={agents} teams={teams} l={l} compact />}
        {!agent && team && (
          <p class="side__team"><strong>{org.name}</strong><br />{team.name}</p>
        )}
        {callPhone && (
          <a class="cta cta--ghost side__call" href={tel(callPhone)}>
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
            {C.call} <span class="num">{callPhone}</span>
          </a>
        )}
        <h2 class="side__h">{sold ? C.askSold : C.ask}</h2>
        <EnquiryForm listingId={x.id} agentId={agent?.id} agentName={agent?.first_name} message={C.interested} locale={LOCALE[l]} />
      </div>
    </aside>
  </div>

  {similar.length > 0 && (
    <section class="section similar">
      <div class="wrap">
        <h2 class="h2 similar__h">{C.similar}</h2>
        <ul class="plain grid3">{similar.map((o) => <li><ListingCard listing={o} l={l} /></li>)}</ul>
      </div>
    </section>
  )}

  <div class="bar" aria-label={`${C.message} / ${C.call}`} role="group">
    <a class="cta bar__msg" href="#enquiry">{C.message}</a>
    {callPhone && <a class="cta cta--ghost bar__call" href={tel(callPhone)}>{C.call}</a>}
  </div>
</Site>

<style>
  .top { padding-top: 16px; display: grid; gap: 12px; }
  .body { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: clamp(40px, 6vw, 96px); padding-top: clamp(32px, 4vw, 48px); padding-bottom: clamp(48px, 6vw, 88px); align-items: start; }
  .intro { display: grid; gap: 10px; padding-bottom: 32px; border-bottom: 1px solid var(--line); }
  .intro__price { font: 450 clamp(1.75rem, 1.3rem + 1.4vw, 2.4rem)/1.1 var(--font-display); }
  .intro__title { font-size: clamp(1.6rem, 1.25rem + 1.1vw, 2.2rem); max-width: 28ch; }
  .intro__facts { display: flex; flex-wrap: wrap; font-size: 1.0625rem; }
  .intro__facts span + span::before { content: '·'; margin: 0 10px; color: var(--line-strong); }
  .intro__place { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; color: var(--muted); }
  .intro__ref { margin-left: 12px; font-size: 0.875rem; }
  .block { padding-block: 36px; border-bottom: 1px solid var(--line); }
  .block:last-child { border-bottom: 0; }
  .block__h { font-size: var(--step-2); margin-bottom: 20px; }
  .block__sub { font: 600 0.9375rem/1.3 var(--font-sans); margin: 28px 0 12px; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; }
  .facts div { display: flex; justify-content: space-between; gap: 16px; padding-block: 12px; border-bottom: 1px solid var(--line); }
  .facts dt { color: var(--muted); }
  .facts dd { font-weight: 600; text-align: right; }
  .feats { display: flex; flex-wrap: wrap; gap: 8px; }
  .feats li { padding: 8px 14px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.9375rem; }
  .note { margin-top: 10px; }

  .side { position: sticky; top: 24px; }
  .side__card { background: var(--paper); border: 1px solid var(--line); padding: 28px; display: grid; gap: 20px; }
  .side__call { width: 100%; gap: 8px; }
  .side__h { font-size: 1.375rem; padding-top: 20px; border-top: 1px solid var(--line); }
  .side__team { line-height: 1.5; }
  .side :global(.enquiry-grid) { grid-template-columns: minmax(0, 1fr); }

  .similar { background: var(--paper); border-top: 1px solid var(--line); }
  .similar__h { margin-bottom: 40px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 28px; }

  .bar { display: none; }
  @media (max-width: 1023px) {
    .body { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; }
    .grid3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bar {
      display: grid; grid-template-columns: 1fr 1fr; gap: 10px; position: fixed; z-index: 20; inset: auto 0 0 0;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: var(--ivory); border-top: 1px solid var(--line);
      box-shadow: 0 -6px 20px rgb(0 0 0 / 0.06);
    }
    .bar .cta { min-height: 48px; }
    .bar__msg:only-child { grid-column: 1 / -1; }
  }
  @media (max-width: 639px) {
    .facts { grid-template-columns: minmax(0, 1fr); }
    .grid3 { grid-template-columns: minmax(0, 1fr); }
    .side__card { padding: 22px 18px; }
  }
</style>
