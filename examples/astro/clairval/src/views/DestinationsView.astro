---
/** Destinations: one full-width band per office region, photo and one line, with live counts. */
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import Site from '../layouts/Site.astro';
import PageHead from '../components/PageHead.astro';
import { siteData, sites } from '../lib/data';
import { href, type L } from '../lib/routes';
import { cityName, joinList, tx } from '../lib/copy';
import { destinations } from '../lib/regions';
import { placeOf } from '../content/places';

interface Props { l: L }
const { l } = Astro.props;
const t = tx(l);
const [{ org, teams }, all] = await Promise.all([siteData(), sites.allListings()]);
const dests = destinations(teams, all);
const C = {
  en: { title: 'Destinations', lede: 'Where we sell and let, and what you find there.', props: (n: number) => `${n} ${n === 1 ? 'property' : 'properties'} available`, in: 'in' },
  fr: { title: 'Destinations', lede: 'Où nous vendons et louons, et ce que vous y trouvez.', props: (n: number) => `${n} ${n === 1 ? 'bien disponible' : 'biens disponibles'}`, in: 'à' },
}[l];
---
<Site l={l} route="destinations" title={`${C.title} | ${org.name}`} description={`${C.title}: ${joinList(dests.map((d) => cityName(d.team.address.city, l)), l)}`}>
  <PageHead crumbLabel={t('breadcrumb')} crumbs={[{ label: t('home'), href: href('home', l) }, { label: t('navDestinations') }]} title={C.title} lede={C.lede} />
  <ul class="plain bands">
    {dests.map((d, i) => {
      const p = placeOf(d.slug);
      const photo = p?.photos[0] ? { url: p.photos[0].url, alt: p.photos[0].alt[l] } : d.available[0]?.photos[0];
      const name = cityName(d.team.address.city, l) || d.team.name;
      return (
        <li>
          <a class="band on-ink" href={href('destinations', l, d.slug)}>
            {photo && <RaImage src={photo} alt={photo.alt} width={1600} height={700} sizes="100vw" priority={i === 0} mobile={{ width: 800, height: 900 }} />}
            <span class="band__scrim" aria-hidden="true"></span>
            <span class="wrap band__text">
              <span class="band__name">{name}</span>
              {p && <span class="band__line">{p.line[l]}</span>}
              <span class="band__count">{C.props(d.available.length)}{d.places.length > 1 && ` · ${joinList(d.places.slice(0, 4).map((x) => cityName(x.city, l)), l)}`}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</Site>

<style>
  .bands { display: grid; gap: 4px; padding-bottom: 4px; }
  .band { position: relative; display: flex; align-items: flex-end; min-height: clamp(420px, 60vh, 640px); overflow: hidden; text-decoration: none; }
  .band :global(img), .band :global(picture) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .band:hover :global(img) { transform: scale(1.02); }
  .band__scrim { position: absolute; inset: 0; background: linear-gradient(0deg, rgb(10 9 8 / 0.75), rgb(10 9 8 / 0.1) 60%); }
  .band__text { position: relative; display: grid; gap: 10px; padding-bottom: clamp(32px, 5vw, 64px); }
  .band__name { font: 420 clamp(2.6rem, 1.6rem + 4vw, 5rem)/1 var(--font-display); }
  .band__line { font-size: var(--step-1); max-width: 52ch; }
  .band__count { color: var(--on-ink-muted); }
  .band:hover .band__name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.12em; }
</style>
