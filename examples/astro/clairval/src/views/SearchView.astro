---
/**
 * Buy and Rent: the kit's ListingsSearch (filters, chips, count, sort, list
 * and map views, pagination, empty states) over one pool of the offer type,
 * with the site's card in its slot. Title, h1 and description follow every
 * active filter. No price filter: the listings are in CHF and EUR, and the
 * kit's filter compares raw amounts and labels them in CHF (kit gap).
 */
import ListingsSearch from '@realadvisor/sites-kit-astro/components/ListingsSearch.astro';
import { parseSearch, runSearch } from '@realadvisor/sites-kit-core/search';
import { img } from '@realadvisor/sites-kit-core/image';
import { count as kcount, t as kt, lang as klang } from '@realadvisor/sites-kit-core/i18n';
import Site from '../layouts/Site.astro';
import Crumbs from '../components/Crumbs.astro';
import ListingCard from '../components/ListingCard.astro';
import { siteData, sites } from '../lib/data';
import { href, listingHref, LOCALE, type L } from '../lib/routes';
import { cityName, joinList, tx } from '../lib/copy';
import { price, typeLabel } from '../lib/format';

interface Props { l: L; offer: 'buy' | 'rent' }
const { l, offer } = Astro.props;
const t = tx(l);
const lg = klang(LOCALE[l]);
const locale = LOCALE[l];
const route = offer;
const [{ org, teams }, pool] = await Promise.all([siteData(), sites.allListings({ offer_type: offer })]);
const byId = new Map(pool.map((x) => [x.id, x]));
const params = { ...parseSearch(Astro.url.searchParams), offerType: undefined };
// Sold listings have their own page: this search shows what is on the market.
params.status = 'available';
const result = runSearch(pool, params, { locale });
const base = href(route, l);
const cities = joinList(teams.map((x) => cityName(x.address.city, l)).filter(Boolean), l);
const C = {
  en: { buy: 'Properties for sale', rent: 'Properties to rent', ledeBuy: `Houses, chalets and apartments for sale in ${cities}.`, ledeRent: `Seasonal and long-term rentals in ${cities}. Rents are per month.` },
  fr: { buy: 'Biens à vendre', rent: 'Biens à louer', ledeBuy: `Maisons, chalets et appartements à vendre à ${cities}.`, ledeRent: `Locations saisonnières et à l’année à ${cities}. Loyers mensuels.` },
}[l];
const parts = [
  offer === 'buy' ? C.buy : C.rent,
  params.propertyType && typeLabel(params.propertyType, l),
  params.city && t('inCity', { city: cityName(params.city, l) }),
  params.minRooms && kt('roomsMin', { n: String(params.minRooms) }, lg),
].filter(Boolean) as string[];
const heading = parts.join(' · ');
const suffix = `${params.view === 'map' ? ` – ${t('mapView')}` : ''}${result.page > 1 ? ` – ${t('page')} ${result.page}` : ''}`;
const first = result.items.find((x) => x.photos[0])?.photos[0];
const kitPrice = (x: { id: string }) => {
  const s = byId.get(x.id);
  return s ? price(s, l) : '';
};
---
<Site l={l} route={route}
  title={`${heading}${suffix} | ${org.name}`}
  description={`${kcount('listingsFound', result.total, lg)} – ${heading} – ${org.name}`}
  image={first && img(first.url, { w: 1200, h: 630 })}>
  <section class="sh">
    <div class="wrap">
      <Crumbs label={t('breadcrumb')} items={[{ label: t('home'), href: href('home', l) }, { label: offer === 'buy' ? t('navBuy') : t('navRent') }]} />
      <div class="sh__row">
        <div>
          <h1 class="sh__title" data-rs-sync="h1">{heading}{suffix}</h1>
          <p class="lede">{offer === 'buy' ? C.ledeBuy : C.ledeRent}</p>
        </div>
        <nav class="switch" aria-label={`${t('navBuy')} / ${t('navRent')}`}>
          <a href={href('buy', l)} aria-current={offer === 'buy' ? 'page' : undefined}>{t('navBuy')}</a>
          <a href={href('rent', l)} aria-current={offer === 'rent' ? 'page' : undefined}>{t('navRent')}</a>
        </nav>
      </div>
    </div>
  </section>
  <div class="wrap search">
    <ListingsSearch result={result} base={base} locale={locale} sold={false}
      filters={['propertyType', 'city', 'rooms']}
      contactHref={href('contact', l)} valuationHref={href('sell', l)}
      listingHref={(x) => listingHref(x, l)} price={kitPrice}>
      {(x: (typeof result.items)[number], i: number) => {
        const s = byId.get(x.id);
        return s ? <ListingCard listing={s} l={l} priority={i === 0} as="h2" /> : null;
      }}
    </ListingsSearch>
  </div>
</Site>

<style>
  .sh { padding-block: clamp(24px, 3vw, 40px) 8px; }
  .sh__row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 40px; margin-top: clamp(16px, 2.5vw, 32px); }
  .sh__title { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.4rem); }
  .sh .lede { margin-top: 12px; font-size: 1.0625rem; }
  .switch { display: inline-flex; padding: 4px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--paper); }
  .switch a { display: inline-flex; align-items: center; min-height: 42px; padding: 0 22px; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 0.9375rem; }
  .switch a[aria-current] { background: var(--ink); color: var(--on-ink); }
  .search { padding-top: 24px; padding-bottom: var(--section); }
  .search :global(.rs-grid) { row-gap: 48px; }
</style>
