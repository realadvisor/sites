---
/**
 * Static map from OpenStreetMap tiles (the one map host the CSP allows): a
 * mosaic of lazy tiles centred on the point, no JavaScript, no library.
 * `area`: the address is rounded, so it draws a zone instead of a pin.
 */
interface Props {
  lat: number;
  lng: number;
  zoom?: number;
  label: string;
  area?: boolean;
  height?: number;
  linkLabel: string;
  /** Several labelled points (office map): drawn around the centre lat/lng. */
  points?: { lat: number; lng: number; label: string; href?: string }[];
  class?: string;
}
const { lat, lng, zoom = 14, label, area = false, height = 380, linkLabel, points, class: cls } = Astro.props;
const n = 2 ** zoom;
const fx = ((lng + 180) / 360) * n;
const rad = (lat * Math.PI) / 180;
const fy = ((1 - Math.log(Math.tan(rad) + 1 / Math.cos(rad)) / Math.PI) / 2) * n;
const cx = Math.floor(fx);
const cy = Math.floor(fy);
// Offset of the point inside its tile, in px.
const ox = Math.round((fx - cx) * 256);
const oy = Math.round((fy - cy) * 256);
const tiles: { x: number; y: number; dx: number; dy: number }[] = [];
const rows = height <= 512 ? 1 : 2;
for (let dy = -rows; dy <= rows; dy++) for (let dx = -3; dx <= 3; dx++) tiles.push({ x: (cx + dx + n) % n, y: cy + dy, dx, dy });
const world = (la: number, ln: number) => {
  const r = (la * Math.PI) / 180;
  return { x: ((ln + 180) / 360) * n * 256, y: ((1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2) * n * 256 };
};
const c = world(lat, lng);
const pins = (points ?? []).map((p) => { const w = world(p.lat, p.lng); return { ...p, dx: Math.round(w.x - c.x), dy: Math.round(w.y - c.y) }; });
const osm = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=${zoom + 1}/${lat}/${lng}`;
---
<figure class:list={['smap', cls]} style={`--h:${height}px`}>
  <div class="smap__view" role={pins.length ? "group" : "img"} aria-label={label}>
    <div class="smap__tiles" style={`transform: translate(${-ox}px, ${-oy}px)`}>
      {tiles.map((t) => (
        <img src={`https://tile.openstreetmap.org/${zoom}/${t.x}/${t.y}.png`} alt="" width="256" height="256" loading="lazy" decoding="async"
          style={`left: calc(50% + ${t.dx * 256}px); top: calc(50% + ${t.dy * 256}px)`} />
      ))}
    </div>
    {pins.length === 0 && <span class:list={['smap__mark', { 'smap__mark--area': area }]} aria-hidden="true"></span>}
    {pins.map((p) => (
      p.href
        ? <a class="smap__pin" href={p.href} style={`left: calc(50% + ${p.dx}px); top: calc(50% + ${p.dy}px)`}><span>{p.label}</span></a>
        : <span class="smap__pin" style={`left: calc(50% + ${p.dx}px); top: calc(50% + ${p.dy}px)`}><span>{p.label}</span></span>
    ))}
  </div>
  <figcaption class="smap__cap">
    <span>© <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a></span>
    <a href={osm} rel="noopener">{linkLabel} ↗</a>
  </figcaption>
</figure>

<style>
  .smap { margin: 0; display: grid; gap: 8px; }
  .smap__view { position: relative; height: var(--h); overflow: hidden; background: #e8e6e1; }
  .smap__tiles { position: absolute; inset: 0; }
  .smap__tiles img { position: absolute; width: 256px; height: 256px; max-width: none; filter: saturate(0.35) contrast(0.95) brightness(1.03); }
  .smap__mark { position: absolute; left: 50%; top: 50%; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 4px #fff, 0 2px 10px rgb(0 0 0 / 0.3); }
  .smap__mark--area { width: 120px; height: 120px; margin: -60px 0 0 -60px; background: color-mix(in srgb, var(--ink) 18%, transparent); border: 2px solid var(--ink); box-shadow: none; }
  .smap__pin { position: absolute; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 4px #fff, 0 2px 10px rgb(0 0 0 / 0.3); text-decoration: none; }
  .smap__pin span { position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); white-space: nowrap; background: var(--ink); color: #fff; padding: 6px 10px; font: 600 0.75rem/1 var(--font-sans); letter-spacing: 0.1em; text-transform: uppercase; }
  a.smap__pin:hover span, a.smap__pin:focus-visible span { background: var(--ink-2); text-decoration: underline; }
  .smap__cap { display: flex; justify-content: space-between; gap: 16px; font-size: 0.8125rem; color: var(--muted); }
  .smap__cap a { color: var(--ink); min-height: 32px; display: inline-flex; align-items: center; }
</style>
