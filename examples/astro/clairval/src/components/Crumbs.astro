---
/** Breadcrumb trail: links, the last item is the current page. */
interface Props { label: string; items: { label: string; href?: string }[]; tone?: 'dark' | 'light' }
const { label, items, tone = 'dark' } = Astro.props;
---
<nav class:list={['crumbs', `crumbs--${tone}`]} aria-label={label}>
  <ol class="plain">
    {items.map((x, i) => (
      <li>{x.href && i < items.length - 1 ? <a href={x.href}>{x.label}</a> : <span aria-current={i === items.length - 1 ? 'page' : undefined}>{x.label}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0 2px; font-size: 0.875rem; color: var(--muted); }
  .crumbs li + li::before { content: '/'; margin: 0 8px; color: var(--line-strong); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 32px; text-decoration: none; color: var(--muted); }
  .crumbs a:hover { color: var(--text); text-decoration: underline; }
  .crumbs span { display: inline-flex; align-items: center; min-height: 32px; }
  .crumbs--light ol, .crumbs--light a { color: var(--on-ink-muted); }
  .crumbs--light li + li::before { color: rgb(246 243 237 / 0.35); }
  .crumbs--light a:hover { color: var(--on-ink); }
</style>
