---
/**
 * Page opening on ivory: breadcrumb, h1, optional lede and a slot for links
 * or figures. Plain and left-aligned; no eyebrow.
 */
import Crumbs from './Crumbs.astro';
interface Props { crumbs?: { label: string; href?: string }[]; crumbLabel?: string; title: string; lede?: string; sync?: boolean }
const { crumbs, crumbLabel = 'Breadcrumb', title, lede, sync = false } = Astro.props;
---
<section class="ph">
  <div class="wrap">
    {crumbs && <Crumbs label={crumbLabel} items={crumbs} />}
    <h1 class="h1 ph__title" data-rs-sync={sync ? 'h1' : undefined}>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .ph { padding-block: clamp(28px, 4vw, 48px) clamp(36px, 5vw, 64px); }
  .ph__title { margin-top: clamp(20px, 3vw, 40px); font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem); max-width: 22ch; }
  .ph .lede { margin-top: 18px; }
</style>
