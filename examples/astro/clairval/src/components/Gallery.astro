---
/**
 * Listing gallery, 1 + 4: one large photo and a 2 x 2 grid beside it, with
 * "View all photos" on the last tile. Every tile opens a dialog with all the
 * photos in one column, whole (object-fit: contain), at the clicked photo.
 * Phone: the same tiles become a swipeable strip of every photo with a
 * "1 / 9" counter (one set of images, one LCP photo).
 */
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import type { Photo } from '@realadvisor/sites-sdk/types';
import type { L } from '../lib/routes';

interface Props { photos: Photo[]; title: string; l: L; badge?: string }
const { photos, title, l, badge } = Astro.props;
const C = {
  en: { all: (n: number) => `View all ${n} photos`, close: 'Close', photos: 'Photos', of: 'of', photo: 'Photo' },
  fr: { all: (n: number) => `Voir les ${n} photos`, close: 'Fermer', photos: 'Photos', of: 'sur', photo: 'Photo' },
}[l];
const alt = (p: Photo, i: number) => p.alt || `${title}, ${C.photo.toLowerCase()} ${i + 1}`;
const tiles = photos.slice(1, 5);
const n = photos.length;
---
{n > 0 && (
  <div class="gal" data-gallery>
    <div class:list={['gal__grid', `gal__grid--${Math.min(n, 5)}`]}>
      <a class="gal__tile gal__tile--main" href="#photo-1" data-open="0" aria-label={`${C.photo} 1 ${C.of} ${n}`}>
        <RaImage src={photos[0]} alt={alt(photos[0]!, 0)} width={1200} height={900} priority sizes="(min-width: 1024px) 50vw, 100vw" />
        {badge && <span class="gal__badge">{badge}</span>}
      </a>
      {tiles.map((p, i) => (
        <a class="gal__tile" href={`#photo-${i + 2}`} data-open={i + 1} aria-label={`${C.photo} ${i + 2} ${C.of} ${n}`}>
          <RaImage src={p} alt={alt(p, i + 1)} width={600} height={450} sizes="(min-width: 1024px) 25vw, 50vw" />
        </a>
      ))}
      {photos.slice(5).map((p, i) => (
        <a class="gal__tile gal__tile--extra" href={`#photo-${i + 6}`} data-open={i + 5} aria-label={`${C.photo} ${i + 6} ${C.of} ${n}`}>
          <RaImage src={p} alt={alt(p, i + 5)} width={800} height={600} sizes="100vw" widths={[480, 800, 1000]} />
        </a>
      ))}
      {n > 1 && (
        <button type="button" class="gal__all" data-open="0">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M1 1h4v4H1zM6 1h4v4H6zM11 1h4v4h-4zM1 6h4v4H1zM6 6h4v4H6zM11 6h4v4h-4zM1 11h4v4H1zM6 11h4v4H6zM11 11h4v4h-4z" /></svg>
          {C.all(n)}
        </button>
      )}
    </div>

    {n > 1 && <button type="button" class="gal__count num" data-open="0" aria-label={C.all(n)}><span data-count>1</span> / {n}</button>}

    <dialog class="gal__dlg" aria-label={`${C.photos}: ${title}`} data-dialog>
      <div class="gal__bar">
        <p class="gal__dlg-title">{title} <span class="num">· {n} {C.photos.toLowerCase()}</span></p>
        <button type="button" class="gal__close" data-close aria-label={C.close}>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 5l14 14M19 5L5 19" /></svg>
          <span>{C.close}</span>
        </button>
      </div>
      <ol class="gal__list plain">
        {photos.map((p, i) => (
          <li id={`photo-${i + 1}`} data-photo={i}>
            <RaImage src={p} alt={alt(p, i)} width={1600} height={1200} fit="fit" sizes="(min-width: 1200px) 1100px, 100vw" widths={[800, 1200, 1600]} />
          </li>
        ))}
      </ol>
    </dialog>
  </div>
)}

<script>
  import '../scripts/gallery';
</script>

<style>
  .gal { position: relative; }
  .gal__grid { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 8px; aspect-ratio: 2.35 / 1; position: relative; }
  .gal__grid--1 { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  .gal__grid--2 { grid-template-columns: 2fr 1fr; grid-template-rows: 1fr; }
  .gal__grid--3 { grid-template-columns: 2fr 1fr; }
  .gal__grid--4 { grid-template-columns: 2fr 1fr 1fr; }
  .gal__grid--4 .gal__tile:nth-child(4) { grid-column: 2 / 4; }
  .gal__tile { position: relative; display: block; overflow: hidden; background: var(--line); }
  .gal__tile--main { grid-row: 1 / -1; }
  .gal__tile :global(img), .gal__tile :global(picture) { width: 100%; height: 100%; object-fit: cover; }
  .gal__tile :global(img) { transition: transform .8s cubic-bezier(.2,.7,.2,1), filter .3s; }
  .gal__tile:hover :global(img) { transform: scale(1.02); filter: brightness(0.94); }
  .gal__badge { position: absolute; left: 18px; top: 18px; padding: 8px 14px; border-radius: 999px; background: var(--ink); color: var(--on-ink); font: 600 0.8125rem/1 var(--font-sans); }
  .gal__all {
    position: absolute; right: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 10px;
    min-height: 44px; padding: 0 20px; border: 0; border-radius: 999px; background: var(--paper); color: var(--ink);
    font: 600 0.9375rem/1 var(--font-sans); cursor: pointer; box-shadow: 0 2px 12px rgb(0 0 0 / 0.18);
  }
  .gal__all:hover { background: var(--ivory); }
  .gal__tile--extra, .gal__count { display: none; }

  @media (max-width: 767px) {
    .gal { margin-inline: calc(-1 * var(--gutter)); }
    .gal__grid { display: flex; aspect-ratio: auto; gap: 0; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .gal__grid::-webkit-scrollbar { display: none; }
    .gal__tile, .gal__tile--extra { display: block; flex: 0 0 100%; scroll-snap-align: start; aspect-ratio: 4 / 3; }
    .gal__all { display: none; }
    .gal__count { display: block; position: absolute; right: 12px; bottom: 12px; padding: 6px 12px; border-radius: 999px; background: rgb(18 17 16 / 0.72); color: #fff; font-size: 0.8125rem; font-weight: 600; border: 0; min-height: 36px; cursor: pointer; }
  }

  .gal__dlg { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: var(--ivory); color: var(--ink); }
  .gal__dlg::backdrop { background: rgb(10 9 8 / 0.6); }
  .gal__dlg[open] { display: block; }
  .gal__bar { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px var(--gutter); background: var(--ivory); border-bottom: 1px solid var(--line); }
  .gal__dlg-title { font: 420 1.125rem/1.3 var(--font-display); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gal__dlg-title span { font: 400 0.9375rem var(--font-sans); color: var(--muted); }
  .gal__close { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--paper); cursor: pointer; font-weight: 600; flex: none; }
  .gal__list { display: grid; gap: 12px; max-width: 1100px; margin: 0 auto; padding: 24px var(--gutter) 64px; }
  .gal__list li { scroll-margin-top: 80px; }
  .gal__list :global(img) { width: 100%; height: auto; max-height: calc(100vh - 120px); object-fit: contain; background: var(--line); }
</style>
