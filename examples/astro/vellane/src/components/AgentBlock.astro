---
/**
 * One agent: a 4:5 portrait when `agent.photo` is set, else plain type only
 * (no initials, no placeholder). Name (linked to the agent page), role,
 * agency, languages, phone and e-mail.
 */
import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';
import type { Agent, Team } from '../lib/data';
import { agentHref, agentName, languages, tel, teamShortName } from '../lib/site';

interface Props {
  agent: Agent;
  team?: Team;
  /** card: portrait above (grids); row: portrait left (contact cards). */
  layout?: 'card' | 'row';
  as?: 'h2' | 'h3' | 'p';
  link?: boolean;
}
const { agent: a, team, layout = 'card', as: H = 'h3', link = true } = Astro.props;
const name = agentName(a);
const langs = languages(a.languages);
---
<div class:list={['ag', `ag--${layout}`, { 'has-photo': !!a.photo }]}>
  {a.photo && (
    <div class="ag__photo">
      <RaImage src={a.photo} alt={a.photo.alt || name} width={400} height={500} sizes={layout === 'row' ? '96px' : '(min-width: 960px) 280px, 45vw'} />
    </div>
  )}
  <div class="ag__body">
    <H class="ag__name">{link ? <a href={agentHref(a)}>{name}</a> : name}</H>
    {(a.title || team) && <p class="ag__role">{[a.title, team && `Vellane ${teamShortName(team)}`].filter(Boolean).join(' · ')}</p>}
    {langs && <p class="ag__langs">Parle {langs}</p>}
    <p class="ag__contact">
      {a.phone && <a href={tel(a.phone)} class="num">{a.phone}</a>}
      {a.email && <a href={`mailto:${a.email}`}>{a.email}</a>}
    </p>
  </div>
</div>

<style>
  .ag { display: grid; gap: 14px; align-content: start; min-width: 0; }
  .ag--row.has-photo { grid-template-columns: 96px minmax(0, 1fr); align-items: start; gap: 16px; }
  .ag__photo { border-radius: var(--radius-img); overflow: hidden; background: var(--surface); aspect-ratio: 4 / 5; }
  .ag__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ag__body { display: grid; gap: 2px; min-width: 0; }
  .ag__name { font-size: 1.125rem; font-weight: 650; letter-spacing: -0.01em; }
  .ag__name a { text-decoration: none; }
  .ag__name a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ag__role, .ag__langs { color: var(--muted); font-size: 0.9375rem; }
  .ag__contact { display: grid; margin-top: 6px; font-size: 0.9375rem; }
  .ag__contact a { display: inline-flex; align-items: center; min-height: 32px; text-decoration: none; overflow-wrap: anywhere; color: var(--text); }
  .ag__contact a:hover { color: var(--accent-strong); text-decoration: underline; }
</style>
