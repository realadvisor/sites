---
/**
 * DPE scale (A to G) with the listing's class marked. Shows only what the
 * data has: no class, "DPE en cours". The consumption value and the GES
 * class are not in the data: the line under the scale says so.
 */
interface Props { grade?: string }
const g = Astro.props.grade?.toUpperCase();
const grade = g && /^[A-G]$/.test(g) ? g : undefined;
const STEPS = [
  ['A', '#137a3b', '#fff'], ['B', '#4ea443', '#1c1917'], ['C', '#a2c240', '#1c1917'], ['D', '#f1df3b', '#1c1917'],
  ['E', '#f3b23b', '#1c1917'], ['F', '#ec7a32', '#1c1917'], ['G', '#c9302a', '#fff'],
] as const;
---
<figure class="dpe">
  <figcaption class="dpe__cap">
    Diagnostic de performance énergétique (DPE){grade ? <Fragment> : <strong>classe {grade}</strong></Fragment> : <Fragment> : <strong>en cours</strong></Fragment>}
  </figcaption>
  <ol class="dpe__scale" aria-label="Échelle DPE de A à G">
    {STEPS.map(([k, c, ink], i) => (
      <li class:list={['dpe__step', { 'is-on': k === grade }]} style={`--c:${c};--ink:${ink};--w:${42 + i * 9}%`} aria-current={k === grade ? 'true' : undefined}>
        <span class="dpe__bar">{k}</span>
        {k === grade && <span class="dpe__mark">Ce bien</span>}
      </li>
    ))}
  </ol>
  <p class="dpe__note">Consommation, émissions (GES) et estimation des coûts annuels : sur le diagnostic complet, à demander à l'agent.</p>
</figure>

<style>
  .dpe { margin: 0; display: grid; gap: 12px; }
  .dpe__cap { font-weight: 600; }
  .dpe__scale { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; max-width: 420px; }
  .dpe__step { display: flex; align-items: center; gap: 12px; }
  .dpe__bar {
    width: var(--w); min-height: 26px; display: flex; align-items: center; padding-left: 10px; background: var(--c); color: var(--ink);
    font-weight: 700; font-size: 0.875rem; clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 0 100%);
  }
  .dpe__step:not(.is-on) .dpe__bar { min-height: 22px; font-size: 0.75rem; }
  .is-on .dpe__bar { min-height: 36px; font-size: 1.0625rem; box-shadow: inset 0 0 0 2px rgb(0 0 0 / 0.25); }
  .dpe__mark { font-weight: 650; font-size: 0.875rem; }
  .dpe__note { color: var(--muted); font-size: 0.875rem; max-width: 60ch; }
</style>
