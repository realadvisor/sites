---
/**
 * Listing gallery. Desktop: one large photo and up to four tiles (1 + 4),
 * fewer photos fill the grid differently. Phone: a swipeable strip with a
 * "1 / 6" counter. "Toutes les photos" opens a dialog with every photo at
 * its own ratio (object-fit: contain). The first photo is the page's LCP.
 */
import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';
import type { Photo } from '@realadvisor/sites-sdk/types';
import Icon from './Icon.astro';

interface Props { photos: Photo[]; label: string; noPhotoText: string }
const { photos, label, noPhotoText } = Astro.props;
const n = photos.length;
const alt = (p: Photo, i: number) => p.alt || `${label}, photo ${i + 1}`;
---
{n === 0 ? (
  <div class="gal gal--none"><span>{noPhotoText}</span></div>
) : (
  <div class={`gal gal--${Math.min(n, 5)}`} data-gallery>
    <ul class="gal__grid" aria-label={`Photos (${n})`} data-gal-strip>
      {photos.map((p, i) => (
        <li class:list={['gal__item', { 'gal__item--extra': i >= 5 }]}>
          <button type="button" class="gal__open" data-gal-open={i} aria-label={`Agrandir la photo ${i + 1} sur ${n}`} disabled>
            <RaImage src={p} alt={alt(p, i)} width={i === 0 ? 1200 : 600} height={i === 0 ? 800 : 400} priority={i === 0}
              sizes={i === 0 ? '(min-width: 960px) 50vw, 100vw' : '(min-width: 960px) 25vw, 100vw'} />
          </button>
        </li>
      ))}
    </ul>
    <p class="gal__count" aria-hidden="true"><span data-gal-index>1</span> / {n}</p>
    {n > 1 && (
      <button type="button" class="gal__all" data-gal-open="0" hidden>
        <Icon name="grid" size={16} /> Toutes les photos ({n})
      </button>
    )}
    <dialog class="gal__dlg" data-gal-dialog aria-label={`Photos : ${label}`}>
      <div class="gal__bar">
        <p>{label} · {n} photos</p>
        <button type="button" class="gal__close" data-gal-close aria-label="Fermer"><Icon name="close" size={22} /></button>
      </div>
      <ol class="gal__list">
        {photos.map((p, i) => (
          <li id={`photo-${i}`}>
            <RaImage src={p} alt={alt(p, i)} width={1600} height={1066} fit="fit" sizes="(min-width: 1100px) 1000px, 100vw" />
          </li>
        ))}
      </ol>
    </dialog>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const dlg = g.querySelector<HTMLDialogElement>('[data-gal-dialog]');
    const strip = g.querySelector<HTMLElement>('[data-gal-strip]');
    const index = g.querySelector<HTMLElement>('[data-gal-index]');
    if (!dlg || typeof dlg.showModal !== 'function') return;
    g.querySelectorAll<HTMLButtonElement>('[data-gal-open]').forEach((b) => {
      b.disabled = false;
      b.hidden = false;
      b.addEventListener('click', () => {
        dlg.showModal();
        document.body.classList.add('is-locked');
        const i = Number(b.dataset.galOpen) || 0;
        dlg.querySelector(`#photo-${i}`)?.scrollIntoView({ block: 'start' });
      });
    });
    dlg.querySelector('[data-gal-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', () => document.body.classList.remove('is-locked'));
    dlg.addEventListener('click', (e) => e.target === dlg && dlg.close());
    // Phone strip: the counter follows the swipe.
    if (strip && index) {
      const items = [...strip.children] as HTMLElement[];
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && (index.textContent = String(items.indexOf(e.target as HTMLElement) + 1))),
        { root: strip, threshold: 0.6 },
      );
      items.forEach((it) => io.observe(it));
    }
  });
</script>

<style>
  .gal { position: relative; }
  .gal--none { display: grid; place-items: center; aspect-ratio: 16 / 7; border-radius: var(--radius-card); background: var(--surface); color: var(--muted); font-weight: 550; }
  .gal__grid { list-style: none; margin: 0; padding: 0; }
  .gal__open { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: var(--surface); cursor: zoom-in; }
  .gal__open:disabled { cursor: default; }
  .gal__open :global(img) { width: 100%; height: 100%; object-fit: cover; transition: filter 0.2s; }
  .gal__open:not(:disabled):hover :global(img) { filter: brightness(0.92); }
  .gal__open:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .gal__count {
    position: absolute; right: 12px; bottom: 12px; padding: 4px 10px; border-radius: 999px; background: rgb(28 25 23 / 0.75); color: #fff;
    font-size: 0.8125rem; font-weight: 600; font-variant-numeric: tabular-nums;
  }
  .gal__all {
    position: absolute; right: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px;
    border: 1px solid var(--text); border-radius: 999px; background: var(--bg); color: var(--text); font-weight: 600; font-size: 0.875rem; cursor: pointer;
  }
  .gal__all:hover { background: var(--surface); }

  /* Phone: a strip, one photo per screen. */
  @media (max-width: 959px) {
    .gal { margin-inline: calc(var(--gutter) * -1); }
    .gal__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .gal__grid::-webkit-scrollbar { display: none; }
    .gal__item { flex: 0 0 100%; scroll-snap-align: center; aspect-ratio: 4 / 3; }
    .gal__all { display: none; }
    .gal--1 .gal__count { display: none; }
  }
  /* Desktop: 1 + 4 (or fewer) */
  @media (min-width: 960px) {
    .gal__count { display: none; }
    .gal__grid { display: grid; gap: 8px; height: clamp(380px, 38vw, 560px); border-radius: var(--radius-card); overflow: hidden; }
    .gal__item { min-height: 0; min-width: 0; }
    .gal__item--extra { display: none; }
    .gal--1 .gal__grid { grid-template-columns: 1fr; }
    .gal--2 .gal__grid { grid-template-columns: 3fr 2fr; }
    .gal--3 .gal__grid { grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; }
    .gal--3 .gal__item:first-child { grid-row: 1 / 3; }
    .gal--4 .gal__grid { grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 1fr 1fr; }
    .gal--4 .gal__item:first-child { grid-row: 1 / 3; }
    .gal--4 .gal__item:nth-child(4) { grid-column: 2 / 4; }
    .gal--5 .gal__grid { grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 1fr 1fr; }
    .gal--5 .gal__item:first-child { grid-row: 1 / 3; }
  }

  .gal__dlg { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: var(--bg); color: var(--text); }
  .gal__dlg::backdrop { background: rgb(0 0 0 / 0.6); }
  .gal__bar { position: sticky; top: 0; z-index: 1; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 8px var(--gutter); background: var(--bg); border-bottom: 1px solid var(--line); font-weight: 600; }
  .gal__close { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 999px; background: var(--surface); color: var(--text); cursor: pointer; }
  .gal__list { list-style: none; margin: 0 auto; padding: 24px var(--gutter) 64px; max-width: 1040px; display: grid; gap: 16px; }
  .gal__list :global(img) { width: 100%; height: auto; max-height: 86vh; object-fit: contain; border-radius: 8px; background: var(--surface); }
</style>
