---
export const prerender = false;
/**
 * One city (3+ listings): a wide place photo with the name, the site's own
 * short text, figures computed from the listings, then its listings for sale
 * and to rent, with links into the split search for that city.
 */
import RaImage from '@realadvisor/sites-kit-astro/components/RaImage.astro';
import { img } from '@realadvisor/sites-kit-core/image';
import Site from '../../layouts/Site.astro';
import ListingCard from '../../components/ListingCard.astro';
import Icon from '../../components/Icon.astro';
import { siteData, sites } from '../../lib/data';
import { citiesOf, formatAmount, R, searchUrl, teamHref, teamShortName } from '../../lib/site';
import { placeFor } from '../../content/places';
import { CITY_TEXT } from '../../content/cities';

const [{ org, teams }, all] = await Promise.all([siteData(), sites.allListings()]);
const area = citiesOf(all).find((c) => c.slug === Astro.params.slug);
if (!area) return Astro.rewrite('/404');
const { city, slug, listings } = area;
const buy = listings.filter((l) => l.status === 'available' && l.offer_type === 'buy');
const rent = listings.filter((l) => l.status === 'available' && l.offer_type === 'rent');
const sold = listings.filter((l) => l.status === 'sold');
const photo = placeFor(slug)[0];
const text = CITY_TEXT[slug];
const brand = org.name.replace(/\s+SAS$/, '');
const teamsHere = teams.filter((t) => listings.some((l) => l.team_ids.includes(t.id)));
const prices = buy.flatMap((l) => (l.price && !l.price_on_request ? [l.price] : []));
const range = prices.length > 1 ? `${formatAmount(Math.min(...prices))} à ${formatAmount(Math.max(...prices))}` : undefined;
const others = citiesOf(all).filter((c) => c.slug !== slug);
---
<Site title={`Immobilier à ${city} : ${buy.length} à vendre, ${rent.length} à louer | ${brand}`}
  description={`${text?.lede ?? `Les annonces ${brand} à ${city}.`} ${buy.length} biens à vendre et ${rent.length} à louer.`}
  image={photo && img(photo.url, { w: 1200, h: 630 })}>
  <section class="hero">
    {photo && <RaImage class="hero__img" src={photo} alt={photo.alt} width={1920} height={760} sizes="100vw" priority mobile={{ width: 800, height: 900 }} />}
    <div class="hero__in wrap">
      <a class="hero__back" href={R.cities}><Icon name="back" size={18} />Toutes les villes</a>
      <h1 class="hero__h1">Immobilier à {city}</h1>
    </div>
  </section>

  <section class="wrap intro">
    <div class="intro__text">
      {text && <p class="intro__lede">{text.lede}</p>}
      {text?.body.map((p) => <p>{p}</p>)}
      {teamsHere.length > 0 && <p class="muted">Agence{teamsHere.length > 1 ? 's' : ''} : {teamsHere.map((t, i) => <Fragment>{i > 0 && ', '}<a class="link" href={teamHref(t)}>{teamShortName(t)}</a></Fragment>)}</p>}
    </div>
    <dl class="figs">
      <div><dt>À vendre</dt><dd>{buy.length}</dd></div>
      <div><dt>À louer</dt><dd>{rent.length}</dd></div>
      {range && <div class="figs__wide"><dt>Prix des biens à vendre</dt><dd class="figs__range">{range}</dd></div>}
    </dl>
  </section>

  {buy.length > 0 && (
    <section class="wrap sec" aria-labelledby="b-h">
      <div class="section-head">
        <h2 id="b-h" class="h3">À vendre à {city}</h2>
        <a class="link" href={searchUrl('buy', { city })}>Sur la carte</a>
      </div>
      <ul class="cards">{buy.slice(0, 9).map((l) => <li><ListingCard listing={l} /></li>)}</ul>
      {buy.length > 9 && <p><a class="vb vb--ghost" href={searchUrl('buy', { city })}>Les {buy.length} biens à vendre</a></p>}
    </section>
  )}
  {rent.length > 0 && (
    <section class="wrap sec" aria-labelledby="r-h">
      <div class="section-head">
        <h2 id="r-h" class="h3">À louer à {city}</h2>
        <a class="link" href={searchUrl('rent', { city })}>Sur la carte</a>
      </div>
      <ul class="cards">{rent.map((l) => <li><ListingCard listing={l} /></li>)}</ul>
    </section>
  )}
  {sold.length > 0 && (
    <section class="wrap sec" aria-labelledby="s-h">
      <h2 id="s-h" class="h3">Vendus récemment à {city}</h2>
      <ul class="cards">{sold.map((l) => <li><ListingCard listing={l} /></li>)}</ul>
    </section>
  )}
  {others.length > 0 && (
    <nav class="wrap sec" aria-label="Autres villes">
      <p class="others">Autres villes : {others.map((c, i) => <Fragment>{i > 0 && ' · '}<a class="link" href={`${R.cities}/${c.slug}`}>{c.city}</a></Fragment>)}</p>
    </nav>
  )}
</Site>

<style>
  .hero { position: relative; color: #fff; min-height: clamp(320px, 42vw, 560px); display: grid; align-items: end; overflow: hidden; }
  :global(.hero__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / 0.25) 0%, rgb(0 0 0 / 0) 35%, rgb(0 0 0 / 0.62) 100%); }
  .hero__in { position: relative; z-index: 1; display: grid; gap: 8px; padding-bottom: clamp(28px, 4vw, 48px); padding-top: 24px; }
  .hero__back { justify-self: start; display: inline-flex; gap: 8px; align-items: center; min-height: 44px; color: #fff; text-decoration: none; font-weight: 600; }
  .hero__back:hover { text-decoration: underline; }
  .hero__h1 { font-size: var(--step-4); letter-spacing: -0.035em; text-shadow: 0 1px 12px rgb(0 0 0 / 0.3); }
  .hero :focus-visible { outline-color: #fff; }

  .intro { display: grid; gap: 32px; padding-top: clamp(32px, 5vw, 64px); align-items: start; }
  @media (min-width: 960px) { .intro { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 80px; } }
  .intro__text { display: grid; gap: 16px; max-width: 64ch; font-size: 1.0625rem; }
  .intro__lede { font-size: var(--step-1); font-weight: 550; }
  .figs { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .figs div { padding: 20px; border-radius: 14px; background: var(--surface); display: grid; gap: 4px; }
  .figs dt { color: var(--muted); font-size: 0.9375rem; }
  .figs dd { margin: 0; font-size: var(--step-3); font-weight: 650; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .figs__wide { grid-column: 1 / -1; }
  .figs dd.figs__range { font-size: var(--step-1); }
  .sec { margin-top: var(--section); display: grid; gap: 24px; }
  .sec .section-head { margin-bottom: 0; }
  .others { color: var(--muted); }
</style>
