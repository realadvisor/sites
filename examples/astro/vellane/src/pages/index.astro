---
export const prerender = false;
/**
 * Home: search first. The pill opens the split results view; right under it
 * the newest listings, then the two cities as two big photo cards, rentals
 * as one scrolling row, the agencies as a plain list and the valuation offer.
 */
import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';
import { agencyJsonLd } from '@realadvisor/sites-kit/seo';
import { img } from '@realadvisor/sites-kit/image';
import Site from '../layouts/Site.astro';
import SearchPill from '../components/SearchPill.astro';
import ListingCard from '../components/ListingCard.astro';
import Icon from '../components/Icon.astro';
import { siteData, sites } from '../lib/data';
import { citySlug, cityHref, joinFr, R, searchUrl, teamHref, teamShortName, tel } from '../lib/site';
import { placeFor } from '../content/places';

const [{ org, teams, primary }, all] = await Promise.all([siteData(), sites.allListings()]);
const live = all.filter((l) => l.status === 'available');
const buy = live.filter((l) => l.offer_type === 'buy');
const rent = live.filter((l) => l.offer_type === 'rent');
const offer = buy.length ? 'buy' : 'rent';
const newest = (buy.length ? buy : live).slice(0, 8);

const byCity = new Map<string, number>();
for (const l of live) if (l.address.city) byCity.set(l.address.city, (byCity.get(l.address.city) ?? 0) + 1);
const ranked = [...byCity].sort((a, b) => b[1] - a[1]);
// The two cities with most listings, each with its own photo.
const cities = ranked
  .map(([city, n]) => ({ city, n, photo: placeFor(citySlug(city))[0] }))
  .filter((c) => c.photo)
  .slice(0, 2);
const teamCities = [...new Set(teams.map((t) => t.address.city).filter(Boolean))] as string[];
const countBy = (teamId: string) => live.filter((l) => l.team_ids.includes(teamId)).length;
const plural = (n: number, one: string, many: string) => `${n} ${n > 1 ? many : one}`;

const brand = org.name.replace(/\s+(SAS|SA|SARL)$/, '');
const title = `${brand} · Achat, location et estimation à ${joinFr(teamCities)}`;
const description = `${plural(buy.length, 'bien', 'biens')} à vendre et ${plural(rent.length, 'bien', 'biens')} à louer à ${joinFr(teamCities)} et alentour, dans nos ${teams.length} agences.`;
const site = (Astro.site ?? Astro.url).origin;
const jsonLd = agencyJsonLd({ id: org.id, name: org.name, website: org.website, phone: primary?.phone, email: primary?.email, address: org.address }, site);
const ogPhoto = newest[0]?.photos[0];
---
<Site title={title} description={description} jsonLd={jsonLd} image={ogPhoto && img(ogPhoto.url, { w: 1200, h: 630 })}>
  <section class="hero">
    <div class="wrap hero__in">
      <h1 class="hero__title">Trouvez votre logement à {joinFr(teamCities)}</h1>
      <p class="hero__lede">{plural(live.length, 'bien', 'biens')} à vendre et à louer dans nos {teams.length} agences.</p>
      <SearchPill listings={all} />
      {ranked.length > 1 && (
        <p class="hero__quick">
          <span>Accès direct</span>
          {ranked.slice(0, 5).map(([c]) => <a href={searchUrl(offer, { city: c })}>{c}</a>)}
        </p>
      )}
    </div>
  </section>

  {newest.length > 0 && (
    <section class="wrap block" aria-labelledby="new-h">
      <div class="section-head">
        <h2 id="new-h" class="h3">{offer === 'buy' ? 'Dernières annonces à vendre' : 'Dernières annonces'}</h2>
        <a class="link" href={searchUrl(offer)}>Les {offer === 'buy' ? buy.length : live.length} annonces sur la carte</a>
      </div>
      <ul class="cards cards--4">
        {newest.map((l, i) => <li><ListingCard listing={l} priority={i === 0} sizes="(min-width: 1280px) 300px, (min-width: 640px) 50vw, 100vw" /></li>)}
      </ul>
    </section>
  )}

  {cities.length > 0 && (
    <section class="wrap block cities" aria-label="Nos villes">
      {cities.map((c) => (
        <a class="city" href={cityHref(c.city)}>
          <RaImage src={c.photo} alt={c.photo!.alt} width={1200} height={800} sizes="(min-width: 960px) 640px, 100vw" mobile={{ width: 800, height: 900 }} />
          <span class="city__text">
            <span class="city__name">{c.city}</span>
            <span class="city__n">{plural(c.n, 'annonce en cours', 'annonces en cours')}</span>
          </span>
        </a>
      ))}
    </section>
  )}

  {rent.length > 0 && (
    <section class="block" aria-labelledby="rent-h">
      <div class="wrap section-head">
        <h2 id="rent-h" class="h3">À louer en ce moment</h2>
        <a class="link" href={searchUrl('rent')}>Les {rent.length} locations</a>
      </div>
      <div class="wrap">
        <ul class="row" tabindex="0" aria-label="Locations (faire défiler)">
          {rent.slice(0, 10).map((l) => <li><ListingCard listing={l} sizes="300px" /></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="wrap block" aria-labelledby="ag-h">
    <h2 id="ag-h" class="h3">Nos {teams.length} agences</h2>
    <ul class="agl">
      {teams.map((t) => (
        <li class="agl__row">
          <a class="agl__name" href={teamHref(t)}>{teamShortName(t)}<span class="agl__city">{t.address.city}</span></a>
          <span class="agl__addr">{[t.address.street, [t.address.postcode, t.address.city].filter(Boolean).join(' ')].filter(Boolean).join(', ')}</span>
          {t.phone && <a class="agl__tel num" href={tel(t.phone)}><Icon name="phone" size={16} />{t.phone}</a>}
          <a class="agl__n" href={teamHref(t)}>{plural(countBy(t.id), 'annonce', 'annonces')}<Icon name="arrow" size={16} /></a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block" aria-labelledby="sell-h">
    <div class="sell">
      <h2 id="sell-h" class="h3">Vous vendez à {joinFr(teamCities, 'ou à')} ?</h2>
      <p>Un agent de l'agence la plus proche visite le bien, puis vous remet par écrit une estimation avec les ventes comparables du quartier. C'est gratuit et sans engagement.</p>
      <div class="sell__actions">
        <a class="vb" href={R.sell}>Demander une estimation</a>
        <a class="vb vb--ghost" href={R.sold}>Nos biens vendus</a>
      </div>
    </div>
  </section>
</Site>

<style>
  .hero { background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%); padding-block: clamp(40px, 7vw, 96px) clamp(24px, 3vw, 40px); }
  .hero__in { display: grid; justify-items: center; text-align: center; gap: 18px; }
  .hero__title { font-size: var(--step-4); max-width: 20ch; letter-spacing: -0.035em; }
  .hero__lede { color: var(--muted); font-size: var(--step-1); margin-bottom: 14px; }
  .hero__in :global(.sp) { text-align: left; }
  .hero__in :global(.sp__tabs) { justify-content: center; }
  .hero__quick { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 8px; align-items: center; color: var(--muted); font-size: 0.9375rem; margin-top: 6px; }
  .hero__quick span { margin-right: 4px; }
  .hero__quick a {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; border: 1px solid var(--line); border-radius: 999px;
    text-decoration: none; color: var(--text); background: var(--bg); font-weight: 550;
  }
  .hero__quick a:hover { border-color: var(--text); }

  .block { margin-top: var(--section); }
  .hero + .block { margin-top: clamp(32px, 4vw, 56px); }
  .cards--4 { grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  @media (min-width: 1200px) { .cards--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  /* Phones: four newest, the map link gives the rest. */
  @media (max-width: 639px) { .cards--4 > li:nth-child(n + 5) { display: none; } }

  .cities { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .city { position: relative; display: block; border-radius: var(--radius-card); overflow: hidden; color: #fff; text-decoration: none; aspect-ratio: 3 / 2; }
  .city :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .city:hover :global(img) { transform: scale(1.03); }
  .city::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / 0) 40%, rgb(0 0 0 / 0.66) 100%); }
  .city__text { position: absolute; left: 28px; right: 28px; bottom: 24px; z-index: 1; display: grid; gap: 2px; }
  .city__name { font-size: var(--step-3); font-weight: 650; letter-spacing: -0.03em; line-height: 1.05; }
  .city__n { font-size: 1rem; font-weight: 500; }
  @media (max-width: 759px) { .city { aspect-ratio: 8 / 9; } .city__text { left: 20px; bottom: 18px; } }

  .row {
    list-style: none; margin: 0; padding: 4px 0 16px; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(260px, 300px); gap: 20px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; overscroll-behavior-x: contain;
  }
  .row > li { scroll-snap-align: start; min-width: 0; }
  .row:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 8px; }

  .agl { list-style: none; margin: 20px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .agl__row {
    display: grid; grid-template-columns: minmax(180px, 1.2fr) minmax(0, 2fr) auto auto; align-items: center; gap: 8px 32px;
    padding: 18px 0; border-bottom: 1px solid var(--line);
  }
  .agl__name { font-size: 1.25rem; font-weight: 650; letter-spacing: -0.02em; text-decoration: none; display: grid; }
  .agl__name:hover { color: var(--accent-strong); }
  .agl__city { font-size: 0.875rem; font-weight: 500; color: var(--muted); letter-spacing: 0; }
  .agl__addr { color: var(--muted); }
  .agl__tel, .agl__n { display: inline-flex; gap: 8px; align-items: center; min-height: 44px; text-decoration: none; font-weight: 550; }
  .agl__n { color: var(--accent-strong); }
  .agl__tel:hover, .agl__n:hover { text-decoration: underline; }
  @media (max-width: 859px) {
    .agl__row { grid-template-columns: minmax(0, 1fr) auto; gap: 2px 16px; }
    .agl__addr { grid-column: 1 / -1; grid-row: 2; }
    .agl__tel { grid-row: 3; }
    .agl__n { grid-row: 3; justify-self: end; }
  }

  .sell { display: grid; gap: 16px; padding: clamp(28px, 5vw, 56px); border-radius: var(--radius-card); background: var(--accent); color: #fff; }
  .sell p { max-width: 62ch; font-size: var(--step-1); }
  .sell__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .sell .vb { background: #fff; color: var(--text); }
  .sell .vb:hover { background: var(--surface); }
  .sell .vb--ghost { background: transparent; color: #fff; border-color: rgb(255 255 255 / 0.7); }
  .sell .vb--ghost:hover { background: rgb(255 255 255 / 0.12); border-color: #fff; }
  .sell :focus-visible { outline-color: #fff; }
</style>
