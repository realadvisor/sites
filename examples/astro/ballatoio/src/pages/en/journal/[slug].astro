---
export const prerender = false;
import PostPage from '../../../views/PostPage.astro';
import { postsOf } from '../../../lib/journal';

const post = (await postsOf('en')).find((p) => p.data.path === Astro.params.slug);
if (!post) return Astro.rewrite('/404');
---
<PostPage lang="en" post={post} />
