---
/**
 * A listing told like a short story: the opening photo full bleed with a
 * title bar, then the description paragraph by paragraph with the photos
 * set between them, then the facts, the place, the agent and the form.
 */
import EnquiryForm from '@realadvisor/sites-kit/components/EnquiryForm.astro';
import RaImage from '@realadvisor/sites-kit/components/RaImage.astro';
import { sanitizeHtml } from '@realadvisor/sites-kit';
import { img } from '@realadvisor/sites-kit/image';
import { t } from '@realadvisor/sites-kit/i18n';
import { listingJsonLd, listingRef, listingTitle } from '@realadvisor/sites-kit/seo';
import Site from '../layouts/Site.astro';
import ListingCard from '../components/ListingCard.astro';
import AgentBlock from '../components/AgentBlock.astro';
import { agency, sites, type Listing } from '../lib/data';
import { districtOf, placeOf } from '../lib/districts';
import { CONTENT_LANG, LOCALE_OF, UI, alternates, fill, href, type Lang } from '../lib/i18n';
import { baths, blocks, factRows, price, rooms, surface, telHref } from '../lib/format';

interface Props { lang: Lang; listing: Listing }
const { lang, listing: l } = Astro.props;
const ui = UI[lang];
const textLang = lang === CONTENT_LANG ? undefined : CONTENT_LANG;
const city = l.address.city;
const [ag, sameCity, all] = await Promise.all([
  agency(),
  city ? sites.allListings({ city }) : Promise.resolve([] as Listing[]),
  sites.allListings({ status: 'available', offer_type: l.offer_type }),
]);
const sold = l.status === 'sold';
const agent = l.agent;
const ref = listingRef(l);
const district = districtOf(l);
const place = placeOf(l);
const back = sold ? 'sold' : l.offer_type === 'buy' ? 'buy' : 'rent';
const backLabel = ui.nav[back];
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const title = `${listingTitle(l, sameCity)} | ${price(l, lang)}`;
const facts = factRows(l, lang, place);
const keyFacts = [rooms(l.rooms, lang), baths(l.bathrooms, lang), surface(l.living_surface)].filter(Boolean);

// The story: text blocks with photo groups between them (one wide, a pair, one inset), the rest after.
const text = blocks(l.description);
const photos = l.photos.slice(1);
type Group = { kind: 'wide' | 'pair' | 'inset' | 'grid'; items: typeof photos };
const groups: Group[] = [];
let i = 0;
for (const kind of ['wide', 'pair', 'inset'] as const) {
  const n = kind === 'pair' ? 2 : 1;
  if (photos.length - i < n) break;
  groups.push({ kind, items: photos.slice(i, i + n) });
  i += n;
}
if (photos.length - i === 1) groups.push({ kind: 'wide', items: photos.slice(i) });
else if (i < photos.length) groups.push({ kind: 'grid', items: photos.slice(i) });
type Step = { text?: string; group?: Group };
const story: Step[] = [];
const steps = Math.max(text.length, groups.length);
for (let s = 0; s < steps; s++) {
  if (text[s]) story.push({ text: text[s] });
  if (groups[s]) story.push({ group: groups[s] });
}
const n = l.photos.length;
const photoNo = (p: (typeof photos)[number]) => l.photos.indexOf(p) + 1;

const similar = (district ? sameCity.filter((y) => districtOf(y)?.slug === district.slug) : sameCity)
  .filter((y) => y.id !== l.id && y.status === 'available');
const more = (similar.length ? similar : all.filter((y) => y.id !== l.id)).slice(0, 2);
const moreTitle = similar.length ? fill(ui.more, { place: district?.name ?? city ?? '' }) : ui.moreNear;
const osm = l.address.lat != null && l.address.lng != null
  ? `https://www.openstreetmap.org/?mlat=${l.address.lat}&mlon=${l.address.lng}#map=15/${l.address.lat}/${l.address.lng}`
  : undefined;
const team = ag.team;
const desc = (l.description_text ?? '').replace(/\s+/g, ' ').trim();
---
<Site lang={lang} current={back} title={title} description={(desc || l.title).slice(0, 158)} noindex={sold}
  image={l.photos[0] && img(l.photos[0].url, { w: 1200, h: 630 })}
  alternates={alternates('listing', l.slug)} jsonLd={listingJsonLd(l, pageUrl)}>
  <article class="lp">
    <div class="opening">
      <div class="frame opening-photo">
        {l.photos[0]
          ? <RaImage src={l.photos[0]} alt={l.photos[0].alt || l.title} width={1600} height={900} priority widths={[640, 960, 1280, 1600, 1920]} sizes="100vw" mobile={{ width: 800, height: 1000 }} />
          : <span class="no-photo">{place}</span>}
      </div>
      <div class="wrap bar">
        <div class="bar-title">
          <p class="bar-back small"><a href={href(back, lang)}><span aria-hidden="true">←</span> {fill(ui.backTo, { page: backLabel })}</a></p>
          <h1 class="d-l" lang={textLang}>{l.title}</h1>
          <p class="bar-place">{place}</p>
        </div>
        <ul class="bar-facts">
          {keyFacts.map((f) => <li class="num">{f}</li>)}
          <li class="num bar-price">{price(l, lang)}</li>
        </ul>
        {!sold && <a class="cta cta-solid bar-cta" href="#enquire">{ui.enquire}</a>}
      </div>
    </div>

    {sold && <p class="wrap sold-note">{ui.soldNote}</p>}

    <div class="story" lang={textLang}>
      {story.map((s, k) => s.text ? (
        <div class:list={['wrap', 'story-text', { 'is-first': k === 0 }]}>
          <div class="prose" set:html={sanitizeHtml(s.text)} />
        </div>
      ) : s.group && (
        <div class:list={['wrap', 'story-photos', `is-${s.group.kind}`]}>
          {s.group.items.map((p) => (
            <figure class="frame">
              <RaImage src={p} alt={p.alt || fill(ui.photoN, { i: photoNo(p), n })}
                width={s.group!.kind === 'pair' ? 800 : s.group!.kind === 'inset' ? 1100 : 1500}
                height={s.group!.kind === 'pair' ? 1000 : s.group!.kind === 'inset' ? 825 : 1000}
                sizes={s.group!.kind === 'wide' ? '(min-width: 1520px) 1424px, 100vw' : s.group!.kind === 'inset' ? '(min-width: 900px) 64vw, 100vw' : '(min-width: 760px) 48vw, 100vw'} />
            </figure>
          ))}
        </div>
      ))}
      {ui.descriptionLang && text.length > 0 && <p class="wrap small muted desc-lang" lang={lang}>{ui.descriptionLang}</p>}
    </div>

    <section class="wrap facts" aria-labelledby="facts-h">
      <h2 id="facts-h" class="d-l">{ui.theFacts}</h2>
      <div>
        <dl class="facts-list">
          {facts.map(([k, v]) => <div><dt>{k}</dt><dd class="num">{v}</dd></div>)}
        </dl>
        <p class="small muted facts-ref">{ui.ref} {ref}</p>
      </div>
    </section>

    {(osm || place) && (
      <section class="wrap where" aria-labelledby="where-h">
        <h2 id="where-h" class="d-l">{ui.location}</h2>
        <div class="where-text">
          <p class="lead">{[l.address.street, place].filter(Boolean).join(', ')}</p>
          {district && <p><a class="arrow-link" href={href('areas', lang, district.slug)}>{fill(ui.areaHomes, { name: district.name })} <span aria-hidden="true">→</span></a></p>}
          {osm && <p><a class="arrow-link" href={osm} rel="noopener">{ui.openMap} <span aria-hidden="true">↗</span></a></p>}
          {osm && <p class="small muted">{ui.approx}</p>}
        </div>
      </section>
    )}

    {!sold && (
      <section id="enquire" class="enquire" aria-labelledby="enquire-h">
        <div class="wrap enquire-in">
          <div class="enquire-agent">
            <h2 id="enquire-h" class="d-l">{ui.formTitle}</h2>
            <p class="lead">{ui.formLead}</p>
            {agent ? (
              <div class="enquire-who">
                <p class="label muted">{ui.agentTitle}</p>
                <AgentBlock agent={agent} lang={lang} heading="h3" />
              </div>
            ) : team?.phone && (
              <p><a class="arrow-link" href={telHref(team.phone)}>{ui.call} {team.phone}</a></p>
            )}
          </div>
          <div class="enquire-form">
            <EnquiryForm listingId={l.id} agentId={agent?.id} agentName={agent?.first_name} locale={LOCALE_OF[lang]}
              message={t('interested', { title: l.title, ref }, lang)} />
          </div>
        </div>
      </section>
    )}

    {!sold && (
      <div class="sticky-cta">
        <span class="num">{price(l, lang)}</span>
        <a class="cta cta-solid" href="#enquire">{ui.enquire}</a>
      </div>
    )}
  </article>

  {more.length > 0 && (
    <section class="wrap more" aria-labelledby="more-h">
      <h2 id="more-h" class="d-l">{moreTitle}</h2>
      <div class="more-grid">
        {more.map((y) => <ListingCard listing={y} lang={lang} />)}
      </div>
    </section>
  )}
</Site>

<style>
  .opening-photo { height: calc(100svh - var(--header-h) - 150px); min-height: 420px; max-height: 860px; }
  .bar {
    display: grid; grid-template-columns: 1fr auto auto; gap: 16px clamp(24px, 4vw, 64px); align-items: end;
    padding-top: 22px; padding-bottom: 22px; border-bottom: 1px solid var(--line);
  }
  .bar-title { display: grid; gap: 8px; }
  .bar-back a { color: var(--muted); text-decoration: none; display: inline-flex; min-height: 32px; align-items: center; }
  .bar-back a:hover { color: var(--text); text-decoration: underline; }
  .bar h1 { max-width: 20ch; }
  .bar-place { font-size: 1.0625rem; color: var(--muted); }
  .bar-facts { display: grid; gap: 2px; font-size: 0.9375rem; }
  .bar-price { font-weight: 700; font-size: 1.125rem; margin-top: 4px; }
  @media (max-width: 900px) {
    .opening-photo { height: auto; aspect-ratio: 4 / 5; max-height: 72svh; min-height: 0; }
    .bar { grid-template-columns: 1fr; align-items: start; }
    .bar-facts { display: flex; flex-wrap: wrap; gap: 4px 18px; }
    .bar-price { margin-top: 0; }
    .bar-cta { display: none; }
  }

  .sold-note { padding-top: 28px; max-width: 48rem; margin-inline: 0; font-weight: 500; }

  .story { display: grid; gap: clamp(48px, 7vw, 120px); padding-top: clamp(56px, 8vw, 128px); }
  .story-text { display: grid; grid-template-columns: 1fr minmax(0, var(--text-w)) 1.4fr; }
  .story-text .prose { grid-column: 2; }
  .story-text.is-first .prose { font-size: var(--fs-lead); line-height: 1.5; }
  .story-text.is-first { grid-template-columns: 1fr minmax(0, 46rem) 1fr; }
  .story-photos { display: grid; gap: clamp(16px, 2vw, 32px); }
  .story-photos.is-wide .frame { aspect-ratio: 3 / 2; }
  .story-photos.is-pair { grid-template-columns: 1fr 1fr; }
  .story-photos.is-pair .frame { aspect-ratio: 4 / 5; }
  .story-photos.is-pair .frame:last-child { margin-top: clamp(0px, 10vw, 160px); }
  .story-photos.is-inset { grid-template-columns: 1fr 2fr; }
  .story-photos.is-inset .frame { grid-column: 2; aspect-ratio: 4 / 3; }
  .story-photos.is-grid { grid-template-columns: 1fr 1fr; }
  .story-photos.is-grid .frame { aspect-ratio: 4 / 3; }
  .desc-lang { margin-top: -40px; }
  @media (max-width: 900px) {
    .story-text, .story-text.is-first { grid-template-columns: 1fr; }
    .story-text .prose { grid-column: 1; }
    .story-photos.is-inset { grid-template-columns: 1fr; }
    .story-photos.is-inset .frame { grid-column: 1; }
  }
  @media (max-width: 600px) {
    .story-photos.is-pair, .story-photos.is-grid { grid-template-columns: 1fr; }
    .story-photos.is-pair .frame:last-child { margin-top: 0; }
  }

  .facts, .where { display: grid; grid-template-columns: 1fr 2fr; gap: 24px clamp(32px, 6vw, 120px); padding-top: var(--section); }
  .facts-list { display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(24px, 4vw, 64px); border-top: 1px solid var(--text); }
  .facts-list div { display: grid; grid-template-columns: 1fr auto; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .facts-list dt { color: var(--muted); }
  .facts-list dd { font-weight: 600; text-align: right; white-space: normal; }
  .facts-ref { margin-top: 14px; }
  .where-text { display: grid; gap: 14px; align-content: start; border-top: 1px solid var(--text); padding-top: 18px; }
  @media (max-width: 900px) {
    .facts, .where { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) { .facts-list { grid-template-columns: 1fr; } }

  .enquire { margin-top: var(--section); background: var(--paper); padding-block: clamp(56px, 7vw, 112px); }
  .enquire-in { display: grid; grid-template-columns: 1fr 1fr; gap: 48px clamp(40px, 6vw, 120px); }
  .enquire-agent { display: grid; gap: 24px; align-content: start; }
  .enquire-who { display: grid; gap: 14px; border-top: 1px solid var(--text); padding-top: 18px; margin-top: 12px; }
  .enquire-form { --surface: #fff; }
  @media (max-width: 900px) { .enquire-in { grid-template-columns: 1fr; } }

  .sticky-cta { display: none; }
  @media (max-width: 900px) {
    .sticky-cta {
      position: sticky; bottom: 0; z-index: 20; display: flex; justify-content: space-between; align-items: center; gap: 12px;
      padding: 10px var(--gutter); background: var(--bg); border-top: 1px solid var(--line); font-weight: 700;
    }
  }

  .more { padding-top: var(--section); display: grid; gap: clamp(28px, 4vw, 48px); }
  .more-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 4vw, 72px); }
  @media (max-width: 760px) { .more-grid { grid-template-columns: 1fr; } }
</style>
