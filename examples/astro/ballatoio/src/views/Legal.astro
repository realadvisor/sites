---
// Legal notice and privacy policy: text only from the kit (built from the
// agency data), in the site's layout. Never edit the words.
import LegalContent from '@realadvisor/sites-kit/components/LegalContent.astro';
import { agencyOf } from '@realadvisor/sites-kit/agency';
import { legalNotice, privacyPolicy } from '@realadvisor/sites-kit/legal';
import { analyticsId } from '@realadvisor/sites-kit/env';
import { t } from '@realadvisor/sites-kit/i18n';
import Site from '../layouts/Site.astro';
import { agency, brandName } from '../lib/data';
import { alternates, type Lang } from '../lib/i18n';

interface Props { lang: Lang; page: 'legal' | 'privacy' }
const { lang, page } = Astro.props;
const data = await agency();
const ag = agencyOf(data.org, data.team);
const title = t(page === 'legal' ? 'legalNotice' : 'privacyPolicy', {}, lang);
const sections = page === 'legal' ? legalNotice(ag, lang) : privacyPolicy(ag, { analytics: !!analyticsId() }, lang);
---
<Site lang={lang} title={`${title} | ${brandName(data)}`} description={`${title} ${ag.name}`} alternates={alternates(page)} switchToHome>
  <header class="wrap phead"><h1 class="d-xl">{title}</h1></header>
  <div class="wrap doc"><LegalContent sections={sections} class="doc-body" /></div>
</Site>
<style>
  .doc :global(.doc-body) { max-width: 820px; display: grid; gap: 48px; border-top: 1px solid var(--text); padding-top: 32px; }
  .doc :global(.doc-body h2) { font-stretch: 62%; font-weight: 800; text-transform: uppercase; font-size: var(--fs-m); line-height: 1; margin-bottom: 16px; }
  .doc :global(.doc-body dl) { margin: 0; }
  .doc :global(.doc-body dl div) { display: grid; grid-template-columns: 220px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .doc :global(.doc-body dt) { color: var(--muted); }
  .doc :global(.doc-body dd) { margin: 0; overflow-wrap: anywhere; }
  .doc :global(.doc-body a) { color: var(--accent); }
  .doc :global(.doc-body p + p) { margin-top: 14px; }
  @media (max-width: 640px) { .doc :global(.doc-body dl div) { grid-template-columns: 1fr; gap: 2px; } }
</style>
