{
  "name": "realadvisor-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "sites-kit fixture --if-empty && astro dev --port ${PORT:-4321}",
    "build": "sites-kit fixture --if-empty && astro build",
    "preview": "wrangler dev --port 4321",
    "check": "sites-kit fixture --if-empty && astro check && astro build",
    "fixture": "sites-kit fixture",
    "screenshot": "sites-kit screenshot",
    "check:deploy": "sites-kit check deploy",
    "kit": "sites-kit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "@realadvisor/sites-kit-astro": "file:../kit-astro",
    "@realadvisor/sites-kit-core": "file:../kit-core",
    "@realadvisor/sites-sdk": "file:../sdk",
    "astro": "5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  },
  "packageManager": "pnpm@10.11.1"
}
