{
  "name": "@realadvisor-sites/kit-react",
  "version": "0.4.0",
  "description": "The React Router (framework mode, SSR on Cloudflare Workers) version of the RealAdvisor sites kit: Worker with a per-request CSP nonce, data through the SDK interface, images, legal, consent, enquiry, SEO, listings search and map, and the deploy check. Reuses @realadvisor/sites-kit-core for every rule, string and browser script it can.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realadvisor/sites.git",
    "directory": "kit-react"
  },
  "homepage": "https://github.com/realadvisor/sites/tree/main/kit-react#readme",
  "files": [
    "*.mjs",
    "*.mts",
    "env.d.ts",
    "README.md",
    "bin",
    "client",
    "components",
    "lib",
    "server",
    "styles",
    "tools",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    },
    "./worker": "./server/worker.ts",
    "./entry.server": "./server/entry.server.tsx",
    "./server/*": "./server/*.ts",
    "./components": "./components/index.ts",
    "./components/*": "./components/*.tsx",
    "./client": "./client/index.ts",
    "./client/*": "./client/*.ts",
    "./styles/*": "./styles/*",
    "./tools/*": "./tools/*",
    "./package.json": "./package.json",
    "./lib/*": "./lib/*.ts",
    "./env.d.ts": "./env.d.ts"
  },
  "bin": {
    "sites-kit-react": "./bin/sites-kit-react.mjs"
  },
  "peerDependencies": {
    "@realadvisor/sites-kit-core": "^0.4.0",
    "@realadvisor/sites-sdk": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.0",
    "playwright": "^1.64.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
