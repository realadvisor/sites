---
/**
 * Minimal analytics consent banner. Base.astro renders it only when
 * ANALYTICS_ID (GA4 measurement id) is set; without it the site sets no
 * analytics cookie and shows no banner. Analytics loads only after "Accept".
 * Restyle with tokens; keep both buttons equal in weight.
 */
import { t, lang, privacyPath } from '@realadvisor/sites-kit-core/i18n';
import '@realadvisor/sites-kit-core/styles/form.css';

interface Props {
  analyticsId: string;
  /** Page locale (Base passes its own). */
  locale?: string;
}
const { analyticsId, locale } = Astro.props;
const l = locale ? lang(locale) : lang();
---
<div class="consent" role="region" aria-label="Cookies" hidden data-consent={analyticsId}>
  <p>{t('consentText', {}, l)} <a href={privacyPath(locale)}>{t('privacyLink', {}, l)}</a></p>
  <div class="consent-actions">
    <button type="button" class="btn btn--secondary" data-choice="denied">{t('decline', {}, l)}</button>
    <button type="button" class="btn btn--secondary" data-choice="granted">{t('accept', {}, l)}</button>
  </div>
</div>
<style is:global>
  .consent { position: fixed; z-index: 50; inset: auto 16px 16px 16px; max-width: 560px; display: grid; gap: 12px; padding: 16px; background: var(--bg, #fff); color: var(--text, #111); border: 1px solid var(--line, #ddd); border-radius: var(--radius-card, 8px); box-shadow: 0 8px 24px rgb(0 0 0 / .12); font-size: 0.9375rem; }
  .consent p { margin: 0; }
  .consent a { color: inherit; }
  .consent-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .consent-actions .btn { flex: 1; }
</style>
<script>
  import '@realadvisor/sites-kit-core/client/consent';
</script>
