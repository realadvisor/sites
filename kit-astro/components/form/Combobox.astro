---
/**
 * Searchable select for long lists (cities/Ort, property types with many values).
 * Renders a styled native <select> (works without JS, submits with the form), then a
 * ~2 KB script upgrades it to an ARIA 1.2 combobox: type to filter (accent- and
 * case-insensitive), Up/Down, Enter, Escape, click. No dependency.
 *   <Combobox label="Ort" name="city" value={city} placeholder="Alle Orte"
 *             options={cities.map((c) => ({ value: c, label: c }))} />
 */
import '@realadvisor/sites-kit-core/styles/form.css';
import type { Option } from './Select.astro';

interface Props {
  label: string;
  name: string;
  options: Option[];
  value?: string | null;
  placeholder?: string;
  hideLabel?: boolean;
  noResults?: string;
  id?: string;
  class?: string;
}
const { label, name, options, value, placeholder = '', hideLabel, noResults = '–', id, class: cls } = Astro.props;
const fieldId = id ?? `f-${name}`;
---
<div class:list={['field', cls]}>
  <label for={fieldId} class:list={['field-label', { 'sr-only': hideLabel }]}>{label}</label>
  <div class="combobox" data-combobox data-no-results={noResults}>
    <span class="select">
      <select id={fieldId} name={name} class="control">
        <option value="" selected={!value}>{placeholder}</option>
        {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
      </select>
    </span>
  </div>
</div>

<script>
  import '@realadvisor/sites-kit-core/client/combobox';
</script>
