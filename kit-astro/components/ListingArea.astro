---
/**
 * A listing's approximate area on the kit's map: a soft circle about 1.5 km
 * across at town zoom, never a pin (the data's coordinates are rounded).
 * Two layers:
 * - always: a static map of the same OSM tiles with the circle (no
 *   JavaScript, lazy images, the one map host the CSP allows);
 * - near the screen, with JavaScript: the kit's ListingsMap (no listings,
 *   its first view on the place; the same tiles and script) mounted from a
 *   <template> with the circle over it, locked (page scroll and swipes pass
 *   through) until the visitor taps «Activer la carte».
 *   Browser side: ../client/listing-area.ts (bundled, no inline script).
 * The © OpenStreetMap credit and an "Open in OpenStreetMap" link stay.
 *
 *   {listing.address.lat != null && listing.address.lng != null && (
 *     <ListingArea lat={listing.address.lat} lng={listing.address.lng} />
 *   )}
 *
 * Height: --la-h (default clamp(260px, 32vw, 380px)); circle: --la-fill,
 * --la-line. Same markup and classes as the React kit's.
 */
import ListingsMap from './ListingsMap.astro';
import { areaTiles, listingAreaLabels, osmUrl, type ListingAreaLabels } from '../lib/listing-labels';

interface Props {
  lat: number;
  lng: number;
  /** Map zoom (default 13: a town, not a street). */
  zoom?: number;
  /** Radius of the area in metres (default 750: about 1.5 km across). */
  radius?: number;
  /** Page locale on a multi-language site (e.g. 'de-CH'). */
  locale?: string;
  labels?: Partial<ListingAreaLabels>;
  /** Hide the "Approximate location · Open in OpenStreetMap" line (the page writes its own). */
  note?: boolean;
  class?: string;
}
const { lat, lng, zoom = 13, radius = 750, locale, labels, note = true, class: cls } = Astro.props;
const L = listingAreaLabels(locale, labels);
const z = Math.round(Math.max(3, Math.min(17, zoom)));
const { tiles, width, height, px, py, r } = areaTiles(lat, lng, z, radius);
---
<div class:list={['ra-la', cls]} data-listing-area data-radius={radius} data-lat={lat} data-lng={lng} data-label={L.map} style={`--la-r: ${r}px`}>
  <div class="ra-la-frame">
    <div class="ra-la-static" role="img" aria-label={L.approx}>
      <div class="ra-la-tiles" style={`width: ${width}px; height: ${height}px; transform: translate(${-Math.round(px)}px, ${-Math.round(py)}px)`}>
        {tiles.map((tile) => (
          <img src={tile.src} alt="" width="256" height="256" loading="lazy" decoding="async" style={`left: ${tile.left}px; top: ${tile.top}px`} />
        ))}
      </div>
      <span class="ra-la-area" aria-hidden="true"></span>
    </div>
    <div class="ra-la-live" data-la-live></div>
    <template data-la-tpl>
      <ListingsMap listings={[]} view={{ z, lat, lng }} locale={locale} class="ra-la-map" />
      <span class="ra-la-ring" aria-hidden="true"></span>
    </template>
    <button type="button" class="ra-la-unlock" data-la-unlock hidden>{L.activate}</button>
    <p class="ra-la-credit">© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">{L.credit}</a></p>
  </div>
  {note && (
    <p class="ra-la-note">
      <span>{L.approx}</span> · <a href={osmUrl(lat, lng, z)} target="_blank" rel="noopener">{L.openOsm}</a>
    </p>
  )}
</div>

<script>
  import '../client/listing-area';
</script>

<style is:global>
  /* The React kit's styles/listing-area.css, the same rules. */
  .ra-la { display: grid; gap: 10px; }
  .ra-la-frame { position: relative; height: var(--la-h, clamp(260px, 32vw, 380px)); overflow: hidden; background: #f2f0ec; border: 1px solid var(--line, #d6d3cf); }
  .ra-la-static { position: absolute; inset: 0; overflow: hidden; }
  .ra-la-tiles { position: absolute; left: 50%; top: 50%; }
  /* The same look as the kit's map tiles. */
  .ra-la-tiles img { position: absolute; width: 256px; height: 256px; max-width: none; filter: grayscale(1) sepia(.18) contrast(.92) brightness(1.06); }
  /* The area, not a point: a soft circle (--la-r: the radius in px at the zoom shown). */
  .ra-la-area, .ra-la-ring {
    position: absolute; width: calc(2 * var(--la-r, 56px)); height: calc(2 * var(--la-r, 56px)); translate: -50% -50%; border-radius: 50%; pointer-events: none;
    background: var(--la-fill, color-mix(in srgb, var(--accent, #134266) 18%, transparent));
    border: 2px solid var(--la-line, color-mix(in srgb, var(--accent, #134266) 60%, transparent));
  }
  .ra-la-area { left: 50%; top: 50%; }
  /* Over the live map, placed by the script from the map's tiles. */
  .ra-la-ring { z-index: 2; left: var(--la-x, 50%); top: var(--la-y, 50%); visibility: hidden; }
  .ra-la.is-live .ra-la-ring { visibility: visible; }
  .ra-la-live { position: absolute; inset: 0; overflow: hidden; }
  .ra-la-live:empty { display: none; }
  .ra-la .ra-la-live .ra-map { --map-h: 100%; height: 100%; min-height: 0; }
  /* No listings on this map: no count, no "show all"; one credit (ours, below). */
  .ra-la-live .ra-map-status, .ra-la-live .ra-map-attr { display: none; }
  /* Once the kit's map is drawn, the static tiles under it go. */
  .ra-la:has(.ra-la-live .ra-map.is-ready) .ra-la-static { display: none; }
  /* Locked: page scroll and swipes pass through until the visitor activates the map. */
  .ra-la.is-locked .ra-la-live { pointer-events: none; }
  .ra-la.is-locked .ra-map-zoom { display: none; }
  .ra-la-unlock {
    position: absolute; left: 50%; bottom: 16px; translate: -50% 0; z-index: 5; min-height: 44px; padding: 0 18px;
    border: 0; border-radius: var(--radius-btn, 0); background: var(--accent, #134266); color: #fff;
    font: 600 .8125rem/1 var(--font-sans, system-ui, sans-serif); letter-spacing: .06em; box-shadow: 0 2px 8px rgb(0 0 0 / .25); cursor: pointer;
  }
  .ra-la-unlock[hidden] { display: none; }
  .ra-la-unlock:focus-visible { outline: 2px solid var(--text, #1c1b19); outline-offset: 2px; }
  /* One credit, always clickable (the kit map's own would sit under the lock). */
  .ra-la-credit { position: absolute; right: 0; bottom: 0; z-index: 5; margin: 0; padding: 2px 6px; font-size: 11px; color: #444; background: rgb(255 255 255 / .8); }
  .ra-la-credit a { color: inherit; }
  .ra-la-note { margin: 0; font-size: .875rem; color: var(--muted, #5c5a56); }
  .ra-la-note a { color: var(--accent, #134266); display: inline-flex; min-height: 24px; align-items: center; }
</style>
