{
  "name": "@realadvisor-sites/kit-astro",
  "version": "0.4.0",
  "description": "The Astro 5 kit for RealAdvisor sites on Cloudflare Workers: the integration (middleware, security headers, data env, site.json), the ra data client, and the components (images, listings search and map, enquiry form, legal, consent). Built on @realadvisor/sites-kit-core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realadvisor/sites.git",
    "directory": "kit-astro"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "homepage": "https://github.com/realadvisor/sites/tree/main/kit-astro#readme",
  "files": [
    "*.mjs",
    "*.mts",
    "*.ts",
    "README.md",
    "LICENSE",
    "components",
    "lib",
    "tools"
  ],
  "keywords": [
    "astro-component"
  ],
  "exports": {
    ".": {
      "types": "./astro.d.mts",
      "default": "./astro.mjs"
    },
    "./middleware": "./middleware.ts",
    "./ra": "./lib/ra.ts",
    "./components/*": "./components/*",
    "./tools/*": "./tools/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@realadvisor/sites-kit-core": "^0.4.0",
    "@realadvisor/sites-sdk": "^0.4.0",
    "astro": "^5.18.2"
  }
}
